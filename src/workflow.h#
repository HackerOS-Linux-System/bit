fn project_lock_path(p: project::Project) -> string is
    return project::root_of(p) + "/Bit.lock"
end

fn link_into_cache(p: project::Project, dep_name: string, target: string) is
    util::mkdir_p(project::cache_libs(p))
    util::run("ln -sfn " + util::sq(target) + " " + util::sq(project::cache_libs(p) + "/" + dep_name))
end

fn resolve_path(p: project::Project, rel: string) -> string is
    if string_starts_with(rel, "/") is return rel end
    return project::root_of(p) + "/" + rel
end

;; What to install for one dependency.
pub struct Pick is
    pub pk_rev:   string    ;; tag / branch / commit handed to install_lib ("" = the index default)
    pub pk_range: string    ;; the range it came from ("" = none)
    pub pk_err:   string    ;; non-empty: this dependency cannot be resolved
end

fn locked_only() -> bool is return env_get("BIT_LOCKED") == "1" end

fn spec_of(d: project::Dep) -> string is
    return if project::dep_kind(d) == "git" then project::dep_arg(d) else project::dep_name(d)
end

;; Decides the revision of a dependency:
;;   range  -> the Bit.lock entry when it was resolved from the same range (reproducible,
;;             works offline), otherwise the newest git tag that satisfies it
;;   rev    -> exactly that
;;   none   -> the Bit.lock commit, else the index default
;; With --locked (BIT_LOCKED=1) nothing is resolved: a dependency missing from
;; Bit.lock is an error, so CI builds exactly what was committed.
fn pick_rev(d: project::Dep, pl: lock::Lock, use_lock: bool) -> Pick is
    let dname: string = project::dep_name(d)
    let range: string = project::dep_range(d)
    let locked: lock::Locked = lock::lock_get(pl, dname)
    let have_lock: bool = lock::locked_commit(locked) != ""

    if range != "" is
        if use_lock && have_lock && lock::locked_range(locked) == range is
            return Pick { pk_rev: lock::locked_commit(locked), pk_range: range, pk_err: "" }
        end
        if locked_only() is
            return Pick { pk_rev: "", pk_range: range,
                          pk_err: "Bit.lock has no entry for " + dname + " matching " + range + " (run `bit upgrade " + dname + "`, commit Bit.lock)" }
        end
        let tag: string = installer::resolve_range(spec_of(d), range)
        if tag != "" is
            return Pick { pk_rev: tag, pk_range: range, pk_err: "" }
        end
        ;; offline / unreachable: a version that is already installed may still fit
        let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
        let inst: lock::Locked = lock::lock_get(gl, dname)
        let iv: int = semver::parse(lock::locked_tag(inst))
        if iv >= 0 && semver::satisfies(iv, semver::parse_range(range)) is
            return Pick { pk_rev: lock::locked_tag(inst), pk_range: range, pk_err: "" }
        end
        ;; `1.2` without an operator used to mean "the tag/branch named 1.2"
        if !string_contains("^~<>=", string_slice(range, 0, 1)) && !net::offline() is
            return Pick { pk_rev: range, pk_range: "", pk_err: "" }
        end
        return Pick { pk_rev: "", pk_range: range,
                      pk_err: "no version of " + dname + " satisfies " + range + (if net::offline() then " (offline)" else "") }
    end

    let mut rev: string = project::dep_rev(d)
    if rev == "" && use_lock && have_lock is rev = lock::locked_commit(locked) end
    if rev == "" && locked_only() && !have_lock is
        return Pick { pk_rev: "", pk_range: "", pk_err: "Bit.lock has no entry for " + dname + " (run `bit install`, commit Bit.lock)" }
    end
    return Pick { pk_rev: rev, pk_range: "", pk_err: "" }
end


;; What ensure_one did for one dependency.
pub struct Outcome is
    pub oc_ok:    bool             ;; false: the dependency could not be satisfied
    pub oc_lock:  bool             ;; true: `oc_entry` goes into Bit.lock
    pub oc_entry: lock::Locked
end

fn no_entry() -> lock::Locked is
    return lock::empty_entry()
end

fn failed() -> Outcome is
    return Outcome { oc_ok: false, oc_lock: false, oc_entry: no_entry() }
end

fn fine_no_lock() -> Outcome is
    return Outcome { oc_ok: true, oc_lock: false, oc_entry: no_entry() }
end

;; The project lock pins a checksum — an installed tree that differs from it is refused.
fn integrity_ok(dname: string, locked: lock::Locked, actual_tagged: string, use_lock: bool) -> bool is
    if !use_lock || lock::locked_checksum(locked) == "" || actual_tagged == "" is return true end
    if lock::locked_checksum(locked) == actual_tagged is return true end
    ui::bad(dname + "  " + ui::red("does not match Bit.lock") + " " + ui::dim("(pinned " +
            util::short_hash(checksum::untag(lock::locked_checksum(locked))) + ", installed " +
            util::short_hash(checksum::untag(actual_tagged)) + ")"))
    ui::note("investigate, or re-resolve with:  bit upgrade " + dname)
    return false
end

fn ensure_registry(p: project::Project, d: project::Dep, pl: lock::Lock, use_lock: bool, force: bool, verbose: bool) -> Outcome is
    let dname: string = project::dep_name(d)
    let kind: string = project::dep_kind(d)
    let locked: lock::Locked = lock::lock_get(pl, dname)
    let version: string = installer::install_registry(project::cache_libs(p), d, lock::locked_version(locked), use_lock, force, verbose)
    if version == "" is return failed() end
    let dest: string = installer::registry_dir(project::cache_libs(p), d)
    let sum: string = checksum::tag(checksum::dir_checksum(dest))
    if !integrity_ok(dname, locked, sum, use_lock && lock::locked_version(locked) == version) is return failed() end
    ui::ok(dname + "  " + ui::dim(kind + " " + version + (if project::dep_package(d) != dname then "  (" + project::dep_package(d) + ")" else "")))
    return Outcome { oc_ok: true, oc_lock: true, oc_entry: lock::Locked {
        lk_name: dname, lk_version: version, lk_commit: "", lk_url: registry::registry_url(kind),
        lk_checksum: sum, lk_lang: "", lk_output: "source", lk_at: util::now_iso(),
        lk_range: project::dep_range(d), lk_tag: "", lk_source: kind, lk_dir: ""
    } }
end

;; Installs/links one dependency.
fn ensure_one(p: project::Project, d: project::Dep, pk: Pick, pl: lock::Lock, use_lock: bool, force: bool,
              verbose: bool, release: bool) -> Outcome is
    let dname: string = project::dep_name(d)
    let kind: string = project::dep_kind(d)

    if kind == "invalid" is
        ui::bad(dname + "  " + ui::red("`" + project::dep_arg(d) + "` is not a dependency source") + " — name a version or a source (git, path, pypi, …); system libraries go in [system-dependencies]")
        return failed()
    end

    if kind == "path" is
        let dir: string = resolve_path(p, project::dep_arg(d))
        if !dir_exists(dir) is
            ui::bad(dname + "  " + ui::red("path not found: ") + dir)
            return failed()
        end
        link_into_cache(p, dname, dir)
        ui::ok(dname + "  " + ui::dim("path " + dir))
        return fine_no_lock()      ;; path deps are not part of the global install/lock
    end

    if project::is_registry_kind(kind) || project::is_builtin_kind(kind) is
        if project::is_builtin_kind(kind) is
            ui::ok(dname + "  " + ui::dim(kind + "  (part of the language's standard library)"))
            return fine_no_lock()
        end
        return ensure_registry(p, d, pl, use_lock, force, verbose)
    end

    if pk.pk_err != "" is
        ui::bad(dname + "  " + ui::red(pk.pk_err))
        return failed()
    end

    let locked: lock::Locked = lock::lock_get(pl, dname)
    let spec: string = spec_of(d)
    let base: installer::InstallOpts = installer::iopts(force, true, project::dep_output(d), project::dep_lang(d), "", release, verbose)
    let opts: installer::InstallOpts = installer::with_origin(base, if kind == "git" then dname else "", project::dep_dir(d), kind)
    if installer::install_lib(spec, pk.pk_rev, opts) != 0 is return failed() end

    let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
    let now: lock::Locked = lock::lock_get(gl, dname)
    if lock::locked_name(now) == "" is
        ui::bad(dname + "  " + ui::red("was installed under a different name") + " " + ui::dim("(the index calls it something else — use its exact name)"))
        return failed()
    end
    if !integrity_ok(dname, locked, lock::locked_checksum(now), use_lock) is return failed() end

    link_into_cache(p, dname, installer::current_dir(dname))
    let tag: string = if semver::parse(pk.pk_rev) >= 0 then pk.pk_rev else lock::locked_tag(now)
    return Outcome { oc_ok: true, oc_lock: true, oc_entry: lock::Locked {
        lk_name: dname, lk_version: lock::locked_version(now), lk_commit: lock::locked_commit(now), lk_url: lock::locked_url(now),
        lk_checksum: lock::locked_checksum(now), lk_lang: lock::locked_lang(now), lk_output: lock::locked_output(now),
        lk_at: lock::locked_at(now), lk_range: pk.pk_range, lk_tag: tag,
        lk_source: kind, lk_dir: project::dep_dir(d)
    } }
end

;; Installs a list of dependencies (the project's [dependencies], or its [dev-dependencies]).
;; Returns the number that could not be satisfied.
fn ensure_list(p: project::Project, deps: [project::Dep], label: string, verbose: bool, release: bool,
               use_lock: bool, force: bool) -> int is
    if array_len(deps) == 0 is return 0 end

    project::cache_ensure(p)
    ui::line(ui::bold(label) + " " + ui::dim("(" + to_string(array_len(deps)) + ")") +
             (if net::offline() then "  " + ui::yellow("offline") else "") +
             (if locked_only() then "  " + ui::dim("--locked") else ""))
    let mut pl: lock::Lock = lock::lock_read(project_lock_path(p))

    ;; 1. decide the revision of every git dependency (ranges → tags)
    let mut picks: [Pick] = []
    let mut i: int = 0
    while i < array_len(deps) is
        if project::is_git_kind(project::dep_kind(deps[i])) is
            picks = array_push(picks, pick_rev(deps[i], pl, use_lock))
        else is
            picks = array_push(picks, Pick { pk_rev: "", pk_range: "", pk_err: "" })
        end
        i += 1
    end

    ;; 2. clone everything that is missing, several at a time
    let mut items: [string] = []
    i = 0
    while i < array_len(deps) is
        let d: project::Dep = deps[i]
        if project::is_git_kind(project::dep_kind(d)) && picks[i].pk_err == "" && (force || !installer::is_installed(project::dep_name(d))) is
            let url: string = installer::spec_url(spec_of(d))
            if url != "" is items = array_push(items, url + "\t" + picks[i].pk_rev) end
        end
        i += 1
    end
    net::prefetch(items, verbose)

    ;; 3. install / link, one by one
    let mut bad: int = 0
    i = 0
    while i < array_len(deps) is
        let out: Outcome = ensure_one(p, deps[i], picks[i], pl, use_lock, force, verbose, release)
        if !out.oc_ok is
            bad += 1
        else if out.oc_lock is
            pl = lock::lock_set(pl, out.oc_entry)
        end
        i += 1
    end
    if bad == 0 && !locked_only() is lock::lock_write(project_lock_path(p), pl) end
    ui::blank()
    return bad
end

;; Returns the number of [dependencies] that could not be satisfied.
pub fn ensure_deps(p: project::Project, verbose: bool, release: bool, use_lock: bool, force: bool) -> int is
    return ensure_list(p, project::deps(p), "dependencies", verbose, release, use_lock, force)
end

;; [dev-dependencies] — only `bit test` needs them.
pub fn ensure_dev_deps(p: project::Project, verbose: bool, release: bool, use_lock: bool, force: bool) -> int is
    return ensure_list(p, project::dev_deps(p), "dev-dependencies", verbose, release, use_lock, force)
end

;; `bit outdated`: what `bit upgrade` would change. Returns the number of outdated dependencies.
pub fn outdated(p: project::Project) -> int is
    let deps: [project::Dep] = project::deps(p)
    let pl: lock::Lock = lock::lock_read(project_lock_path(p))
    if net::offline() is
        ui::fail("bit outdated needs the network (offline mode is on)")
        return -1
    end
    ui::line(ui::bold("dependency") + "  " + ui::dim("locked → newest in range → newest overall"))
    let mut count: int = 0
    let mut i: int = 0
    while i < array_len(deps) is
        let d: project::Dep = deps[i]
        let k: string = project::dep_kind(d)
        if project::is_git_kind(k) is
            let tags: [string] = net::remote_tags(installer::spec_url(spec_of(d)))
            let locked: lock::Locked = lock::lock_get(pl, project::dep_name(d))
            let cur: string = util::or_default(lock::locked_tag(locked), util::short_hash(lock::locked_commit(locked)))
            let range: string = project::dep_range(d)
            let in_range: string = if range != "" then semver::best_tag(tags, range) else semver::newest_tag(tags)
            let newest: string = semver::newest_tag(tags)
            let is_old: bool = in_range != "" && lock::locked_tag(locked) != "" && semver::parse(in_range) > semver::parse(lock::locked_tag(locked))
            let beyond: bool = newest != "" && in_range != "" && semver::parse(newest) > semver::parse(in_range)
            let mark: string = if is_old then ui::yellow("↑") else if beyond then ui::cyan("»") else ui::green("✓")
            ui::line(mark + " " + project::dep_name(d) + "  " + ui::dim(util::or_default(cur, "not installed") + " → " +
                     util::or_default(in_range, "-") + " → " + util::or_default(newest, "-")) +
                     (if range != "" then "  " + ui::dim("(" + range + ")") else ""))
            if is_old is count += 1 end
        else if project::is_registry_kind(k) && k != "vira" is
            let locked: lock::Locked = lock::lock_get(pl, project::dep_name(d))
            let range: string = project::dep_range(d)
            let cur: string = lock::locked_version(locked)
            let in_range: string = registry::resolve(k, project::dep_package(d), range)
            let newest: string = registry::newest(k, project::dep_package(d))
            let is_old: bool = in_range != "" && cur != "" && in_range != cur
            let beyond: bool = newest != "" && in_range != "" && newest != in_range
            let mark: string = if is_old then ui::yellow("↑") else if beyond then ui::cyan("»") else ui::green("✓")
            ui::line(mark + " " + project::dep_name(d) + "  " + ui::dim(k + "  " + util::or_default(cur, "not installed") + " → " +
                     util::or_default(in_range, "-") + " → " + util::or_default(newest, "-")) +
                     (if range != "" then "  " + ui::dim("(" + range + ")") else ""))
            if is_old is count += 1 end
        end
        i += 1
    end
    if count == 0 is ui::ok("everything is up to date within its version ranges") end
    return count
end
