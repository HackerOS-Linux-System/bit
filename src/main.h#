mod util
mod ui
mod cli
mod settings
mod hkdiag

extern static [c] is
    fn exit(code: int)
end

fn arg_at(arr: [string], i: int) -> string is
    if i < array_len(arr) is return arr[i] end
    return ""
end

fn join_from(arr: [string], start: int) -> string is
    let mut out: string = ""
    let mut i: int = start
    while i < array_len(arr) is
        if out != "" is out = out + " " end
        out = out + util::sq(arr[i])
        i += 1
    end
    return out
end

fn main() is
    let args: [string] = env::args()
    let argc: int = array_len(args)

    let mut release:   bool   = false
    let mut debug:     bool   = false
    let mut verbose:   bool   = false
    let mut force:     bool   = false
    let mut no_build:  bool   = false
    let mut use_lock:  bool   = true
    let mut global:    bool   = false
    let mut everything: bool  = false
    let mut is_lib:    bool   = false
    let mut dry_run:   bool   = false
    let mut check_only: bool  = false
    let mut target:    string = ""
    let mut platform:  string = ""
    let mut emit:      string = ""
    let mut output:    string = ""
    let mut lang:      string = ""
    let mut sign:      string = ""
    let mut cmd:       string = ""
    let mut pos:       [string] = []
    let mut passthru:  string = ""
    let mut dev:       bool   = false
    let mut special:   bool   = false
    let mut features:  string = ""
    let mut ver:       string = ""     ;; virus style:  bit install crates itoa --version 1.0
    let mut name_opt:  string = ""     ;; virus style:  bit init --name myapp
    let mut gen_opt:   string = ""     ;; Hacker Lang only:  bit init --lang hl --gen 2  (or rolling)

    let mut i: int = 1
    while i < argc is
        let a: string = args[i]
        if a == "--" is
            passthru = join_from(args, i + 1)
            i = argc
        else is
            match a is
                "--version" | "-V" => is
                    ;; `bit install <source> <name> --version 1.0` (virus syntax) takes a value;
                    ;; everywhere else it still prints bit's own version
                    let takes_value: bool = (cmd == "install" || cmd == "i" || cmd == "add") && a == "--version" &&
                                            i + 1 < argc && !string_starts_with(args[i + 1], "-")
                    if takes_value is
                        i += 1
                        ver = args[i]
                    else is
                        cli::print_version()
                        return
                    end
                end
                "--help"    | "-h" => is cli::print_help()    return end
                "--release" | "-r" => is release = true end
                "--debug"          => is debug = true end
                "--verbose" | "-v" => is verbose = true end
                "--force"   | "-f" => is force = true end
                "--no-build"       => is no_build = true end
                "--no-lock"        => is use_lock = false end
                "--global"  | "-g" => is global = true end
                "--all"            => is everything = true end
                "--lib"            => is is_lib = true end
                "--dry-run" | "-n" => is dry_run = true end
                "--check"          => is check_only = true end
                "--locked"         => is env_set("BIT_LOCKED", "1") end
                "--dev"            => is dev = true end
                "--special"        => is special = true end
                "--wasm"           => is env_set("BIT_SEL_WASM", "1") end
                "--jar"            => is env_set("BIT_SEL_JAR", "1") end
                "--library"        => is env_set("BIT_SEL_RLIB", "1") end
                "--all-features"   => is env_set("BIT_SEL_ALL_FEATURES", "1") end
                "--no-default-features" => is env_set("BIT_SEL_NO_DEFAULT", "1") end
                "--no-system-check" => is env_set("BIT_NO_SYSTEM_CHECK", "1") end
                "--features" | "-F" => is
                    i += 1
                    features = arg_at(args, i)
                    env_set("BIT_SEL_FEATURES", features)
                end
                "--bin"            => is
                    i += 1
                    env_set("BIT_SEL_BIN", arg_at(args, i))
                end
                "--package" | "--member" | "-p" => is
                    i += 1
                    env_set("BIT_SEL_MEMBER", arg_at(args, i))
                end
                "--offline"        => is env_set("BIT_OFFLINE", "1") end
                "--jobs" | "-j"    => is
                    i += 1
                    env_set("BIT_JOBS", arg_at(args, i))
                end
                "--target"  | "-t" => is
                    i += 1
                    target = arg_at(args, i)
                end
                "--platform"       => is
                    i += 1
                    platform = arg_at(args, i)
                end
                "--emit"           => is
                    i += 1
                    emit = arg_at(args, i)
                end
                "--output"  | "-o" => is
                    i += 1
                    output = arg_at(args, i)
                end
                "--name"           => is
                    i += 1
                    name_opt = arg_at(args, i)
                end
                "--lang"    | "-l" => is
                    i += 1
                    lang = arg_at(args, i)
                end
                "--gen"            => is
                    i += 1
                    gen_opt = arg_at(args, i)
                end
                "--sign"           => is
                    i += 1
                    sign = arg_at(args, i)
                end
                _ => is
                    if string_starts_with(a, "-") && string_len(a) > 1 is
                        ui::fail("unknown option '" + a + "'   (bit --help)")
                        exit(2)
                    else if cmd == "" is
                        cmd = string_slice(a, 0, string_len(a))
                    else is
                        pos = array_push(pos, a)
                    end
                end
            end
        end
        i += 1
    end

    let mut rc: int = 0
    settings::apply()

    if cmd == "" is
        rc = cli::cmd_auto(verbose)
    else is
        let first: string = arg_at(pos, 0)
        match cmd is
            "init" | "new" => is
                rc = cli::cmd_init(if name_opt != "" then name_opt else first, if lang != "" then lang else target, is_lib, gen_opt)
            end
            "build" => is
                if first != "" && (string_ends_with(first, ".hcs") || string_ends_with(first, ".h#")) is
                    rc = cli::cmd_build_file(first, release, verbose, output)
                else is
                    rc = cli::cmd_build(release, debug, verbose, target, platform, if emit != "" then emit else output, sign, use_lock)
                end
            end
            "run" => is
                rc = cli::cmd_run(release, debug, verbose, target, platform, passthru, use_lock)
            end
            "check" => is rc = cli::cmd_check(verbose) end
            "test" => is rc = cli::cmd_test(first, verbose, release) end
            "fmt" => is rc = cli::cmd_fmt(first, check_only, verbose) end
            "lint" => is rc = cli::cmd_lint(first, verbose) end
            "lsp" => is rc = cli::cmd_lsp(first) end
            "repair" => is rc = cli::cmd_repair(first) end
            "doc" => is rc = cli::cmd_doc(if output != "" then output else first) end
            "features" => is rc = cli::cmd_features() end
            "system" | "sys" => is rc = cli::cmd_system(if first == "" then "check" else first) end
            "python" | "py" => is rc = cli::cmd_python(first, arg_at(pos, 1), arg_at(pos, 2)) end
            "settings" | "config" => is rc = cli::cmd_settings(first, arg_at(pos, 1), arg_at(pos, 2)) end
            "new-ws" | "new-workspace" => is rc = cli::cmd_new_ws(first, special) end
            "ws" | "workspace" => is rc = cli::cmd_ws(first, arg_at(pos, 1), release, verbose, use_lock) end
            "clean" => is rc = cli::cmd_clean(everything) end
            "cache" => is rc = cli::cmd_cache() end
            "x" | "cmd" => is
                rc = cli::cmd_x(first, if passthru != "" then passthru else join_from(pos, 1))
            end
            "commands" => is rc = cli::cmd_commands() end
            "publish" => is rc = cli::cmd_publish() end
            "install" | "i" => is
                if array_len(pos) >= 2 && cli::is_virus_source(first) is
                    rc = cli::cmd_install_source(first, arg_at(pos, 1), ver, output, target, no_build, release, verbose, dev)
                else is
                    rc = cli::cmd_install(pos, output, target, platform, no_build, release, force, verbose, use_lock)
                end
            end
            "add" => is
                rc = cli::cmd_add(first, if arg_at(pos, 1) != "" then arg_at(pos, 1) else ver, output, target, no_build, release, verbose, dev)
            end
            "remove" | "rm" | "uninstall" => is
                ;; virus style:  bit remove crates itoa
                rc = cli::cmd_remove(if array_len(pos) >= 2 && cli::is_virus_source(first) then arg_at(pos, 1) else first, global)
            end
            "upgrade" => is rc = cli::cmd_upgrade(first, verbose, release, dry_run) end
            "outdated" => is rc = cli::cmd_outdated() end
            "list" | "ls" | "installed" => is rc = cli::cmd_list() end
            "search" => is rc = cli::cmd_search(first, lang) end
            "info" => is rc = cli::cmd_info(first) end
            "update" => is rc = cli::cmd_update() end
            "verify" => is rc = cli::cmd_verify(first) end
            "doctor" => is rc = cli::cmd_doctor() end
            ;; internal: Bit.hk diagnostics render in a child process (see hkdiag.h#)
            "__hk-diag" => is rc = hkdiag::child_main(first, false) end
            "__hk-lint" => is rc = hkdiag::child_main(first, true) end
            "__hk-msg"  => is rc = hkdiag::child_message(first, arg_at(pos, 1)) end
            "langs" | "languages" => is rc = cli::cmd_langs() end
            "help" => is cli::print_help() end
            _ => is
                ;; not built in: maybe a custom command from Bit.hk's [commands]
                let extra: string = if passthru != "" then passthru else join_from(pos, 0)
                let crc: int = cli::try_custom(cmd, extra)
                if crc == -1 is
                    ui::fail("unknown command '" + cmd + "'")
                    ui::note("see:  bit --help      custom commands:  bit commands")
                    rc = 2
                else is
                    rc = crc
                end
            end
        end
    end

    if rc != 0 is exit(rc) end
end
