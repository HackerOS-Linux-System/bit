;; ── Bit.hk editing ───────────────────────────────────────────────────────────

fn write_lines(path: string, lines: [string]) is
    file_write(path, util::join(lines, "\n"))
end

fn manifest_add_dep(p: project::Project, name: string, value: string, section: string) -> bool is
    let path: string = project::manifest_of(p)
    if path == "" is return false end
    let lines: [string] = string_split(file_read(path), "\n")
    let mut out: [string] = []
    let mut done: bool = false
    let mut i: int = 0
    while i < array_len(lines) is
        out = array_push(out, lines[i])
        let t: string = string_trim(lines[i])
        if !done && string_starts_with(t, "[") && hk::norm_section(string_slice(t, 1, string_len(t) - 1)) == section is
            out = array_push(out, "-> " + name + " => " + value)
            done = true
        end
        i += 1
    end
    if !done is
        out = array_push(out, "")
        out = array_push(out, "[" + section + "]")
        out = array_push(out, "-> " + name + " => " + value)
        out = array_push(out, "")
    end
    write_lines(path, out)
    return true
end

fn manifest_remove_dep(p: project::Project, name: string) -> bool is
    let path: string = project::manifest_of(p)
    if path == "" is return false end
    let lines: [string] = string_split(file_read(path), "\n")
    let mut out: [string] = []
    let mut in_deps: bool = false
    let mut skipping: bool = false
    let mut removed: bool = false
    let mut i: int = 0
    while i < array_len(lines) is
        let t: string = string_trim(lines[i])
        let mut keep: bool = true
        if string_starts_with(t, "[") && string_ends_with(t, "]") is
            let sec: string = hk::norm_section(string_slice(t, 1, string_len(t) - 1))
            in_deps = sec == "dependencies" || sec == "dev-dependencies"
            skipping = false
        else if in_deps && string_starts_with(t, "-->") && skipping is
            keep = false
        else if in_deps && string_starts_with(t, "->") is
            let body: string = string_trim(string_slice(t, 2, string_len(t)))
            let arrow: int = string_find(body, "=>")
            let key: string = if arrow >= 0 then string_trim(string_slice(body, 0, arrow)) else body
            if key == name is
                keep = false
                skipping = true
                removed = true
            else is
                skipping = false
            end
        end
        if keep is out = array_push(out, lines[i]) end
        i += 1
    end
    if removed is write_lines(path, out) end
    return removed
end

;; ── install / add / remove / upgrade ─────────────────────────────────────────

pub fn cmd_install(names: [string], output: string, target: string, platform: string, no_build: bool,
                   release: bool, force: bool, verbose: bool, use_lock: bool) -> int is
    if array_len(names) == 0 is
        let p: project::Project = need_project()
        if !project::is_loaded(p) is
            ui::fail("name a library to install:  bit install <name>")
            return 1
        end
        let mut bad: int = 0
        if workspace::is_workspace(p) is
            let ms: [workspace::Member] = workspace::list(p)
            let mut i: int = 0
            while i < array_len(ms) is
                if ms[i].mb_kind == "bit" is
                    let mp: project::Project = project::load(ms[i].mb_dir)
                    features::activate(mp, flags::features_for(mp, true), flags::no_default(), flags::all_features(), verbose)
                    ui::line(ui::cyan("▸") + " " + ui::bold(ms[i].mb_name))
                    bad += workflow::ensure_deps(mp, verbose, release, use_lock, force)
                    bad += workflow::ensure_dev_deps(mp, verbose, release, use_lock, force)
                end
                i += 1
            end
        else is
            if features::activate(p, flags::features(), flags::no_default(), flags::all_features(), verbose) != 0 is return 1 end
            bad += workflow::ensure_deps(p, verbose, release, use_lock, force)
            bad += workflow::ensure_dev_deps(p, verbose, release, use_lock, force)
        end
        if bad != 0 is return 1 end
        ui::ok("dependencies installed")
        return 0
    end
    ui::blank()
    let mut failed: int = 0
    let mut i: int = 0
    while i < array_len(names) is
        let o: installer::InstallOpts = installer::iopts(force, !no_build, output, target, platform, release, verbose)
        if installer::install_lib(names[i], "", o) != 0 is failed += 1 end
        i += 1
    end
    ui::blank()
    if failed > 0 is return 1 end
    return 0
end

;; ── bit add ──────────────────────────────────────────────────────────────────
;;   bit add silver                    newest version from the index
;;   bit add silver 0.1                exactly 0.1  (also: silver@0.1, ^0.1, >=0.1 <1)
;;   bit add silver v1.4               a tag / branch / commit of the index entry
;;   bit add https://host/org/repo     a git repository  (#dir picks a directory of it)
;;   bit add github:org/repo#crates/x  a repository on a forge (github gitlab codeberg bitbucket sourcehut)
;;   bit add pypi:requests 2.31        crates:serde ^1   npm:left-pad   jsr:@std/fs   vira:zlib
;;   bit add ../mine                   a path dependency
;;   --dev                             add to [dev-dependencies]

fn split_prefix(arg: string) -> [string] is
    let colon: int = string_find(arg, ":")
    if colon <= 0 || util::is_url(arg) is return ["", arg] end
    let head: string = string_lower(string_slice(arg, 0, colon))
    let rest: string = string_slice(arg, colon + 1, string_len(arg))
    if project::is_registry_kind(head) || project::is_builtin_kind(head) || head == "git" || head == "github" || head == "gitlab" ||
       head == "codeberg" || head == "bitbucket" || head == "sourcehut" is
        return [head, rest]
    end
    return ["", arg]
end

;; (dependency key, value for Bit.hk) for what the user typed.
fn add_spec(arg_in: string, rev_in: string) -> [string] is
    let mut arg: string = arg_in
    let mut rev: string = rev_in
    let at: int = string_find(arg, "@")
    if at > 0 && !util::is_url(arg) && !string_starts_with(arg, "@") && !string_contains(arg, "/") && rev == "" is
        rev = string_slice(arg, at + 1, string_len(arg))
        arg = string_slice(arg, 0, at)
    end
    let pre: [string] = split_prefix(arg)
    let kind: string = pre[0]
    let body: string = pre[1]
    let ver: string = if rev == "" then "" else if semver::is_range(rev) then rev else "rev " + rev
    let ver_only: string = if rev == "" then "newest" else rev

    if kind == "pypi" || kind == "crates" || kind == "npm" || kind == "jsr" || kind == "vira" is
        let key: string = if kind == "jsr" || string_starts_with(body, "@") then util::basename(body) else body
        return [key, kind + (if rev != "" then " " + ver_only else "")]
    end
    if kind == "std" || kind == "core" is return [body, kind] end
    if kind == "github" || kind == "gitlab" || kind == "codeberg" || kind == "bitbucket" || kind == "sourcehut" is
        let repo: string = if string_contains(body, "#") then string_slice(body, 0, string_find(body, "#")) else body
        return [util::basename(repo), kind + " " + body + (if rev != "" then " " + rev else "")]
    end
    if kind == "git" || util::is_url(body) is
        let url: string = if string_contains(body, "#") then string_slice(body, 0, string_find(body, "#")) else body
        return [installer::repo_name_from_url(url), "git " + body + (if rev != "" then " " + rev else "")]
    end
    if string_starts_with(body, ".") || string_starts_with(body, "/") || string_starts_with(body, "~") is
        return [util::basename(body), "path " + body]
    end
    if rev == "" is return [body, "newest"] end
    return [body, if semver::is_range(rev) then rev else "rev " + rev]
end

pub fn cmd_add(name: string, rev: string, output: string, target: string, no_build: bool, release: bool,
               verbose: bool, dev: bool) -> int is
    if name == "" is
        ui::fail("usage: bit add <name | git-url | kind:name> [version | rev]   [--dev]")
        ui::note("e.g.  bit add silver 0.1    bit add github:org/repo#dir    bit add pypi:requests 2.31")
        return 1
    end
    let p: project::Project = need_project()
    if !project::is_loaded(p) is return no_project_error() end
    let section: string = if dev then "dev-dependencies" else "dependencies"

    let spec: [string] = add_spec(name, rev)
    let key: string = spec[0]
    let value: string = spec[1]
    if !util::valid_name(key) is
        ui::fail("'" + key + "' is not a valid dependency name")
        return 1
    end
    if hk::hk_has(project::hk_of(p), section, key) is
        ui::note(key + " is already in [" + section + "]")
    else is
        manifest_add_dep(p, key, value, section)
        ui::ok("[" + section + "]  " + key + " => " + value)
    end

    ui::blank()
    let fresh: project::Project = project::load(project::root_of(p))
    let rc: int = if dev then workflow::ensure_dev_deps(fresh, verbose, release, false, false) else workflow::ensure_deps(fresh, verbose, release, false, false)
    if rc != 0 is return 1 end
    return 0
end

pub fn cmd_remove(name: string, global: bool) -> int is
    if name == "" is
        ui::fail("usage: bit remove <name> [--global]")
        return 1
    end
    let p: project::Project = need_project()
    let mut touched: bool = false
    let in_deps: bool = project::is_loaded(p) && (hk::hk_has(project::hk_of(p), "dependencies", name) || hk::hk_has(project::hk_of(p), "dev-dependencies", name))
    if in_deps is
        if manifest_remove_dep(p, name) is
            util::run("rm -rf " + util::sq(project::cache_libs(p) + "/" + name))
            let kinds: [string] = ["pypi", "crates", "npm", "jsr", "vira"]
            let mut k: int = 0
            while k < array_len(kinds) is
                util::run("rm -rf " + util::sq(project::cache_libs(p) + "/" + kinds[k] + "/" + name))
                k += 1
            end
            let pl: string = project::root_of(p) + "/Bit.lock"
            lock::lock_write(pl, lock::lock_del(lock::lock_read(pl), name))
            ui::ok(name + " removed from Bit.hk")
            touched = true
        end
    end
    if global || !touched is
        return installer::remove_lib(name)
    end
    return 0
end

pub fn cmd_upgrade(name: string, verbose: bool, release: bool, dry_run: bool) -> int is
    if dry_run is return cmd_outdated() end
    let p: project::Project = need_project()
    if name == "" && project::is_loaded(p) && array_len(project::deps(p)) > 0 is
        ui::blank()
        let rc: int = workflow::ensure_deps(p, verbose, release, false, true)
        return if rc != 0 then 1 else 0
    end

    let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
    let ix: index::Index = index::index_load()
    let mut failed: int = 0
    let mut i: int = 0
    ui::blank()
    while i < lock::lock_len(gl) is
        let e: lock::Locked = lock::lock_at(gl, i)
        let n: string = lock::locked_name(e)
        if name == "" || name == n is
            let in_index: bool = index::e_name(index::index_find(ix, n)) != ""
            let spec: string = if in_index then n else lock::locked_url(e)
            let o: installer::InstallOpts = installer::iopts(true, true, "", "", "", release, verbose)
            if installer::install_lib(spec, "", o) != 0 is failed += 1 end
        end
        i += 1
    end
    ui::blank()
    if failed > 0 is return 1 end
    return 0
end

pub fn cmd_outdated() -> int is
    let p: project::Project = project::load_here()
    if !project::is_loaded(p) is return no_project_error() end
    ui::blank()
    let n: int = workflow::outdated(p)
    ui::blank()
    if n < 0 is return 1 end
    if n > 0 is
        ui::note(to_string(n) + " dependenc" + (if n == 1 then "y" else "ies") + " can be upgraded:  bit upgrade [name]")
    end
    return 0
end

;; ── list / search / info / update ────────────────────────────────────────────

pub fn cmd_list() -> int is
    let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
    ui::heading("Installed libraries  " + ui::dim(util::libs_dir()))
    if lock::lock_len(gl) == 0 is
        ui::note("nothing installed yet — try:  bit install <name>     (bit search all)")
        ui::blank()
        return 0
    end
    let mut i: int = 0
    while i < lock::lock_len(gl) is
        let e: lock::Locked = lock::lock_at(gl, i)
        let n: string = lock::locked_name(e)
        let there: bool = dir_exists(installer::lib_dir(n, util::short_hash(lock::locked_commit(e))))
        let mark: string = if there then ui::green("✓") else ui::red("✗")
        ui::line(mark + " " + string_pad_right(n, 20) + ui::dim("@ " + string_pad_right(lock::locked_version(e), 9)) +
                 " " + ui::lang_tag(lock::locked_lang(e)) + "  " + ui::dim(lock::locked_output(e) + "  " + lock::locked_at(e)))
        i += 1
    end
    ui::blank()
    return 0
end

pub fn cmd_search(q: string, lang: string) -> int is
    let want: string = if lang == "" then "" else index::normalize_lang(lang)
    if lang != "" && want == "" is
        ui::fail("unknown language '" + lang + "' (h#, hl, hs)")
        return 1
    end
    let ix: index::Index = index::index_load()
    if index::ix_len(ix) == 0 is
        ui::fail("the library index is empty or unreachable — try:  bit update")
        return 1
    end
    let found: [index::LibEntry] = index::index_search(ix, q, want)
    ui::heading((if q == "" || q == "all" then "All libraries" else "Results for '" + q + "'") + "  " + ui::dim(to_string(array_len(found)) + " of " + to_string(index::ix_len(ix))))
    if array_len(found) == 0 is
        ui::note("no matches — list everything with:  bit search all")
        ui::blank()
        return 0
    end
    let mut i: int = 0
    while i < array_len(found) is
        let e: index::LibEntry = found[i]
        let tag: string = if index::e_lang(e) == "" then ui::dim("any") else ui::lang_tag(index::e_lang(e))
        let mark: string = if installer::is_installed(index::e_name(e)) then ui::green("✓") else " "
        ui::line(mark + " " + ui::bold(string_pad_right(index::e_name(e), 16)) + " " + tag + "  " + ui::dim(index::e_desc(e)))
        i += 1
    end
    ui::blank()
    return 0
end

pub fn cmd_info(name: string) -> int is
    if name == "" is
        ui::fail("usage: bit info <name>")
        return 1
    end
    let ix: index::Index = index::index_load()
    let e: index::LibEntry = index::index_find(ix, name)
    let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
    let l: lock::Locked = lock::lock_get(gl, name)
    if index::e_name(e) == "" && lock::locked_name(l) == "" is
        ui::fail("'" + name + "' is neither in the index nor installed")
        return 1
    end
    ui::heading(ui::bold(name))
    if index::e_name(e) != "" is
        ui::line(string_pad_right("description", 14) + index::e_desc(e))
        ui::line(string_pad_right("language", 14) + (if index::e_lang(e) == "" then "any / detected on install" else project::lang_label(index::e_lang(e))))
        ui::line(string_pad_right("repository", 14) + index::e_target(e))
        ui::line(string_pad_right("author", 14) + index::e_author(e))
        ui::line(string_pad_right("tags", 14) + util::join(index::e_tags(e), ", "))
        if index::e_rev(e) != "" is ui::line(string_pad_right("rev", 14) + index::e_rev(e)) end
        if index::e_checksum(e) != "" is ui::line(string_pad_right("pinned sum", 14) + index::e_checksum(e)) end
    end
    ui::blank()
    if lock::locked_name(l) != "" is
        ui::line(ui::green("installed") + "  " + ui::dim(util::libs_dir() + "/" + name + "/" + lock::locked_version(l)))
        ui::line(string_pad_right("commit", 14) + lock::locked_commit(l))
        ui::line(string_pad_right("checksum", 14) + lock::locked_checksum(l))
        ui::line(string_pad_right("output", 14) + lock::locked_output(l) + "   (statically linked)")
        ui::line(string_pad_right("installed at", 14) + lock::locked_at(l))
    else is
        ui::line(ui::dim("not installed —  bit install " + name))
    end
    ui::blank()
    return 0
end

pub fn cmd_update() -> int is
    ui::line(ui::dim("fetching " + index::index_url()))
    let rc: int = index::index_fetch()
    if rc == 0 is
        let ix: index::Index = index::index_load()
        ui::ok("index updated — " + to_string(index::ix_len(ix)) + " libraries")
    end
    return rc
end

