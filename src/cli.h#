;; ── build / run / check / clean / cache ──────────────────────────────────────

fn flags_given(release: bool, target: string, platform: string, emit: string) -> bool is
    return release || target != "" || platform != "" || emit != ""
end

fn effective_opts(p: project::Project, release: bool, debug: bool, verbose: bool, target: string,
                  platform: string, emit: string, sign: string) -> build::BuildOpts is
    let mut o: build::BuildOpts = build::opts_default(p)
    if flags_given(release, target, platform, emit) || debug is
        o = build::opts_new(release, verbose, target, platform, emit)
    else is
        o = build::opts_new(build::opts_release(o), verbose, project::get(p, "default-build", "target", ""),
                            project::get(p, "default-build", "platform", ""),
                            project::get(p, "default-build", "emit", ""))
    end
    if sign != "" is o = build::opts_with_sign(o, sign) end
    return o
end

pub fn cmd_build(release: bool, debug: bool, verbose: bool, target: string, platform: string, emit: string,
                 sign: string, use_lock: bool) -> int is
    let p: project::Project = need_project()
    if !project::is_loaded(p) is return no_project_error() end
    let o: build::BuildOpts = effective_opts(p, release, debug, verbose, target, platform, emit, sign)
    if workflow::ensure_deps(p, verbose, build::opts_release(o), use_lock, false) != 0 is
        ui::fail("some dependencies could not be installed")
        return 1
    end
    return build::build_project(p, o)
end

pub fn cmd_run(release: bool, debug: bool, verbose: bool, target: string, platform: string, args: string,
               use_lock: bool) -> int is
    let p: project::Project = need_project()
    if !project::is_loaded(p) is return no_project_error() end
    let o: build::BuildOpts = effective_opts(p, release, debug, verbose, target, platform, "", "")
    if workflow::ensure_deps(p, verbose, build::opts_release(o), use_lock, false) != 0 is
        ui::fail("some dependencies could not be installed")
        return 1
    end
    return build::run_project(p, o, args, false)
end

pub fn cmd_check(verbose: bool) -> int is
    let p: project::Project = need_project()
    if !project::is_loaded(p) is return no_project_error() end
    ui::blank()
    let rc: int = build::check_project(p, verbose)
