;; ── virus compatibility ──────────────────────────────────────────────────────
;; `virus install <source> <name> [--version V]`, `virus remove <source> <name>` and
;; `virus build <file>` keep working, so bit can stand in for virus completely.

pub fn is_virus_source(w: string) -> bool is
    return w == "pypi" || w == "crates" || w == "npm" || w == "jsr" || w == "vira" ||
           w == "std" || w == "core" || w == "bytes" || w == "bit"
end

;; virus-style install:  bit install crates itoa --version 1.0   ==  bit add crates:itoa 1.0
pub fn cmd_install_source(source: string, name: string, version: string, output: string, target: string,
                          no_build: bool, release: bool, verbose: bool, dev: bool) -> int is
    if name == "" is
        ui::fail("usage: bit install <source> <name> [--version V]    sources: pypi crates npm jsr vira bytes bit std core")
        return 1
    end
    ;; `bytes` and `bit` are the library index itself: a plain name
    let spec: string = if source == "bytes" || source == "bit" then name else source + ":" + name
    return cmd_add(spec, version, output, target, no_build, release, verbose, dev)
end

;; Single-file build (`bit build main.hcs`, `bit build tool.h#`) without a Bit.hk.
pub fn cmd_build_file(file: string, release: bool, verbose: bool, output: string) -> int is
    if !file_exists(file) is
        ui::fail("no such file: " + file)
        return 1
    end
    let base: string = util::basename(file)
    let dot: int = string_find(base, ".")
    let stem: string = if dot > 0 then string_slice(base, 0, dot) else base
    let out: string = if output != "" then output else stem
    if string_ends_with(file, ".h#") is
        let tool: string = build::tool_for("hsharp")
        if tool == "" is
            ui::fail("no H# compiler found")
            ui::note(build::missing_tool_hint("hsharp"))
            return 1
        end
        return util::run(tool + " compile " + util::sq(file) + " -o " + util::sq(out) + (if release then " --release" else ""))
    end
    if !string_ends_with(file, ".hcs") is
        ui::fail("bit build <file> takes a .hcs (HackerScript) or .h# (H#) file")
        return 1
    end
    let tool: string = build::tool_for("hackerscript")
    if tool == "" is
        ui::fail("no hackerc found")
        ui::note(build::missing_tool_hint("hackerscript"))
        return 1
    end
    if !util::tool_exists("cargo") is
        ui::fail("cargo is needed to compile HackerScript output (hackerc → Rust)")
        return 1
    end
    let crate: string = string_replace(stem, "-", "_")
    let work: string = util::tmp_dir() + "/single-" + stem
    util::rm_rf(work)
    util::mkdir_p(work)
    let rc1: int = util::run(tool + " build " + util::sq(file) + " -o " + util::sq(work) + " --crate-name " + crate + " --bin-name " + stem)
    if rc1 != 0 is return rc1 end
    let rc2: int = util::run("cargo build" + (if release then " --release" else "") + " --manifest-path " + util::sq(work + "/Cargo.toml") +
                             " --target-dir " + util::sq(work + "/target"))
    if rc2 != 0 is return rc2 end
    let built: string = work + "/target/" + (if release then "release" else "debug") + "/" + stem
    let rc3: int = util::run("cp -f " + util::sq(built) + " " + util::sq(out))
    if rc3 == 0 is ui::ok("built " + out) end
    return rc3
end


