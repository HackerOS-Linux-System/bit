pub fn cmd_verify(name: string) -> int is
    ui::heading("Verifying installed libraries")
    let problems: int = installer::verify_all(name)
    ui::blank()
    if problems == 0 is
        ui::ok("all checksums match bit.lock")
        return 0
    end
    ui::fail(to_string(problems) + " problem(s) — reinstall with:  bit upgrade <name>")
    return 1
end

fn tool_line(label: string, present: bool, hint: string) is
    if present is
        ui::ok(string_pad_right(label, 14) + ui::dim("found"))
    else is
        ui::bad(string_pad_right(label, 14) + ui::red("missing") + "  " + ui::dim(hint))
    end
end

pub fn cmd_langs() -> int is
    ui::heading("Language toolchains")
    let langs: [string] = ["hsharp", "hackerlang", "hackerscript"]
    let mut i: int = 0
    while i < array_len(langs) is
        let l: string = langs[i]
        let path: string = build::tool_for(l)
        if path != "" is
            ui::ok(string_pad_right(project::lang_label(l), 14) + ui::dim(path))
        else is
            ui::bad(string_pad_right(project::lang_label(l), 14) + ui::red("missing") + "  " + ui::dim(build::missing_tool_hint(l)))
        end
        i += 1
    end
    ui::blank()
    return 0
end

pub fn cmd_doctor() -> int is
    ui::heading("bit doctor")
    let mut bad: int = 0
    if !util::tool_exists("git") is
        bad += 1
    end
    tool_line("git", util::tool_exists("git"), "needed to fetch libraries")
    if !util::tool_exists("curl") is bad += 1 end
    tool_line("curl", util::tool_exists("curl"), "needed to fetch the index")
    let sha_ok: bool = util::tool_exists("sha256sum") || util::tool_exists("shasum")
    if !sha_ok is bad += 1 end
    tool_line("sha256sum", sha_ok, "needed for checksums")

    ui::blank()
    let mut i: int = 0
    let langs: [string] = ["hsharp", "hackerlang", "hackerscript"]
    while i < array_len(langs) is
        let has: bool = build::have_toolchain(langs[i])
        tool_line(project::lang_label(langs[i]), has, build::missing_tool_hint(langs[i]))
        i += 1
    end

    ui::blank()
    let ext: [string] = external::supported()
    let mut e: int = 0
    while e < array_len(ext) is
        tool_line(external::label(ext[e]), array_len(external::missing_tools(ext[e])) == 0, external::install_hint(ext[e]))
        e += 1
    end
    ui::note("(Rust, C, C++, Zig, Go, Odin, Crystal, Python are only needed for `mode => special` workspaces and lang => hackerscript)")

    ui::blank()
    ui::line(ui::dim("index     " + index::index_url()))
    ui::line(ui::dim("libraries " + util::libs_dir()))
    ui::line(ui::dim("state     " + util::bit_dir()))
    ui::blank()
    let problems: int = installer::verify_all("")
    ui::blank()
    if bad + problems == 0 is
        ui::ok("everything looks good")
        return 0
    end
    ui::fail("found problems above")
    return 1
end


