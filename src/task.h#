use "bit -> progress-bar" from "pb"
mod util
mod ui

pub fn is_tty() -> bool is
    if env_get("NO_COLOR") != "" || env_get("BIT_PLAIN") != "" || env_get("CI") != "" is return false end
    return util::run("test -t 1") == 0
end

fn scratch(kind: string) -> string is
    util::mkdir_p(util::tmp_dir())
    return util::tmp_dir() + "/" + kind + "-" + to_string(proc_id()) + "-" + to_string(time_ms())
end

;; Colour switches for a child whose output goes to a log file (see `run`). Only called when bit's stdout is a TTY
;; (NO_COLOR / BIT_PLAIN / CI already made is_tty() false). Values the user set explicitly are left alone.
;;   HSHARP_COLOR=1    h# CLI + the nidus error frames of the parser/codegen
;;   NIDUS_COLOR       nidus-based tools
;;   CLICOLOR_FORCE    cargo, colors library and most other tools
;; Skipped for git's clone progress (`show_git`): that log is parsed for the percentage.
fn child_color_env(show_git: bool) -> string is
    if show_git is return "" end
    let mut e: string = "export "
    if env_get("HSHARP_COLOR") == "" is e += "HSHARP_COLOR=1 " end
    if env_get("NIDUS_COLOR") == "" is e += "NIDUS_COLOR=always " end
    if env_get("CLICOLOR_FORCE") == "" is e += "CLICOLOR_FORCE=1 " end
    if e == "export " is return "" end
    return e + "; "
end

;; Last `n` lines of a log, for an error message.
fn tail_of(path: string, n: int) -> string is
    return util::capture("tail -n " + to_string(n) + " " + util::sq(path) + " 2>/dev/null")
end

;; Percentage git prints while cloning ("Receiving objects:  45% (…)") — 0 if none yet.
fn git_percent(log: string) -> int is
    let txt: string = util::capture("tr '\\r' '\\n' < " + util::sq(log) +
                                    " 2>/dev/null | grep -o '[0-9]*%' | tail -n 1 | tr -d '%'")
    if txt == "" is return 0 end
    return str_to_int(txt)
end

;; One finished step as a line: `✓  [18s]  H# › bit` / `✗  [1m04s]  H# › bit  failed`. The same layout the spinner uses
;; while the step runs (progress-bar's `Spinner::finish`), for the runs that draw no spinner (no TTY, --verbose).
pub fn report(ok: bool, ms: int, label: string) is
    let parts: [string] = ui::split_tag(label)
    let tag: string = parts[0]
    let mut name: string = parts[1]
    if !ok is name += " " + ui::red("failed") end
    let glyph: string = if ok then ui::green("✓") else ui::red("✗")
    let field: string = pb::format_elapsed_label(ms)
    let pad: int = 5 - string_len(field)
    let mut out: string = "  " + glyph + "  " + ui::dim(field)
    if pad > 0 is out += string_repeat(" ", pad) end
    out += "  "
    if tag != "" is out += ui::tag_paint(tag) + " " + ui::dim("›") + " " end
    write(out + name)
end

;; Runs `cmd` (a shell line) while a spinner turns:   ⠹  [16s]  H# › bit
;; `label` is `<tag>  <name>` (see ui::split_tag) or a plain message. The seconds counter is the progress-bar
;; spinner's `elapsed` field, read from the clock on every frame, so it keeps counting during a long compile.
;; `show_git` adds git's clone percentage to the message. Returns 0 on success; on failure the tail of the
;; command's output is printed. Nothing is drawn without a TTY.
pub fn run(label: string, cmd: string, verbose: bool, show_git: bool) -> int is
    if verbose || !is_tty() is
        if !verbose is ui::note(label + " …") end
        return util::run(cmd)
    end

    let parts: [string] = ui::split_tag(label)
    let name: string = parts[1]

    let log: string = scratch("task") + ".log"
    let rcf: string = scratch("task") + ".rc"
    ;; run detached; the exit status lands in rcf when the command is done
    ;; the WHOLE list must go to the background: `( cmd ) > log ; echo $? > rcf &` only backgrounded the
    ;; `echo`, so the command ran in the foreground (output hidden in the log) and the spinner never turned.
    ;; the child writes into a log file, not a terminal, so H# / nidus / cargo would switch colours off and the
    ;; error replayed below would be plain. bit's own stdout IS a terminal here (is_tty), so force colours in the child.
    util::run("{ ( " + child_color_env(show_git) + cmd + " ) >" + util::sq(log) + " 2>&1 ; echo $? >" + util::sq(rcf) + " ; } >/dev/null 2>&1 &")

    let mut sp = pb::quick_spinner_timed(ui::tag_paint(parts[0]), name)
    while !file_exists(rcf) is
        if show_git is
            let pct: int = git_percent(log)
            if pct > 0 is sp = sp.set_message(name + " " + ui::dim(to_string(pct) + "%")) end
        end
        sp = sp.tick()
        sp.draw()      ;; flushes: without it the frames sat in stdout's line buffer and never showed up
        sleep_ms(90)
    end
    let rc: int = str_to_int(util::capture("cat " + util::sq(rcf)))
    if rc == 0 is
        sp.finish(name)
    else is
        sp.fail(name + " " + ui::red("failed"))
        let tail: string = tail_of(log, 30)
        if tail != "" is write(tail) end
    end
    util::run("rm -f " + util::sq(log) + " " + util::sq(rcf))
    return rc
end
