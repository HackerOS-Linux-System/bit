mod util
mod ui

;; hsbundle.h# — a HackerScript library as ONE source file.
;;
;; Why this exists:
;;   `hackerc hlib build <entry.hcs>` packs the text of ONE file into the archive (`ast/<name>.hcs`,
;;   see HackerScript/docs/HLIB_FORMAT.md §5). A library such as `mold` has an entry file
;;   (`lib/mod.hcs`) that consists of nothing but `include <style>`, `include <buffer>`, … — so the
;;   archive that came out of it was hollow: the consumer got thirteen include lines and none of the
;;   code behind them.
;;
;;   bit therefore pastes every `include <x>` in place (once per file, in dependency order) and hands
;;   `hackerc` the result. `get <…>` lines are hoisted to the top, because a nested file may not
;;   carry them in the middle of a program; the first `using <version>` line wins.
;;
;; Name resolution of `include <x>` (relative to the file that contains it):
;;   <dir>/x.hcs     <dir>/x/mod.hcs     <lib root>/x.hcs     <lib root>/x/mod.hcs
;; An include that matches none of those (a module of the language itself) is left as it is.

;; MEMORY NOTE (why the body is NOT a string any more):
;;   H# never frees a string (`hsh_string_free` is a no-op) and `a + b` allocates a fresh copy. The first
;;   version of this file did `body = body + raw + "\n"` once per source line, i.e. it copied the whole,
;;   growing body for every line: for a library of ~12 000 lines / ~560 KB (`gui`) that is several GB of
;;   garbage that is never released — the process was killed by the OOM killer ("Killed  bit").
;;   The body is therefore streamed line by line into a scratch file (`bd_tmp`, via `fs_append`) and glued
;;   behind the header once at the end: memory use is linear in the size of the library, not quadratic.
pub struct Bundle is
    pub bd_seen: [string]     ;; absolute / root-relative paths that were already pasted
    pub bd_gets: [string]     ;; hoisted `get <…>` lines, no duplicates
    pub bd_uses: [string]     ;; `using <…>` lines found, no duplicates
    pub bd_tmp: string        ;; scratch file that receives the flattened source (without the hoisted lines)
    pub bd_left: [string]     ;; include targets that are not files of the library (kept as written)
    pub bd_pasted: int        ;; how many files were pasted in place of an include
    pub bd_self: string       ;; name of the library being bundled ("" = unknown): `get <bit:<self>::x>` means `include <x>`
end

fn empty_bundle(tmp: string, self_name: string) -> Bundle is
    return Bundle { bd_seen: [], bd_gets: [], bd_uses: [], bd_tmp: tmp, bd_left: [], bd_pasted: 0, bd_self: self_name }
end

;; "style" for `include <style>` — "" for every other line.
pub fn include_target(line: string) -> string is
    let t: string = string_trim(line)
    if !string_starts_with(t, "include") is return "" end
    let lt: int = string_find(t, "<")
    let gt: int = string_find(t, ">")
    if lt < 0 || gt < lt is return "" end
    ;; `include` must be followed by a space or by `<` directly — not `include_all <x>`
    if string_trim(string_slice(t, 7, lt)) != "" is return "" end
    return string_trim(string_slice(t, lt + 1, gt))
end

;; "native" for `get <bit:gui::native>` when the library being bundled is `gui` — "" for every other line.
;; A library must not import its OWN modules through `get <bit:<self>::x>`: while it is being built it is not in
;; BIT_LIBS, and once it is packed into an .hlib the consumer has no `bit:<self>` either (the line was left in the
;; archive and made `get <hlib:<self>>` fail). Such a line therefore means exactly `include <x>`.
fn self_get_target(line: string, self_name: string) -> string is
    if self_name == "" is return "" end
    let t: string = string_trim(line)
    let pre: string = "get <bit:" + self_name + "::"
    if !string_starts_with(t, pre) is return "" end
    let gt: int = string_find(t, ">")
    if gt < pre.len() is return "" end
    return string_trim(string_slice(t, pre.len(), gt))
end

fn is_get_line(line: string) -> bool is
    let t: string = string_trim(line)
    return string_starts_with(t, "get <") || string_starts_with(t, "get<")
end

fn is_using_line(line: string) -> bool is
    let t: string = string_trim(line)
    return string_starts_with(t, "using <") || string_starts_with(t, "using<")
end

;; The file an `include <name>` stands for, "" when it is not a file of the library.
fn find_include(dir: string, root: string, name: string) -> string is
    if name == "" || string_contains(name, "..") is return "" end
    let cands: [string] = [
        dir + "/" + name + ".hcs",
        dir + "/" + name + "/mod.hcs",
        root + "/" + name + ".hcs",
        root + "/" + name + "/mod.hcs"
    ]
    let mut i: int = 0
    while i < array_len(cands) is
        if file_exists(cands[i]) is return cands[i] end
        i += 1
    end
    return ""
end

fn paste(file: string, root: string, b: Bundle) -> Bundle is
    let lines: [string] = string_split(file_read(file), "\n")
    let dir: string = util::dirname(file)
    let mut seen: [string] = array_push(b.bd_seen, file)
    let mut gets: [string] = b.bd_gets
    let mut uses: [string] = b.bd_uses
    let tmp: string = b.bd_tmp
    let mut left: [string] = b.bd_left
    let mut pasted: int = b.bd_pasted
    let mut i: int = 0
    while i < array_len(lines) is
        let raw: string = lines[i]
        let mut tgt: string = include_target(raw)
        let mut via_get: bool = false
        if tgt == "" is
            tgt = self_get_target(raw, b.bd_self)
            via_get = tgt != ""
        end
        if tgt != "" is
            let f: string = find_include(dir, root, tgt)
            if f == "" is
                if via_get is
                    ;; names no file of this library: keep it as an ordinary (hoisted) `get`
                    let t: string = string_trim(raw)
                    if !util::array_has(gets, t) is gets = array_push(gets, t) end
                else is
                    fs_append(tmp, raw + "\n")
                    if !util::array_has(left, tgt) is left = array_push(left, tgt) end
                end
            else if !util::array_has(seen, f) is
                let sub: Bundle = paste(f, root, Bundle { bd_seen: seen, bd_gets: gets, bd_uses: uses,
                                                          bd_tmp: tmp, bd_left: left, bd_pasted: pasted + 1,
                                                          bd_self: b.bd_self })
                seen = sub.bd_seen
                gets = sub.bd_gets
                uses = sub.bd_uses
                left = sub.bd_left
                pasted = sub.bd_pasted
            end
        else if is_get_line(raw) is
            let t: string = string_trim(raw)
            if !util::array_has(gets, t) is gets = array_push(gets, t) end
        else if is_using_line(raw) is
            let t: string = string_trim(raw)
            if !util::array_has(uses, t) is uses = array_push(uses, t) end
        else is
            fs_append(tmp, raw + "\n")
        end
        i += 1
    end
    return Bundle { bd_seen: seen, bd_gets: gets, bd_uses: uses, bd_tmp: tmp, bd_left: left, bd_pasted: pasted, bd_self: b.bd_self }
end

;; Flattens `entry` (a path), `root` being the library's source directory (`lib/`). The flattened body ends
;; up in the scratch file `tmp`; the returned Bundle carries everything else (hoisted lines, counters).
pub fn flatten(entry: string, root: string, tmp: string, self_name: string) -> Bundle is
    return paste(entry, root, empty_bundle(tmp, self_name))
end

;; Everything that goes in front of the body: the winning `using <…>`, the banner and the hoisted `get <…>`s.
fn render_header(b: Bundle, entry_label: string) -> string is
    let mut out: string = ""
    if array_len(b.bd_uses) > 0 is out = out + b.bd_uses[0] + "\n" end
    out = out + "!!! bundled by bit from " + entry_label + " (" + to_string(b.bd_pasted) + " include(s) pasted)\n"
    let mut i: int = 0
    while i < array_len(b.bd_gets) is
        out = out + b.bd_gets[i] + "\n"
        i += 1
    end
    return out + "\n"
end

;; Writes the flattened library to `out`. `entry_rel` is relative to `root_dir` (the project root),
;; `lib_rel` is the library's source directory (`lib`), also relative to it.
;; Returns true when `out` was written.
pub fn bundle_to(root_dir: string, entry_rel: string, lib_rel: string, out: string, self_name: string) -> bool is
    let entry: string = root_dir + "/" + entry_rel
    if !file_exists(entry) is
        ui::fail("bundle: no such file " + entry)
        return false
    end
    util::mkdir_p(util::dirname(out))
    let tmp: string = out + ".body.tmp"
    util::rm_rf(tmp)
    file_write(tmp, "")
    let b: Bundle = flatten(entry, root_dir + "/" + lib_rel, tmp, self_name)
    ;; header first (it needs the hoisted lines, known only now), then the body in ONE read + ONE append
    file_write(out, render_header(b, entry_rel))
    fs_append(out, file_read(tmp))
    util::rm_rf(tmp)
    if array_len(b.bd_uses) > 1 is
        ui::warn("bundle: " + to_string(array_len(b.bd_uses)) + " different `using <…>` lines — kept " + b.bd_uses[0])
    end
    if array_len(b.bd_left) > 0 is
        ui::note("bundle: left as written (not files of this library): " + util::join(b.bd_left, ", "))
    end
    return file_exists(out)
end
