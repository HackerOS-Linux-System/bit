mod util
;; NOTE: no `use "std -> json"` here. Importing the std wrapper mangles its fns to
;; json_get_str / json_set_str / json_stringify_pretty …, which collide with the LLVM
;; builtins of the same names (self-recursion / wrong arity -> invalid IR). `json::get_str`,
;; `json::set_str` and `json::empty_object` resolve straight to those builtins instead.

pub struct Locked is
    pub lk_name:     string
    pub lk_version:  string
    pub lk_commit:   string
    pub lk_url:      string
    pub lk_checksum: string
    pub lk_lang:     string
    pub lk_output:   string
    pub lk_at:       string
    pub lk_range:    string   ;; constraint the entry was resolved from (`^1.2`), "" = none
    pub lk_tag:      string   ;; git tag it resolved to (`v1.4.2`), "" = a branch / commit
    pub lk_source:   string   ;; index | git | pypi | crates | npm | jsr | vira | std | core
    pub lk_dir:      string   ;; directory of the repository the library was taken from ("" = the root)
end

pub struct Lock is
    pub lock_items: [Locked]
    pub lock_count: int
end

pub fn locked_name(p: Locked)     -> string is return p.lk_name end
pub fn locked_version(p: Locked)  -> string is return p.lk_version end
pub fn locked_commit(p: Locked)   -> string is return p.lk_commit end
pub fn locked_url(p: Locked)      -> string is return p.lk_url end
pub fn locked_checksum(p: Locked) -> string is return p.lk_checksum end
pub fn locked_lang(p: Locked)     -> string is return p.lk_lang end
pub fn locked_output(p: Locked)   -> string is return p.lk_output end
pub fn locked_at(p: Locked)       -> string is return p.lk_at end
pub fn locked_range(p: Locked)    -> string is return p.lk_range end
pub fn locked_tag(p: Locked)      -> string is return p.lk_tag end
pub fn locked_source(p: Locked)   -> string is return p.lk_source end
pub fn locked_dir(p: Locked)      -> string is return p.lk_dir end

pub fn lock_len(l: Lock)              -> int    is return l.lock_count end
pub fn lock_at(l: Lock, i: int)       -> Locked is return l.lock_items[i] end

pub fn empty_entry() -> Locked is
    return Locked { lk_name: "", lk_version: "", lk_commit: "", lk_url: "", lk_checksum: "",
                    lk_lang: "", lk_output: "", lk_at: "", lk_range: "", lk_tag: "",
                    lk_source: "", lk_dir: "" }
end

pub fn empty_lock() -> Lock is
    return Lock { lock_items: [], lock_count: 0 }
end

pub fn global_lock_path() -> string is
    return util::bit_dir() + "/bit.lock"
end

;; bit.lock / Bit.lock are JSON Lines: one flat object per library, e.g.
;;   {"name":"mold","version":"a1b2c3d4e5f6","commit":"…","url":"…","checksum":"sha256:…",…}
;; (flat objects are exactly what std `json` reads and writes in compiled H#).
;;

fn locked_from(o: string, name: string) -> Locked is
    return Locked {
        lk_name:     name,
        lk_version:  json::get_str(o, "version"),
        lk_commit:   json::get_str(o, "commit"),
        lk_url:      json::get_str(o, "url"),
        lk_checksum: json::get_str(o, "checksum"),
        lk_lang:     json::get_str(o, "lang"),
        lk_output:   json::get_str(o, "output"),
        lk_at:       json::get_str(o, "installed_at"),
        lk_range:    json::get_str(o, "range"),
        lk_tag:      json::get_str(o, "tag"),
        lk_source:   json::get_str(o, "source"),
        lk_dir:      json::get_str(o, "dir")
    }
end

fn write_items(path: string, items: [Locked]) is
    util::mkdir_p(util::dirname(path))
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(items) is
        let p: Locked = items[i]
        let mut o: string = json::empty_object()
        o = json::set_str(o, "name", p.lk_name)
        o = json::set_str(o, "version", p.lk_version)
        o = json::set_str(o, "commit", p.lk_commit)
        o = json::set_str(o, "url", p.lk_url)
        o = json::set_str(o, "checksum", p.lk_checksum)
        o = json::set_str(o, "lang", p.lk_lang)
        o = json::set_str(o, "output", p.lk_output)
        o = json::set_str(o, "installed_at", p.lk_at)
        o = json::set_str(o, "range", p.lk_range)
        o = json::set_str(o, "tag", p.lk_tag)
        o = json::set_str(o, "source", p.lk_source)
        o = json::set_str(o, "dir", p.lk_dir)
        out = out + o + "\n"
        i += 1
    end
    ;; write next to the target and rename — a crash never leaves a half-written lock
    let tmp: string = path + ".tmp"
    file_write(tmp, out)
    util::run("mv -f " + util::sq(tmp) + " " + util::sq(path))
end

pub fn lock_read(path: string) -> Lock is
    if !file_exists(path) is return empty_lock() end
    let text: string = file_read(path)
    let lines: [string] = string_split(string_replace(text, "\r", ""), "\n")
    let mut items: [Locked] = []
    let mut i: int = 0
    while i < array_len(lines) is
        let line: string = string_trim(lines[i])
        let name: string = if line == "" then "" else json::get_str(line, "name")
        if name != "" is items = array_push(items, locked_from(line, name)) end
        i += 1
    end
    return Lock { lock_items: items, lock_count: array_len(items) }
end

pub fn lock_write(path: string, l: Lock) is
    write_items(path, l.lock_items)
end

pub fn lock_get(l: Lock, name: string) -> Locked is
    let mut i: int = 0
    while i < l.lock_count is
        if l.lock_items[i].lk_name == name is return l.lock_items[i] end
        i += 1
    end
    return Locked { lk_name: "", lk_version: "", lk_commit: "", lk_url: "", lk_checksum: "",
                    lk_lang: "", lk_output: "", lk_at: "", lk_range: "", lk_tag: "",
                    lk_source: "", lk_dir: "" }
end

pub fn lock_has(l: Lock, name: string) -> bool is
    return locked_name(lock_get(l, name)) != ""
end

;; Insert or replace (by name), keeping the original position when replacing.
pub fn lock_set(l: Lock, entry: Locked) -> Lock is
    let mut items: [Locked] = []
    let mut found: bool = false
    let mut i: int = 0
    while i < l.lock_count is
        if l.lock_items[i].lk_name == entry.lk_name is
            items = array_push(items, entry)
            found = true
        else is
            items = array_push(items, l.lock_items[i])
        end
        i += 1
    end
    if !found is items = array_push(items, entry) end
    return Lock { lock_items: items, lock_count: array_len(items) }
end

pub fn lock_del(l: Lock, name: string) -> Lock is
    let mut items: [Locked] = []
    let mut i: int = 0
    while i < l.lock_count is
        if l.lock_items[i].lk_name != name is items = array_push(items, l.lock_items[i]) end
        i += 1
    end
    return Lock { lock_items: items, lock_count: array_len(items) }
end
