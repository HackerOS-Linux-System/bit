    section("PROJECT", "", "coral", "orchid")
    row("    init [name] [--lang h#|hl|hs] [--lib] [--gen N|rolling]   new project (or initialise the current directory)")
    row("      --gen is Hacker Lang only ([package] -> gen in Bit.hk); writes a matching `using <gen N>` into the entry file")
    row("    build [--release] [--target h#|hl|hs] [--platform P] [--emit bin|hlib|so|a|rlib|obj]")
    row("      [--bin NAME] [--wasm] [--jar] [--library]   extra binaries (src/bin/*.h#, cmd/bin/*.hcs), wasm32, jar, rlib")
    row("    build <file.hcs|file.h#>     compile one file without a Bit.hk          (virus build <file>)")
    row("      [--features a,b] [--all-features] [--no-default-features] [--no-system-check]")
    row("                                 without flags: uses [default-build] from Bit.hk")
    row("    run [--bin NAME] [-- args]   build and run          check   syntax + type check")
    row("    test [filter]                run #[test] functions (needs [dev-dependencies] too)")
    row("    fmt [file] [--check]         format sources         lint [file]   show warnings only")
    row("    doc [dir]                    HTML documentation from `;;` comments")
    row("    lsp [h#|hs]                  language server on stdio        repair <code>   explain E0001 / W0002 …")
    row("    clean [--all]                remove cache/ (--all: also old installed versions)")
    row("    cache                        show / create the project cache/ directories")
    row("    x <name> [args]              run a custom command from [commands] (also: bit <name>)")
    row("    commands                     list custom commands")
    row("    publish                      validate Bit.hk and print the index entry to submit")
    row("    pack [--out DIR] [--platform P] [--debug] [--no-build] [--no-sources]")
    row("                                 pack the library into  <name>-<version>-<platform>.bit  (SquashFS, compiled hlib inside)")
    row("                                 + .sha256 — attach both to the GitHub release of the tag. Tuned by [pack] in Bit.hk")
    row("    pkg [list|info|ls|verify|mount|umount|extract] [file.bit|name] [--all]     work with .bit packages")
    ui::blank()
    section("WORKSPACES", "", "deepskyblue", "aquamarine")
    row("    new-ws <name> [--special]    new workspace (special: members in different languages)")
    row("    ws [info|list|build|test|clean] [member]     build at the root = every member, dependencies first")
    row("    -p <member>                  pick one member of a workspace (for build / run / test / check)")
    ui::blank()
    section("LIBRARIES", "installed to ~/.hackeros/libs/, checksummed, linked statically", "lawngreen", "gold")
    row("    install [name|git-url ...]   install libraries (no name: [dependencies] + [dev-dependencies])")
    row("      --prebuilt | --prebuilt-only | --no-prebuilt    take <name>-<version>-<platform>.bit from the library's GitHub release")
    row("        (nothing is compiled, nothing is unpacked: the SquashFS is mounted)   = [prebuilt] in Bit.hk, BIT_PREBUILT   --mount auto|fuse|kernel|extract")
    row("    install <source> <name> [--version V]   virus style, = add: pypi crates npm jsr vira bytes bit std core")
    row("      [--output hlib|so|a|obj] [--target h#|hl|hs] [--no-build] [--release] [--force]")
    row("    add <name|url|kind:name> [version|rev] [--dev]     install + add to Bit.hk")
    row("      silver            newest        silver 0.1   that exact version      silver ^0.1   a range")
    row("      github:org/repo#dir   a directory of a repository      pypi:requests 2.31   crates:serde ^1   npm:x   jsr:@s/x   vira:zlib")
    row("    remove <name> [--global]     remove from the project (or uninstall)      (also: remove <source> <name>)")
    row("    hlib [list|inspect|verify|build|path] [name|file.hlib]   the .hlib of installed libraries — any language;")
    row("                                 `hlib build <name>` compiles a library that was installed without its compiler")
    row("    upgrade [name] [--dry-run]   re-resolve version ranges, fetch the newest matches, refresh Bit.lock")
    row("    outdated                     locked → newest-in-range → newest version of every dependency")
    row("    features                     list the project's [features]")
    row("    system [check|install|list]  [system-dependencies]: look for native libraries, install the missing ones")
