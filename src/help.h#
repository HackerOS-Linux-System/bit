;; ── `bit help` ───────────────────────────────────────────────────────────────
;; The text of the help lives here (it used to be cli::print_help); the colours come from the
;; `colors` library of bit.io (160+ named colours, gradients, themes — it honours NO_COLOR,
;; TERM=dumb, COLORTERM and downgrades truecolor → 256 → 16 colours by itself).
;;
;; The text is written as plain rows. `highlight` colours a row by what each word is:
;;
;;     install [name|git-url ...]   install libraries (no name: [dependencies])      <- row at 4 spaces
;;     ^^^^^^^ command  ^^^^^^^^^^^^ arguments (violet)   ^^^ description (plain)
;;
;; options (`--force`, `-r`) are orange, `[sections]` and BIT_* variables khaki.

fn st_cmd(s: string)  -> string is return colors::bold(colors::fg::deepskyblue(s)) end
fn st_opt(s: string)  -> string is return colors::fg::orange(s) end
fn st_arg(s: string)  -> string is return colors::fg::plum(s) end
fn st_env(s: string)  -> string is return colors::fg::khaki(s) end
fn st_punct(s: string) -> string is return colors::dim(s) end

fn is_letter(c: string) -> bool is
    return string_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", c)
end

fn count_lead(t: string, set: string) -> int is
    let mut i: int = 0
    while i < string_len(t) && string_contains(set, string_at(t, i)) is i += 1 end
    return i
end

fn count_trail(t: string, set: string) -> int is
    let mut k: int = 0
    while k < string_len(t) && string_contains(set, string_at(t, string_len(t) - 1 - k)) is k += 1 end
    return k
end

;; How deep inside `[ ]` / `< >` the row is after this word.
fn next_depth(tok: string, depth_in: int) -> int is
    let mut depth: int = depth_in
    let mut i: int = 0
    while i < string_len(tok) is
        let c: string = string_at(tok, i)
        let prev: string = if i > 0 then string_at(tok, i - 1) else ""
        if c == "[" || c == "<" is
            depth += 1
        else if (c == "]" || c == ">") && prev != "-" && prev != "=" is
            if depth > 0 is depth -= 1 end
        end
        i += 1
    end
    return depth
end

;; zone 1 = command + arguments, zone 2 = description
fn style_token(tok: string, zone: int, first: bool, depth: int) -> string is
    let n: int = string_len(tok)
    let lead: int = count_lead(tok, "[(")
    let trail: int = count_trail(string_slice(tok, lead, n), "]),;:")
    let lead_s: string = string_slice(tok, 0, lead)
    let trail_s: string = string_slice(tok, n - trail, n)
    let core: string = string_slice(tok, lead, n - trail)
    if core == "" is return st_punct(tok) end

    let mut styled: string = core
    let is_opt: bool = string_len(core) > 1 && string_starts_with(core, "-") && !string_starts_with(core, "->")
    let in_brackets: bool = depth > 0 || string_contains(lead_s, "[")
    if string_starts_with(core, "BIT_") || string_starts_with(core, "HSHARP_") is
        styled = st_env(core)
    else if is_opt is
        styled = st_opt(core)
    else if zone == 1 && first && is_letter(string_at(core, 0)) is
        styled = st_cmd(core)
    else if zone == 1 && (in_brackets || string_starts_with(core, "<")) is
        styled = st_arg(core)
    else if zone == 2 && string_contains(lead_s, "[") && string_contains(trail_s, "]") is
        styled = st_env(core)
    end
    return (if lead_s != "" then st_punct(lead_s) else "") + styled + (if trail_s != "" then st_punct(trail_s) else "")
end

pub fn highlight(line: string) -> string is
    let n: int = string_len(line)
    let mut i: int = 0
    while i < n && string_at(line, i) == " " is i += 1 end
    let indent: int = i
    if indent == 0 || indent >= n is return line end
    let cmd_row: bool = indent == 4
    let mut zone: int = if cmd_row then 1 else 2
    let mut out: string = string_slice(line, 0, indent)
    let mut depth: int = 0
    let mut seen: int = 0          ;; words of the current zone-1 part
    let mut described: int = 0     ;; words of description seen on this row
    while i < n is
        if string_at(line, i) == " " is
            let mut j: int = i
            while j < n && string_at(line, j) == " " is j += 1 end
            let run: int = j - i
            out = out + string_slice(line, i, j)
            if zone == 1 && seen > 0 && run >= 2 is
                zone = 2
                depth = 0
            else if zone == 2 && cmd_row && described > 0 && run >= 8 && j < n && is_letter(string_at(line, j)) is
                ;; two commands on one row:  `run ...   build and run          check   syntax + type check`
                zone = 1
                seen = 0
                depth = 0
            end
            i = j
        else is
            let mut j: int = i
            while j < n && string_at(line, j) != " " is j += 1 end
            let tok: string = string_slice(line, i, j)
            out = out + style_token(tok, zone, zone == 1 && seen == 0, depth)
            if zone == 1 is
                depth = next_depth(tok, depth)
                seen += 1
            else is
                described += 1
            end
            i = j
        end
    end
    return out
end

;; ── pieces ───────────────────────────────────────────────────────────────────

fn row(text: string) is write(highlight(text)) end

fn banner(version: string) is
    let chips: string = colors::fg::tomato("H#") + colors::dim(", ") + colors::fg::orchid("Hacker Lang") + colors::dim(", ") + colors::fg::turquoise("HackerScript")
    write("  " + colors::bold(colors::gradient::sunset("bit")) + " " + colors::fg::gold(version) + "  " +
          colors::dim("package manager for every HackerOS language (") + chips + colors::dim(")"))
end

;; ━━ NAME ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━  (one gradient across the whole rule)
fn section(name: string, sub: string, from: string, to: string) is
    let fill: int = 46 - string_len(name)
    let rule: string = "━━ " + name + " " + string_repeat("━", if fill > 2 then fill else 2)
    let mut s: string = "  " + colors::bold(colors::gradient::text(rule, from, to))
    if sub != "" is s = s + "  " + colors::dim(sub) end
    write(s)
end

fn footer() is
    write("  " + colors::theme::hint("new here?  " + colors::fg::deepskyblue("bit init myapp --lang h#") + colors::dim("  →  ") +
          colors::fg::deepskyblue("cd myapp") + colors::dim("  →  ") + colors::fg::deepskyblue("bit")))
    write("  " + colors::dim("Index: ") + colors::theme::link(index::index_url()))
end

