use "bit -> hk-parser" from "hkp"
mod util

pub struct Hk is
    pub hk_cfg: hkp::HkConfig
end

pub fn hk_empty() -> Hk is
    return Hk { hk_cfg: hkp::parse("") }
end

;; `[Default build]`, `[default_build]` and `[default-build]` are the same section.
pub fn norm_section(raw: string) -> string is
    let t: string = string_lower(string_trim(raw))
    return string_replace(string_replace(t, " ", "-"), "_", "-")
end

;; Parses manifest text with the hk-parser library. Comments are whole lines that
;; start with `!`; a key is either a value or a map, never both. A syntax error
;; is reported once and yields an empty document, so callers fall back to their
;; defaults.
pub fn hk_parse(text: string) -> Hk is
    let cfg: hkp::HkConfig = hkp::parse(text)
    if !cfg.is_valid() is
        write("bit: cannot parse manifest: " + hkp::last_error())
        return hk_empty()
    end
    return Hk { hk_cfg: cfg }
end

;; `section.key` (key may itself be dotted: `name.rev`).
fn path_of(section: string, key: string) -> string is
    if key == "" is return section end
    return section + "." + key
end

;; Section names in the file are matched after normalisation, so `[default_build]`
;; still answers to "default-build".
fn real_section(h: Hk, section: string) -> string is
    let names: [string] = h.hk_cfg.keys("")
    let mut i: int = 0
    while i < array_len(names) is
        if names[i] == section is return names[i] end
        i += 1
    end
    i = 0
    while i < array_len(names) is
        if norm_section(names[i]) == section is return names[i] end
        i += 1
    end
    return section
end

;; Arrays come back in the `[a, b, "c"]` text form that hk_list understands.
fn array_text(h: Hk, path: string) -> string is
    let n: int = h.hk_cfg.array_len(path)
    let mut out: string = "["
    let mut i: int = 0
    while i < n is
        if i > 0 is out = out + ", " end
        out = out + "\"" + h.hk_cfg.array_get(path, i) + "\""
        i += 1
    end
    return out + "]"
end

;; The raw text of a value, interpolations not yet resolved.
fn raw_get(h: Hk, section: string, key: string, fallback: string) -> string is
    let path: string = path_of(real_section(h, section), key)
    if !h.hk_cfg.has(path) is return fallback end
    let t: string = h.hk_cfg.type_of(path)
    if t == "array" is return array_text(h, path) end
    if t == "map" is
        ;; a key that is both a value and has options is stored as a map with `value`
        if h.hk_cfg.has(path + ".value") is return h.hk_cfg.get(path + ".value") end
        return fallback
    end
    let v: string = h.hk_cfg.get(path)
    if v == "" is return fallback end
    return v
end

;; ── Interpolation ────────────────────────────────────────────────────────────
;;   ${env:NAME}          an environment variable ("" when unset)
;;   ${section.key}       another value of the same file, e.g. ${package.version}
;;   ${section.key.sub}   a sub-key:  ${dependencies.mine.git}
;; A reference may itself contain references; a cycle is an error (the text is left as written).

fn interpolate(h: Hk, text: string, visiting: [string], depth: int) -> string is
    if !string_contains(text, "${") || depth > 16 is return text end
    let mut out: string = ""
    let mut rest: string = text
    while string_contains(rest, "${") is
        let start: int = string_find(rest, "${")
        out = out + string_slice(rest, 0, start)
        let after: string = string_slice(rest, start + 2, string_len(rest))
        let close: int = string_find(after, "}")
        if close < 0 is
            out = out + "${" + after
            rest = ""
        else is
            let expr: string = string_trim(string_slice(after, 0, close))
            rest = string_slice(after, close + 1, string_len(after))
            if string_starts_with(expr, "env:") is
                out = out + env_get(string_slice(expr, 4, string_len(expr)))
            else if util::array_has(visiting, expr) is
                write("bit: Bit.hk: circular reference ${" + expr + "}")
                out = out + "${" + expr + "}"
            else is
                let dot: int = string_find(expr, ".")
                let sec: string = if dot > 0 then string_slice(expr, 0, dot) else expr
                let key: string = if dot > 0 then string_slice(expr, dot + 1, string_len(expr)) else ""
                let v: string = raw_get(h, sec, key, "@@bit-unset@@")
                if v == "@@bit-unset@@" is
                    write("bit: Bit.hk: ${" + expr + "} refers to nothing")
                    out = out + "${" + expr + "}"
                else is
                    out = out + interpolate(h, v, array_push(visiting, expr), depth + 1)
                end
            end
        end
    end
    return out
end

pub fn hk_get(h: Hk, section: string, key: string, fallback: string) -> string is
    let v: string = raw_get(h, section, key, "@@bit-unset@@")
    if v == "@@bit-unset@@" is return fallback end
    return interpolate(h, v, [], 0)
end

pub fn hk_has(h: Hk, section: string, key: string) -> bool is
    return h.hk_cfg.has(path_of(real_section(h, section), key))
end

pub fn hk_has_section(h: Hk, section: string) -> bool is
    return h.hk_cfg.has(real_section(h, section))
end

;; Keys (in file order) of a section — direct children only.
pub fn hk_keys(h: Hk, section: string) -> [string] is
    ;; Guard: hk-parser's `hk_map_key_count` returns the C `int` -1 for a missing path or a
    ;; non-map value. H# `int` is 64-bit and the C return is not sign-extended, so that -1
    ;; arrived as 4294967295 and `keys()` looped ~4 billion times (one regex compile per
    ;; iteration) -> the binary seemed to hang / print nothing. Only ask for keys of a real map.
    let path: string = real_section(h, section)
    if !h.hk_cfg.has(path) is return [] end
    if h.hk_cfg.type_of(path) != "map" is return [] end
    return h.hk_cfg.keys(path)
end

;; `[a, b, "c"]` -> ["a", "b", "c"]   (a bare `a, b` list works too)
pub fn hk_list(value: string) -> [string] is
    let mut t: string = string_trim(value)
    if string_starts_with(t, "[") && string_ends_with(t, "]") is
        t = string_slice(t, 1, string_len(t) - 1)
    end
    let parts: [string] = util::csv_split(t)
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(parts) is
        let p: string = string_trim(parts[i])
        let mut v: string = string_trim(parts[i])
        if string_len(p) >= 2 && string_starts_with(p, "\"") && string_ends_with(p, "\"") is
            v = string_slice(p, 1, string_len(p) - 1)
        end
        if v != "" is out = array_push(out, v) end
        i += 1
    end
    return out
end

;; `[package]` first, then `[project]` (Hacker Lang spelling).
pub fn hk_pkg(h: Hk, key: string, fallback: string) -> string is
    let a: string = hk_get(h, "package", key, "")
    if a != "" is return a end
    return hk_get(h, "project", key, fallback)
end

;; Would this text parse?
pub fn hk_valid(text: string) -> bool is
    return hkp::parse(text).is_valid()
end

;; Direct children of a map key: `hk_sub_keys(h, "dependencies", "mine")` ->
;; ["git", "dir", "rev"] for   -> mine / --> git => … / --> dir => …
pub fn hk_sub_keys(h: Hk, section: string, key: string) -> [string] is
    let path: string = path_of(real_section(h, section), key)
    if !h.hk_cfg.has(path) is return [] end
    if h.hk_cfg.type_of(path) != "map" is return [] end
    return h.hk_cfg.keys(path)
end

;; `true|yes|1|on` / `false|no|0|off`
pub fn hk_bool(h: Hk, section: string, key: string, fallback: bool) -> bool is
    let v: string = string_lower(hk_get(h, section, key, ""))
    if v == "true" || v == "yes" || v == "1" || v == "on" is return true end
    if v == "false" || v == "no" || v == "0" || v == "off" is return false end
    return fallback
end
