pub fn lib_root(name: string) -> string is return util::libs_dir() + "/" + name end

;; `<libs>/<name>/<id>/` — <id> names the library's CONTENT: the first 12 hex digits of the sha256
;; of its files (checksum::short_id), not a commit. The same files always land in the same
;; directory, a new commit that changed nothing does not create a new copy, and `bit verify` can
;; tell from the name alone that a directory is not what it was.
pub fn lib_dir(name: string, id: string) -> string is
    if util::libs_flat() is return util::libs_dir() + "/" + name end
    return util::libs_dir() + "/" + name + "/" + id
end

;; Where the version bit resolves for `name` lives: `<libs>/<name>/current` (a link to <id>/),
;; or — with `[directories] file => project` — the library's own directory.
pub fn current_dir(name: string) -> string is
    if util::libs_flat() is return lib_root(name) end
    return lib_root(name) + "/current"
end

;; `bit upgrade` calls this first: from then on install_lib looks at the remote before it downloads,
;; and fetches only what is newer than the installed copy (see `upstream_news`).
pub fn begin_update() is
    net::set_update(true)
end

pub fn is_installed(name: string) -> bool is
    let l: lock::Lock = lock::lock_read(lock::global_lock_path())
    let e: lock::Locked = lock::lock_get(l, name)
    if lock::locked_name(e) == "" is return false end
    return dir_exists(lib_dir(name, lock::locked_id(e)))
end

;; ── Options ──────────────────────────────────────────────────────────────────

pub struct InstallOpts is
    pub io_force:    bool
    pub io_build:    bool     ;; compile the library after fetching
    pub io_output:   string   ;; "" = whatever the library's Bit.hk says (default hlib)
    pub io_lang:     string   ;; "" = auto-detect
    pub io_platform: string
    pub io_release:  bool
    pub io_verbose:  bool
    pub io_depth:    int
    pub io_name:     string   ;; install under this name ("" = the index name / the repository's name)
    pub io_dir:      string   ;; take the library from this directory of the repository ("" = the root)
    pub io_source:   string   ;; recorded in the lock: index | git
    pub io_bit:      string   ;; per-dependency `prebuilt`: "" = follow [prebuilt] | "false" = from source | "true" = .bit
end

pub fn iopts(force: bool, do_build: bool, output: string, target: string, platform: string,
             release: bool, verbose: bool) -> InstallOpts is
    return InstallOpts {
        io_force: force, io_build: do_build, io_output: string_lower(output),
        io_lang: index::normalize_lang(target),
        io_platform: if platform != "" then platform else if index::normalize_lang(target) == "" then target else "",
        io_release: release, io_verbose: verbose, io_depth: 0,
        io_name: "", io_dir: "", io_source: "", io_bit: ""
    }
end

;; Same options, but the library is installed as `name` and (optionally) taken from `dir` of its repository.
pub fn with_origin(o: InstallOpts, name: string, dir: string, source: string) -> InstallOpts is
    return InstallOpts { io_force: o.io_force, io_build: o.io_build, io_output: o.io_output, io_lang: o.io_lang,
                         io_platform: o.io_platform, io_release: o.io_release, io_verbose: o.io_verbose,
                         io_depth: o.io_depth, io_name: name, io_dir: dir, io_source: source, io_bit: o.io_bit }
end

;; Same options with the dependency's own `prebuilt` choice ("" | "true" | "false").
pub fn with_bit(o: InstallOpts, choice: string) -> InstallOpts is
    return InstallOpts { io_force: o.io_force, io_build: o.io_build, io_output: o.io_output, io_lang: o.io_lang,
                         io_platform: o.io_platform, io_release: o.io_release, io_verbose: o.io_verbose,
                         io_depth: o.io_depth, io_name: o.io_name, io_dir: o.io_dir, io_source: o.io_source, io_bit: choice }
end

fn deeper(o: InstallOpts) -> InstallOpts is
    return InstallOpts { io_force: false, io_build: o.io_build, io_output: "", io_lang: "",
                         io_platform: o.io_platform, io_release: o.io_release,
                         io_verbose: o.io_verbose, io_depth: o.io_depth + 1,
                         io_name: "", io_dir: "", io_source: "", io_bit: "" }
end

;; ── Fetching ─────────────────────────────────────────────────────────────────

pub fn repo_name_from_url(url: string) -> string is
    let mut base: string = util::basename(url)
    if string_ends_with(base, ".git") is base = string_slice(base, 0, string_len(base) - 4) end
    return base
end

;; ── Manifest of a fetched library ────────────────────────────────────────────

fn lib_manifest(dir: string) -> hk::Hk is
    let candidates: [string] = ["Bit.hk", "bit.hk"]
    let mut i: int = 0
    while i < array_len(candidates) is
        if file_exists(dir + "/" + candidates[i]) is
            return hk::hk_parse_at(dir + "/" + candidates[i], file_read(dir + "/" + candidates[i]))
        end
        i += 1
    end
    return hk::hk_empty()
end

fn detect_lang(dir: string, h: hk::Hk, hint: string) -> string is
    if hint != "" is return hint end
    let declared_all: [string] = index::parse_langs(util::or_default(hk::hk_pkg(h, "lang", ""), hk::hk_get(h, "build", "lang", "")))
    if array_len(declared_all) > 0 is return declared_all[0] end
    let p: project::Project = project::load(dir)
    let found: [string] = project::detect_langs(p)
    if array_len(found) > 0 is return found[0] end
    return ""
end

;; ── Building an installed library ────────────────────────────────────────────

;; File name of the artifact of `name` for an output kind.
fn artifact_name(name: string, output: string) -> string is
    if output == "so" is return "lib" + name + ".so" end
    if output == "a" is return "lib" + name + ".a" end
    if output == "obj" is return name + ".o" end
    return name + ".hlib"
end

fn ext_of(output: string) -> string is
    if output == "so" is return "so" end
    if output == "a" is return "a" end
    if output == "obj" is return "o" end
    return "hlib"
end

;; Compiles the library in `dir` statically; artifacts land in dir/.bit/out.
;; Returns the artifact path, or "" when nothing was built.
fn build_installed(name: string, dir: string, lang: string, output: string, o: InstallOpts) -> string is
    if !build::have_toolchain(lang) is
        ui::warn(project::lang_label(lang) + " toolchain not found — " + name + " kept as source only")
        return ""
    end
    let p: project::Project = project::load(dir)
    let lib_entry: string = project::entry_for(p, lang, "lib")
    if lib_entry == "" is
        ui::note(name + ": no library entry point — nothing to compile")
        return ""
    end
    let outdir: string = dir + "/.bit/out"
    util::mkdir_p(outdir)
    let bo: build::BuildOpts = build::opts_new(o.io_release, o.io_verbose, lang, o.io_platform, output)
    ;; build_project uses cache/; keep the installed tree clean by building into .bit
    let rc: int = build::build_project(project::load_with_cache(dir, dir + "/.bit"), bo)
    if rc != 0 is
        ui::warn(name + ": build failed — kept as source only")
        return ""
    end
    let built_dir: string = dir + "/.bit/build/" + build::profile_name(bo)
    let art_name: string = artifact_name(name, output)
    util::run("cp -f " + util::sq(built_dir + "/" + art_name) + " " + util::sq(outdir + "/" + art_name) + " 2>/dev/null")
    if file_exists(outdir + "/" + art_name) is
        util::run("ln -sfn " + util::sq(".bit/out/" + art_name) + " " + util::sq(dir + "/" + art_name))
        return outdir + "/" + art_name
    end
    return ""
end

;; The compiled file bit promises for an installed library, "" when it holds only sources (or is a prebuilt .bit).
pub fn artifact_of(name: string, e: lock::Locked) -> string is
    let out: string = lock::locked_output(e)
    if out == "" || out == "source" || out == "bit" is return "" end
    return lib_dir(name, lock::locked_id(e)) + "/.bit/out/" + artifact_name(name, out)
end

;; Records in the global lock which kind of artifact an installed library now has.
fn lock_record_output(name: string, out: string) is
    let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
    let e: lock::Locked = lock::lock_get(gl, name)
    if lock::locked_name(e) != "" is
        lock::lock_write(lock::global_lock_path(), lock::lock_set(gl, lock::Locked {
            lk_name: lock::locked_name(e), lk_version: lock::locked_version(e), lk_commit: lock::locked_commit(e),
            lk_url: lock::locked_url(e), lk_checksum: lock::locked_checksum(e), lk_lang: lock::locked_lang(e),
            lk_output: out, lk_at: lock::locked_at(e), lk_range: lock::locked_range(e), lk_tag: lock::locked_tag(e),
            lk_source: lock::locked_source(e), lk_dir: lock::locked_dir(e)
        }))
    end
end

;; An installed library that was never compiled — its toolchain was missing when it was fetched, the build
;; failed once, or an older bit stopped at "already installed" — is compiled NOW, with the toolchain of ITS
;; OWN language (HackerScript / Hacker Lang / H#), whatever language the project asking for it is written in.
;; This is what lets an H# program `use "hlib -> mold"` a HackerScript library.
;; Returns 0 when the library has its compiled artifact afterwards (or has nothing to compile), 1 when it
;; could not be built — the reason has been printed.
pub fn ensure_compiled(name: string, o: InstallOpts) -> int is
    let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
    let e: lock::Locked = lock::lock_get(gl, name)
    if lock::locked_name(e) == "" is return 1 end
    if lock::locked_output(e) == "bit" is return 0 end          ;; a prebuilt .bit package is compiled already
    let dest: string = lib_dir(name, lock::locked_id(e))
    if !dir_exists(dest) is return 1 end

    let h: hk::Hk = lib_manifest(dest)
    let lang: string = if lock::locked_lang(e) != "" then lock::locked_lang(e) else detect_lang(dest, h, "")
    if lang == "" is return 0 end
    let out_choice: string = if o.io_output != "" then o.io_output
                             else string_lower(util::or_default(hk::hk_get(h, "lib", "output", ""), "hlib"))
    let want: string = dest + "/.bit/out/" + artifact_name(name, out_choice)
    if file_exists(want) is
        if lock::locked_output(e) != out_choice is lock_record_output(name, out_choice) end
        return 0
    end

    let p: project::Project = project::load(dest)
    if project::entry_for(p, lang, "lib") == "" is return 0 end   ;; a library of sources only: nothing to compile
    if !build::have_toolchain(lang) is
        ui::warn(name + " (" + project::lang_label(lang) + ") has no compiled " + artifact_name(name, out_choice) + " — the " +
                 project::lang_label(lang) + " toolchain was not found")
        ui::note(build::missing_tool_hint(lang))
        return 1
    end
    ui::line(ui::dim("compiling") + " " + ui::bold(name) + "  " + ui::dim(project::lang_label(lang) + " → " + artifact_name(name, out_choice)))
    let art: string = build_installed(name, dest, lang, out_choice, o)
    if art == "" is return 1 end
    lock_record_output(name, out_choice)
    return 0
end

;; .bit packages: the mode that applies to this install — "off" | "auto" | "only"
fn effective_bit(o: InstallOpts) -> string is
    let m: string = bitpkg::mode_here()
    if o.io_bit == "false" is return "off" end
    if o.io_bit == "true" && m == "off" is return "auto" end
    return m
end

;; ── Install ──────────────────────────────────────────────────────────────────


;; url of an index name / git url ("" when the library is not in the index)
pub fn spec_url(spec: string) -> string is
    if util::is_url(spec) || locator::is_local_spec(spec) is
        let lc: locator::Locator = locator::parse(spec)
        return lc.lc_url
    end
    let ix: index::Index = index::index_load()
    let e: index::LibEntry = index::index_find(ix, spec)
    return index::e_target(e)
end

;; Is `spec` a WHOLE git repository (so that a parallel full clone up front is worth it)? A
;; directory or a single file of a repository is fetched sparsely instead, and a download or a local
;; path is not a clone at all. `dir` is the dependency's own `dir =>` ("" = none).
pub fn spec_prefetchable(spec: string, dir: string) -> bool is
    if dir != "" is return false end
    if util::is_url(spec) || locator::is_local_spec(spec) is
        let lc: locator::Locator = locator::parse(spec)
        return lc.lc_kind == "git" && lc.lc_dir == ""
    end
    let ix: index::Index = index::index_load()
    let e: index::LibEntry = index::index_find(ix, spec)
    return index::e_name(e) != "" && index::e_kind(e) == "git" && index::e_dir(e) == ""
end

;; Newest tag of `spec` that satisfies `range` ("" = none / offline / unreachable).
;; A range with no operator (`1.2`) that matches no tag is taken as a plain rev.
pub fn resolve_range(spec: string, range: string) -> string is
    let url: string = spec_url(spec)
    if url == "" is return "" end
    let tags: [string] = net::remote_tags(url)
    return semver::best_tag(tags, range)
end

fn looks_like_tag(rev: string) -> string is
    if rev != "" && semver::parse(rev) >= 0 is return rev end
    return ""
end

;; The current project's language, when it declares exactly one — "" otherwise (no project here,
;; or a mixed-language workspace member where only `--target`/`--lang` can disambiguate).
;; `install_lib` uses this to resolve a bare name against the *right* index entry without the
;; caller having to pass `--target` every time: a HackerScript project asking for a name that the
;; shared index also lists for H# should get the HackerScript entry by default, the same way
;; `virus install bit <name>` only ever looked at entries tagged for HackerScript (or untagged) —
;; see `index::index_find_lang`.
fn current_project_lang_hint() -> string is
    let p: project::Project = project::load_here()
    if !project::is_loaded(p) is return "" end
    let langs: [string] = project::langs(p)
    if array_len(langs) == 1 is return langs[0] end
    return ""
end

;; ── Is the installed copy still the newest? ─────────────────────────────────

;; A commit id for people: 12 digits; a tag stays as it is.
fn shown(v: string) -> string is
    if util::is_hex(v) && string_len(v) > 12 is return util::short_hash(v) end
    return v
end

;; What the remote has that the installed copy `have` lacks — the new commit (for a prebuilt .bit:
;; the new release tag). "" = nothing newer, "?" = the remote could not be reached.
;; Costs one `git ls-remote` (a prebuilt: one request to the releases page); nothing is downloaded.
fn upstream_news(url: string, rev: string, have: lock::Locked) -> string is
    if lock::locked_output(have) == "bit" is
        ;; a prebuilt package follows the newest RELEASE, not the branch
        if rev != "" is return "" end
        let base: string = bitpkg::release_base(url)
        if base == "" is return "" end
        let latest: string = bitpkg::latest_tag(base)
        if latest == "" is return "?" end
        if latest != lock::locked_tag(have) is return latest end
        return ""
    end
    let tip: string = net::remote_commit(url, rev)
    if tip == "" is return "?" end
    if tip == lock::locked_commit(have) is return "" end
    return tip
end

;; A .bit package was downloaded and opened: link, lock, install its dependencies.
fn finish_prebuilt(name: string, url: string, source: string, hint_lang: string, got: bitpkg::Got, o: InstallOpts) -> int is
    let short: string = got.g_id      ;; the image's sha256 names the copy, like the files' sha256 does for a source install
    let dest: string = lib_dir(name, short)
    if !util::libs_flat() is
        util::run("ln -sfn " + util::sq(short) + " " + util::sq(current_dir(name)))
    end
    let h: hk::Hk = lib_manifest(dest)
    let lang: string = if got.g_lang != "" then got.g_lang else detect_lang(dest, h, hint_lang)
    let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
    lock::lock_write(lock::global_lock_path(), lock::lock_set(gl, lock::Locked {
        lk_name: name, lk_version: short, lk_commit: got.g_commit, lk_url: url,
        lk_checksum: checksum::tag(got.g_sum), lk_lang: lang, lk_output: "bit", lk_at: util::now_iso(),
        lk_range: "", lk_tag: got.g_tag, lk_source: source, lk_dir: ""
    }))
    ui::ok(ui::bold(name) + " " + ui::dim("@ " + util::or_default(got.g_tag, short) + "  " + project::lang_label(lang) +
           "  .bit (" + got.g_how + ")  sha256:" + util::short_hash(got.g_sum)))
    if install_lib_deps(name, h, dest, o) != 0 is return 1 end
    return 0
end

pub fn install_lib(spec: string, rev_in: string, o: InstallOpts) -> int is
    if o.io_depth > 8 is
        ui::fail("dependency chain too deep (cycle?) at " + spec)
        return 1
    end

    ;; 1. resolve name + url
    let mut name: string = string_slice(spec, 0, string_len(spec))
    let mut url: string = ""
    let mut rev: string = rev_in
    let mut pinned: string = ""
    let mut hint_lang: string = o.io_lang
    let mut dir: string = o.io_dir
    let mut source: string = if o.io_source != "" then o.io_source else "index"
    let mut fetch: string = "git"     ;; where the files come from: git | http (a file download) | local (a path)

    if util::is_url(spec) || locator::is_local_spec(spec) is
        ;; a repository, ONE DIRECTORY of it (`…/tree/<ref>/<dir>`, `url#dir`), ONE FILE of it
        ;; (`…/blob/<ref>/<file>`), a file download, or a path on disk — see locator.h#
        let lc: locator::Locator = locator::parse(spec)
        url = lc.lc_url
        fetch = lc.lc_kind
        name = if lc.lc_name != "" then lc.lc_name else repo_name_from_url(url)
        if o.io_source == "" is source = fetch end
        if dir == "" is dir = lc.lc_dir end
        if rev == "" is rev = lc.lc_rev end
    else is
        if !util::valid_name(spec) is
            ui::fail("invalid library name '" + spec + "'")
            return 1
        end
        let ix: index::Index = index::index_load()
        let lang_hint: string = if hint_lang != "" then hint_lang else current_project_lang_hint()
        let e: index::LibEntry = index::index_find_lang(ix, spec, lang_hint)
        if index::e_name(e) == "" is
            ui::fail("library '" + spec + "' not found in the index")
            ui::note("search:  bit search " + spec + "     or install directly:  bit install <git-url | …/tree/<ref>/<dir> | …/blob/<ref>/<file> | file-url | path>")
            return 1
        end
        name = index::e_name(e)
        url = index::e_target(e)
        fetch = index::e_kind(e)
        if dir == "" is dir = index::e_dir(e) end
        if rev == "" is rev = index::e_rev(e) end
        pinned = index::e_checksum(e)
        if hint_lang == "" is hint_lang = index::e_lang(e) end
    end
    if o.io_name != "" is name = o.io_name end
    if !util::valid_name(name) is
        ui::fail("invalid library name '" + name + "'")
        return 1
    end

    ;; already there?
    ;;   * pinned (a tag, a commit id): the installed copy is the answer, no network;
    ;;   * following a branch (no rev, or a branch name): ONE `git ls-remote` — a newer commit upstream
    ;;     is downloaded, otherwise nothing is (BIT_FRESH=off skips the question, --offline too);
    ;;   * `bit upgrade` (BIT_UPDATE) asks the same question of every library, pinned to a tag or not,
    ;;     so it fetches only what really changed.
    let updating: bool = net::update_mode()
    if (!o.io_force || updating) && is_installed(name) is
        let have: lock::Locked = lock::lock_get(lock::lock_read(lock::global_lock_path()), name)
        let have_commit: string = lock::locked_commit(have)
        let same_rev: bool = rev == "" || lock::locked_tag(have) == rev || have_commit == rev ||
                             string_starts_with(have_commit, rev)
        let pinned_rev: bool = rev != "" && (looks_like_tag(rev) != "" || util::is_hex(rev))
        let ask: bool = fetch == "git" && !net::offline() &&
                        (if updating then !util::is_hex(rev) else (!pinned_rev && net::fresh_check()))
        let news: string = if ask then upstream_news(url, rev, have) else ""
        let mut stay: bool = false
        if fetch != "git" && updating is
            stay = false                         ;; a copied path / a download: `bit upgrade` fetches it again
        else if same_rev is
            stay = !(news != "" && news != "?")
        else is
            stay = !pinned_rev && ask && news == ""     ;; a branch that is still where the installed copy is
        end
        if stay is
            if news == "?" is
                ui::note(name + " is installed (the remote could not be reached to look for a newer version)")
            else if ask is
                ui::note(name + " is up to date  " + ui::dim(shown(have_commit)))
            else is
                ui::note(name + " is already installed (bit upgrade " + name + " to refresh)")
            end
            ;; "installed" must also mean "usable": a copy that was never compiled is compiled now
            if o.io_build is ensure_compiled(name, o) end
            return 0
        end
        if same_rev is
            if news != "" && news != "?" is
                ui::note(name + ": a newer version is available  " + ui::dim(shown(have_commit) + " → " + shown(news)) + " — updating")
            end
        else is
            ui::note(name + ": installed " + shown(have_commit) + ", wanted " + rev + " — installing it")
        end
    end
    if net::offline() && fetch != "local" is
        ui::fail(name + " is not installed and bit is offline (BIT_OFFLINE / --offline)")
        return 1
    end

    ;; 1b. a prebuilt .bit package from the repository's GitHub release (opt-in: [prebuilt] / --prebuilt)
    let bmode: string = effective_bit(o)
    if bmode != "off" && dir == "" && fetch == "git" is
        let got: bitpkg::Got = bitpkg::install(name, url, rev, o.io_verbose)
        if got.g_state == 0 is
            return finish_prebuilt(name, url, source, hint_lang, got, o)
        end
        if got.g_state == 1 is
            ui::fail(name + ": " + got.g_msg)
            return 1
        end
        if bmode == "only" is
            ui::fail(name + ": " + got.g_msg + "  ([prebuilt] mode => only: not building from source)")
            return 1
        end
        ui::note(name + ": " + got.g_msg + " — building from source")
    end

    ui::line(ui::dim("fetching") + " " + ui::bold(name) + "  " + ui::dim(url + (if dir != "" then "  [" + dir + "]" else "")))
    util::mkdir_p(util::tmp_dir())
    let tmp: string = util::tmp_dir() + "/" + name + "-" + to_string(proc_id())
    util::rm_rf(tmp)

    ;; 2. fetch — into `tmp`; `held` is what becomes the library (the whole checkout, a directory of
    ;;    it, or a single file) and `commit` its identity
    let mut commit: string = ""
    let mut held: string = ""
    if fetch == "git" is
        let pre: string = net::prefetch_dir(url, rev)
        if dir_exists(pre) && !o.io_force is
            util::run("mv " + util::sq(pre) + " " + util::sq(tmp))
        else is
            ;; one directory / one file of a repository: only that path is downloaded (sparse clone)
            let rc: int = if dir != "" then net::clone_sub(url, rev, tmp, dir, "cloning " + name, o.io_verbose)
                          else net::clone(url, rev, tmp, "cloning " + name, o.io_verbose)
            if rc != 0 is
                ui::fail("git clone failed: " + url)
                ui::note("network trouble? retries: BIT_RETRIES, timeout: BIT_TIMEOUT, offline: BIT_OFFLINE=1")
                util::rm_rf(tmp)
                return 1
            end
        end
        commit = util::capture("git -C " + util::sq(tmp) + " rev-parse HEAD 2>/dev/null")
        if commit == "" is
            ui::fail("not a git repository: " + url)
            util::rm_rf(tmp)
            return 1
        end
        util::rm_rf(tmp + "/.git")
        held = if dir != "" then tmp + "/" + dir else tmp
        if !dir_exists(held) && !file_exists(held) is
            ui::fail(name + ": the repository has no directory or file '" + dir + "'")
            util::rm_rf(tmp)
            return 1
        end
    else is
        ;; a file download / a path on disk: there is no commit — the content hash stands in for it
        let lc: locator::Locator = locator::Locator { lc_kind: fetch, lc_url: url, lc_rev: "", lc_dir: "", lc_name: name }
        held = locator::stage_plain(lc, tmp)
        if held == "" is
            util::rm_rf(tmp)
            return 1
        end
        commit = locator::plain_id(tmp)
        if commit == "" is
            ui::fail(name + ": nothing was fetched from " + url)
            util::rm_rf(tmp)
            return 1
        end
    end

    ;; a single file (not a directory) becomes a tiny library of its own
    if !dir_exists(held) is
        let pkg: string = tmp + "/.bit-file-library"
        if !locator::wrap_file(held, name, pkg) is
            ui::fail(name + ": cannot prepare the file " + held)
            util::rm_rf(tmp)
            return 1
        end
        held = pkg
    end

    ;; 3. identity: sha256 of the files (+ the index's pin). The directory is named after it —
    ;;    `version` below — so identical files always land in the same place.
    let sum: string = checksum::dir_checksum(held)
    if sum == "" is
        ui::fail(name + ": cannot compute the checksum of the fetched files (sha256sum / shasum missing?)")
        util::rm_rf(tmp)
        return 1
    end
    if pinned != "" && !checksum::matches(pinned, sum) is
        ui::fail(name + ": checksum mismatch — the index pins " + checksum::untag(pinned))
        ui::note("got      " + sum)
        util::rm_rf(tmp)
        return 1
    end
    let version: string = checksum::short_id(sum)

    ;; 4. place — unless exactly these files are already installed (a new commit that changed
    ;;    nothing in the library): that copy, with whatever was built in it, stays
    let dest: string = lib_dir(name, version)
    util::mkdir_p(lib_root(name))
    let mut reused: bool = false
    if dir_exists(dest) is
        if !o.io_force && checksum::dir_checksum(dest) == sum is
            reused = true
        else is
            bitpkg::close(dest)
            util::rm_rf(dest)
        end
    end
    if !reused is
        util::run("rm -f " + util::sq(bitpkg::image_path(name, version)))
        if util::run("mv " + util::sq(held) + " " + util::sq(dest)) != 0 is
            ui::fail("cannot move the library into " + dest)
            util::rm_rf(tmp)
            return 1
        end
    end
    if reused || held != tmp is util::rm_rf(tmp) end

    ;; 5. manifest
    let h: hk::Hk = lib_manifest(dest)
    let lang: string = detect_lang(dest, h, hint_lang)
    let out_choice: string = if o.io_output != "" then o.io_output
                             else string_lower(util::or_default(hk::hk_get(h, "lib", "output", ""), "hlib"))

    ;; static-linking policy
    let offenders: string = build::static_offenders_in(dest)
    if offenders != "" is
        ui::warn(name + " uses `extern dynamic` — bit links libraries statically; these files will not link:")
        write(offenders)
    end

    ;; current symlink, before the build so tools can already see the sources
    if !util::libs_flat() is
        util::run("ln -sfn " + util::sq(version) + " " + util::sq(current_dir(name)))
    end

    ;; 6. build
    let mut artifact: string = ""
    let mut out_used: string = "source"
    if o.io_build && lang != "" is
        let built: string = dest + "/.bit/out/" + artifact_name(name, out_choice)
        if reused && file_exists(built) is
            artifact = built               ;; the same files were compiled before — no need to do it again
        else is
            artifact = build_installed(name, dest, lang, out_choice, o)
        end
        if artifact != "" is out_used = out_choice end
    end

    ;; 7. lock
    let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
    lock::lock_write(lock::global_lock_path(), lock::lock_set(gl, lock::Locked {
        lk_name: name, lk_version: version, lk_commit: commit, lk_url: url,
        lk_checksum: checksum::tag(sum), lk_lang: lang, lk_output: out_used, lk_at: util::now_iso(),
        lk_range: "", lk_tag: looks_like_tag(rev), lk_source: source, lk_dir: dir
    }))

    ui::ok(ui::bold(name) + " " + ui::dim("@ " + util::or_default(looks_like_tag(rev), util::short_hash(commit)) + "  " +
           project::lang_label(lang) + "  " + out_used + "  sha256:" + version))
    if reused is ui::note(name + ": the files are identical to the installed copy — kept it") end

    ;; 8. dependencies of the library itself
    if install_lib_deps(name, h, dest, o) != 0 is return 1 end
    return 0
end

;; One dependency of an installed library. 0 = fine, 1 = could not be installed.
fn install_one_lib_dep(owner: string, d: project::Dep, dest: string, o: InstallOpts) -> int is
    let kind: string = project::dep_kind(d)
    if project::dep_optional(d) is return 0 end
    if kind == "invalid" is
        ui::warn(owner + ": dependency '" + project::dep_name(d) + "' has no usable source — ignored (system libraries go in [system-dependencies])")
        return 0
    end
    if kind == "path" is
        ui::note(owner + ": path dependency '" + project::dep_name(d) + "' is only for local development — skipped")
        return 0
    end
    if project::is_registry_kind(kind) || project::is_builtin_kind(kind) is
        if bitpkg::is_packaged(dest) is
            ui::note(owner + ": '" + project::dep_name(d) + "' is already compiled into the .bit package — skipped")
            return 0
        end
        let v: string = install_registry(dest + "/.bit/libs", d, "", false, false, o.io_verbose)
        if v == "" is return 1 end
        return 0
    end
    let dspec: string = if kind == "git" then project::dep_arg(d) else project::dep_name(d)
    let mut drev: string = project::dep_rev(d)
    if project::dep_range(d) != "" is
        drev = resolve_range(dspec, project::dep_range(d))
        if drev == "" is
            ui::bad(owner + ": no version of " + project::dep_name(d) + " matches " + project::dep_range(d))
            return 1
        end
    end
    let dopts: InstallOpts = with_bit(with_origin(deeper(o), project::dep_name(d), project::dep_dir(d), if kind == "git" then "git" else "index"), project::dep_prebuilt(d))
    if install_lib(dspec, drev, dopts) != 0 is return 1 end
    return 0
end

fn install_lib_deps(name: string, h: hk::Hk, dest: string, o: InstallOpts) -> int is
    let dep_keys: [string] = hk::hk_keys(h, "dependencies")
    let mut failed: int = 0
    let mut i: int = 0
    ;; progress: drawn by the progress-bar library, only worth it for 2+ dependencies
    let mut pbar = pb::quick_bar(array_len(dep_keys), name + ": dependencies")
    let show_bar: bool = array_len(dep_keys) > 1
    while i < array_len(dep_keys) is
        if !string_contains(dep_keys[i], ".") is
            let d: project::Dep = project::parse_dep(dep_keys[i], hk::hk_get(h, "dependencies", dep_keys[i], ""), h, "dependencies")
            if show_bar is pbar.clear() end
            failed += install_one_lib_dep(name, d, dest, o)
        end
        i += 1
        pbar = pbar.inc(1)
        if show_bar is pbar.draw() end
    end
    if show_bar is
        if failed > 0 is
            pbar = pbar.abandon(name + ": " + to_string(failed) + " dependency install(s) failed")
        else is
            pbar = pbar.finish(name + ": dependencies installed")
        end
    end
    if failed > 0 is return 1 end
    return 0
end

;; ── Registry dependencies (pypi / crates / npm / jsr / vira / std / core) ────

;; Does an installed registry version satisfy what Bit.hk asks for?
fn spec_ok(version: string, spec: string) -> bool is
    let s: string = string_trim(spec)
    if s == "" || s == "*" || string_lower(s) == "newest" || string_lower(s) == "latest" is return true end
    if version == s is return true end
    let v: int = semver::parse(version)
    if v < 0 is return false end
    return semver::satisfies(v, semver::parse_range(s))
end

pub fn registry_dir(base: string, d: project::Dep) -> string is
    return base + "/" + project::dep_kind(d) + "/" + project::dep_name(d)
end

;; Makes sure a registry dependency is present in `base`/<source>/<name>/.
;;   * an installed copy that fits is kept (no network);
;;   * with a lock entry (`locked_version`) exactly that version is fetched, so builds repeat;
;;   * otherwise the newest version that satisfies the range.
;; Returns the exact version, "" on failure.
pub fn install_registry(base: string, d: project::Dep, locked_version: string, use_lock: bool, force: bool, verbose: bool) -> string is
    let kind: string = project::dep_kind(d)
    let dest: string = registry_dir(base, d)
    let spec: string = project::dep_range(d)
    let have: string = registry::installed_version(dest)
    if !force && have != "" && spec_ok(have, spec) is
        if !use_lock || locked_version == "" || locked_version == have is return have end
    end
    let mut want: string = string_slice(spec, 0, string_len(spec))
    if use_lock && locked_version != "" && spec_ok(locked_version, spec) is want = locked_version end
    if !force && net::offline() && have != "" is return have end
    return registry::install(kind, project::dep_package(d), want, dest, verbose)
end

;; ── Remove ───────────────────────────────────────────────────────────────────

pub fn remove_lib(name: string) -> int is
    if !util::valid_name(name) is
        ui::fail("invalid library name '" + name + "'")
        return 1
    end
    let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
    let known: bool = lock::lock_has(gl, name)
    let dir: string = lib_root(name)
    if !known && !dir_exists(dir) is
        ui::fail(name + " is not installed")
        return 1
    end
    bitpkg::close_all(dir)
    if dir_exists(dir) && !util::rm_rf(dir) is
        ui::fail("could not remove " + dir)
        return 1
    end
    lock::lock_write(lock::global_lock_path(), lock::lock_del(gl, name))
    ui::ok(name + " removed")
    return 0
end

;; ── Verify ───────────────────────────────────────────────────────────────────
;; Recomputes every installed library's checksum and compares with bit.lock.
;; Returns the number of problems.

pub fn verify_all(only: string) -> int is
    let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
    let n: int = lock::lock_len(gl)
    if n == 0 is
        ui::note("no libraries installed")
        return 0
    end
    let mut problems: int = 0
    let mut i: int = 0
    let mut pbar = pb::quick_bar(n, "verifying libraries")
    let show_bar: bool = only == "" && n > 1
    while i < n is
        let e: lock::Locked = lock::lock_at(gl, i)
        let name: string = lock::locked_name(e)
        if show_bar is pbar.clear() end
        if only == "" || only == name is
            let dir: string = lib_dir(name, lock::locked_id(e))
            if lock::locked_output(e) == "bit" is
                ;; a .bit package: the image is what is checksummed; make sure it is open too
                let img: string = bitpkg::image_path(name, lock::locked_id(e))
                if !file_exists(img) is
                    ui::bad(name + "  " + ui::red("missing") + " " + ui::dim(img))
                    problems += 1
                else if checksum::matches(lock::locked_checksum(e), checksum::file_sha256(img)) is
                    if bitpkg::ensure_open(name, lock::locked_id(e), false) is
                        ui::ok(name + "  " + ui::dim("@ " + lock::locked_version(e) + "  .bit checksum ok"))
                    else is
                        problems += 1
                    end
                else is
                    ui::bad(name + "  " + ui::red("CHECKSUM MISMATCH") + " " + ui::dim("(" + img + " modified or corrupted)"))
                    problems += 1
                end
            else if !dir_exists(dir) is
                ui::bad(name + "  " + ui::red("missing") + " " + ui::dim(dir))
                problems += 1
            else is
                let sum: string = checksum::dir_checksum(dir)
                if checksum::matches(lock::locked_checksum(e), sum) is
                    ui::ok(name + "  " + ui::dim("@ " + lock::locked_version(e) + "  checksum ok"))
                else is
                    ui::bad(name + "  " + ui::red("CHECKSUM MISMATCH") + " " + ui::dim("(modified or corrupted)"))
                    problems += 1
                end
            end
        end
        i += 1
        pbar = pbar.inc(1)
        if show_bar is pbar.draw() end
    end
    if show_bar is
        if problems > 0 is
            pbar = pbar.abandon(to_string(problems) + " problem(s) found")
        else is
            pbar = pbar.finish("all libraries verified")
        end
    end
    return problems
end

;; Deletes installed commits that are not the locked one, and stale temp clones.
pub fn clean_old() -> int is
    ;; project-local libraries keep one version in <cache>/libs/<name>/ — nothing old to remove
    if util::libs_flat() is return 0 end
    let gl: lock::Lock = lock::lock_read(lock::global_lock_path())
    let mut removed: int = 0
    let mut i: int = 0
    while i < lock::lock_len(gl) is
        let e: lock::Locked = lock::lock_at(gl, i)
        let name: string = lock::locked_name(e)
        let keep: string = lock::locked_id(e)
        let olds: string = util::capture("find " + util::sq(lib_root(name)) + " -mindepth 1 -maxdepth 1 -type d ! -name " + util::sq(keep) + " 2>/dev/null")
        if olds != "" is
            let lines: [string] = string_split(olds, "\n")
            let mut k: int = 0
            while k < array_len(lines) is
                if lines[k] != "" is
                    bitpkg::close(lines[k])
                    if util::rm_rf(lines[k]) is
                        ui::line(ui::dim("removed " + lines[k]))
                        removed += 1
                    end
                end
                k += 1
            end
        end
        ;; images of the versions just removed
        util::run("find " + util::sq(lib_root(name)) + " -mindepth 1 -maxdepth 1 -type f -name '*.bit' ! -name " + util::sq(keep + ".bit") + " -delete 2>/dev/null")
        i += 1
    end
    util::run("rm -rf " + util::sq(util::tmp_dir()) + "/* 2>/dev/null")
    return removed
end
