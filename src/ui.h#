fn color_on() -> bool is
    return env_get("NO_COLOR") == ""
end

fn paint(code: string, s: string) -> string is
    if !color_on() is return s end
    return "\x1b[" + code + "m" + s + "\x1b[0m"
end

pub fn bold(s: string)   -> string is return paint("1", s)  end
pub fn dim(s: string)    -> string is return paint("2", s)  end
pub fn red(s: string)    -> string is return paint("31", s) end
pub fn green(s: string)  -> string is return paint("32", s) end
pub fn yellow(s: string) -> string is return paint("33", s) end
pub fn blue(s: string)   -> string is return paint("34", s) end
pub fn magenta(s: string)-> string is return paint("35", s) end
pub fn cyan(s: string)   -> string is return paint("36", s) end

pub fn ok(msg: string)    is write("  " + green("✓") + "  " + msg) end
pub fn bad(msg: string)   is write("  " + red("✗") + "  " + msg) end
pub fn fail(msg: string)  is write("  " + red("error:") + " " + msg) end
pub fn warn(msg: string)  is write("  " + yellow("warning:") + " " + msg) end
pub fn note(msg: string)  is write("  " + dim(msg)) end
pub fn line(msg: string)  is write("  " + msg) end
pub fn blank()            is write("") end

pub fn hr(width: int) is
    write("  " + dim(string_repeat("─", width)))
end

pub fn heading(msg: string) is
    write("")
    write("  " + bold(msg))
    hr(50)
end

;; Coloured tag for a language, used in listings.
pub fn lang_tag(lang: string) -> string is
    if lang == "hsharp"       is return red("H#")            end
    if lang == "hackerlang"   is return magenta("Hacker Lang") end
    if lang == "hackerscript" is return cyan("HackerScript") end
    return dim(lang)
end

;; ── step labels: "<tag>  <name>" ──────────────────────────────────────────────
;; build steps are labelled `H#  bit`, `Hacker Lang  foo.hlib`, `before-build  gen.sh` ... — a known tag, two
;; spaces, then the name. The spinner / result lines show them as `H# › bit` (tag in colour, name plain), so the
;; gap between tag and name is one fixed, tidy separator instead of a doubled space.

fn known_tags() -> [string] is
    return ["H#", "Hacker Lang", "HackerScript", "before-build", "wasm-bindgen", "native", "jar"]
end

;; ["H#", "bit"] for "H#  bit"; ["", label] when the label carries no known tag.
pub fn split_tag(label: string) -> [string] is
    let tags: [string] = known_tags()
    let mut i: int = 0
    while i < array_len(tags) is
        let t: string = tags[i]
        if string_starts_with(label, t + "  ") is
            return [t, string_slice(label, string_len(t) + 2, string_len(label))]
        end
        i += 1
    end
    return ["", label]
end

;; The tag painted for a step line: bold, one colour per language / kind of step.
pub fn tag_paint(tag: string) -> string is
    if tag == ""             is return "" end
    if tag == "H#"           is return paint("1;31", tag) end
    if tag == "Hacker Lang"  is return paint("1;35", tag) end
    if tag == "HackerScript" is return paint("1;36", tag) end
    if tag == "native"       is return paint("1;33", tag) end
    return paint("1;34", tag)
end
