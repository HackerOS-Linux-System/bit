;; ── [features] ───────────────────────────────────────────────────────────────
;;
;;   [features]
;;   -> default => [fast]
;;   -> fast    => [dep:silver, simd]        other features, and `dep:<optional dependency>`
;;   -> simd    => []
;;
;;   [dependencies]
;;   -> silver
;;   --> optional => true                    built only when a feature switches it on
;;
;; Selecting them:   bit build --features fast,simd    -F fast -F simd    --all-features    --no-default-features
;;
;; How they reach the code — nothing in the project is ever rewritten:
;;   * H#:  `h# ... --features fast,simd` (see build::features_flag). The compiler switches `#[cfg(feature = "fast")]`
;;          code and `feature_enabled("fast")` / `enabled_features()` on while it parses.
;;   * every language:  BIT_FEATURES=fast,simd  (and BIT_FEATURE_DEPS) in the environment of compilers and hooks.
;;   * a dependency is built with ITS OWN default features, never with the list of the package that uses it
;;     (BIT_FEATURES_ROOT names the package the exported list belongs to).

;; Adds `name` to `set` unless it is already there.
fn add_unique(set: [string], name: string) -> [string] is
    if util::array_has(set, name) is return set end
    return array_push(set, name)
end

fn is_optional_dep(p: project::Project, name: string) -> bool is
    let all: [project::Dep] = project::deps_in(p, "dependencies")
    let mut i: int = 0
    while i < array_len(all) is
        if project::dep_name(all[i]) == name && project::dep_optional(all[i]) is return true end
        i += 1
    end
    return false
end

;; Result of the resolution.
pub struct Resolved is
    pub rs_features: [string]     ;; enabled features (transitively), in the order they were reached
    pub rs_deps:     [string]     ;; optional dependencies switched on
    pub rs_unknown:  [string]     ;; requested names that are neither a feature nor an optional dependency
end

pub fn resolve(p: project::Project, requested: [string], no_default: bool, all_features: bool) -> Resolved is
    let declared: [string] = project::feature_names(p)
    let mut queue: [string] = []
    let mut features: [string] = []
    let mut depset: [string] = []
    let mut unknown: [string] = []

    if all_features is
        let mut i: int = 0
        while i < array_len(declared) is
            if declared[i] != "default" is queue = array_push(queue, declared[i]) end
            i += 1
        end
        ;; every optional dependency too
        let ds: [project::Dep] = project::deps_in(p, "dependencies")
        let mut k: int = 0
        while k < array_len(ds) is
            if project::dep_optional(ds[k]) is depset = add_unique(depset, project::dep_name(ds[k])) end
            k += 1
        end
    else is
        let mut i: int = 0
        while i < array_len(requested) is
            queue = array_push(queue, requested[i])
            i += 1
        end
        if !no_default && util::array_has(declared, "default") is
            let d: [string] = project::feature_requires(p, "default")
            let mut k: int = 0
            while k < array_len(d) is
                queue = array_push(queue, d[k])
                k += 1
            end
        end
    end

    let mut head: int = 0
    let mut guard: int = 0
    while head < array_len(queue) && guard < 4096 is
        let name: string = queue[head]
        head += 1
        guard += 1
        if string_starts_with(name, "dep:") is
            depset = add_unique(depset, string_slice(name, 4, string_len(name)))
        else if util::array_has(declared, name) is
            if !util::array_has(features, name) is
                features = array_push(features, name)
                let req: [string] = project::feature_requires(p, name)
                let mut k: int = 0
                while k < array_len(req) is
                    queue = array_push(queue, req[k])
                    k += 1
                end
            end
        else if is_optional_dep(p, name) is
            depset = add_unique(depset, name)          ;; an optional dependency is also a feature of the same name
        else is
            unknown = add_unique(unknown, name)
        end
    end
    return Resolved { rs_features: features, rs_deps: depset, rs_unknown: unknown }
end

;; ── Validation ───────────────────────────────────────────────────────────────

;; names the H# compiler accepts: letters, digits, `-`, `_`
fn valid_name(n: string) -> bool is
    if string_len(n) == 0 is return false end
    let mut i: int = 0
    while i < string_len(n) is
        let b: int = byte_at(n, i)
        let ok: bool = (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 45 || b == 95
        if !ok is return false end
        i += 1
    end
    return true
end

;; Problems in the `[features]` table itself (a typo here would otherwise only show up as "unknown feature" much later).
pub fn validate(p: project::Project) -> [string] is
    let declared: [string] = project::feature_names(p)
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(declared) is
        let n: string = declared[i]
        if !valid_name(n) is
            out = array_push(out, "feature '" + n + "': names are letters, digits, '-' and '_'")
        end
        let req: [string] = project::feature_requires(p, n)
        let mut k: int = 0
        while k < array_len(req) is
            let r: string = req[k]
            if r == n is
                out = array_push(out, "feature '" + n + "' requires itself")
            else if string_starts_with(r, "dep:") is
                let dn: string = string_slice(r, 4, string_len(r))
                if !is_optional_dep(p, dn) is
                    out = array_push(out, "feature '" + n + "': '" + r + "' — '" + dn + "' is not an optional dependency (add `--> optional => true` under it in [dependencies])")
                end
            else if r == "default" is
                out = array_push(out, "feature '" + n + "' requires 'default' — 'default' is only a list of what is on when nothing is asked for")
            else if !util::array_has(declared, r) && !is_optional_dep(p, r) is
                out = array_push(out, "feature '" + n + "': unknown requirement '" + r + "' (a feature, or dep:<optional dependency>)")
            end
            k += 1
        end
        i += 1
    end
    return out
end

;; ── Entry point ──────────────────────────────────────────────────────────────

;; A file generated by older versions of bit (src/bit_features.h#): it duplicated what the compiler now does itself,
;; so it is deleted (only when it is recognisably bit's own).
fn remove_stale_module(p: project::Project) is
    let path: string = project::root_of(p) + "/" + project::src_dir(p) + "/bit_features.h#"
    if !file_exists(path) is return end
    if !string_starts_with(file_read(path), ";; generated by bit from [features]") is return end
    util::run("rm -f " + util::sq(path))
    ui::note("removed the generated src/bit_features.h# — features are now handled by the compiler: #[cfg(feature = \"x\")], feature_enabled(\"x\")")
end

;; Publishes a resolved list for package `p` (and only for it, see BIT_FEATURES_ROOT).
fn export_for(p: project::Project, features: [string], deps: [string]) is
    env_set("BIT_FEATURES", util::join(features, ","))
    env_set("BIT_FEATURE_DEPS", util::join(deps, ","))
    env_set("BIT_FEATURES_ROOT", project::root_of(p))
    env_set("HSHARP_FEATURES", "")          ;; the list reaches h# only through the explicit --features flag
end

fn has_hsharp(p: project::Project) -> bool is
    return util::array_has(project::langs(p), "hsharp")
end

;; Resolves the features, exports BIT_FEATURES / BIT_FEATURE_DEPS for the package and checks that the compiler can
;; honour them. Returns 1 (after printing why) when a requested feature does not exist, `[features]` is malformed
;; or the installed h# predates --features.
pub fn activate(p: project::Project, requested: [string], no_default: bool, all_features: bool, verbose: bool) -> int is
    if !project::is_loaded(p) is return 0 end
    remove_stale_module(p)
    let declared: [string] = project::feature_names(p)
    if array_len(declared) == 0 && array_len(requested) == 0 && !all_features is
        export_for(p, [], [])
        return 0
    end
    let problems: [string] = validate(p)
    if array_len(problems) > 0 is
        let mut q: int = 0
        while q < array_len(problems) is
            ui::fail("Bit.hk [features]: " + problems[q])
            q += 1
        end
        return 1
    end
    let r: Resolved = resolve(p, requested, no_default, all_features)
    if array_len(r.rs_unknown) > 0 is
        let mut i: int = 0
        while i < array_len(r.rs_unknown) is
            ui::fail("unknown feature '" + r.rs_unknown[i] + "'")
            i += 1
        end
        if array_len(declared) > 0 is ui::note("declared: " + util::join(declared, ", ")) else is ui::note("this project has no [features] in Bit.hk") end
        return 1
    end
    if array_len(r.rs_features) > 0 && has_hsharp(p) && build::tool_for("hsharp") != "" && !build::hsharp_supports_features() is
        ui::fail("the installed H# compiler does not know --features, so [features] cannot be applied to this H# project")
        ui::note("upgrade H# (`h# compile --help` must list --features)  — or build without features: bit build --no-default-features")
        return 1
    end
    export_for(p, r.rs_features, r.rs_deps)
    if verbose && (array_len(r.rs_features) > 0 || array_len(r.rs_deps) > 0) is
        ui::note("features: " + (if array_len(r.rs_features) > 0 then util::join(r.rs_features, ", ") else "-") +
                 (if array_len(r.rs_deps) > 0 then "   optional dependencies: " + util::join(r.rs_deps, ", ") else ""))
    end
    return 0
end

;; Around the build of a DEPENDENCY: its own default features are on, the caller's list is parked and restored by
;; `dep_leave` (the dependency is compiled once and cached, so it never depends on who asks for it).
pub fn dep_enter(dep: project::Project) -> [string] is
    let saved: [string] = [env_get("BIT_FEATURES"), env_get("BIT_FEATURE_DEPS"), env_get("BIT_FEATURES_ROOT"), env_get("HSHARP_FEATURES")]
    if !project::is_loaded(dep) is
        export_for(dep, [], [])
        return saved
    end
    let r: Resolved = resolve(dep, [], false, false)
    export_for(dep, if array_len(validate(dep)) == 0 then r.rs_features else [], if array_len(validate(dep)) == 0 then r.rs_deps else [])
    return saved
end

pub fn dep_leave(saved: [string]) is
    if array_len(saved) < 4 is return end
    env_set("BIT_FEATURES", saved[0])
    env_set("BIT_FEATURE_DEPS", saved[1])
    env_set("BIT_FEATURES_ROOT", saved[2])
    env_set("HSHARP_FEATURES", saved[3])
end

;; `bit features`
pub fn cmd_features(p: project::Project) -> int is
    if !project::is_loaded(p) is
        ui::fail("no Bit.hk here")
        return 1
    end
    let declared: [string] = project::feature_names(p)
    ui::blank()
    if array_len(declared) == 0 is
        ui::note("no [features] in Bit.hk. Example:")
        ui::note("  [features]")
        ui::note("  -> default => [fast]")
        ui::note("  -> fast    => [dep:silver]")
        ui::note("  [dependencies]")
        ui::note("  -> silver")
        ui::note("  --> optional => true")
        ui::blank()
        return 0
    end
    let problems: [string] = validate(p)
    if array_len(problems) > 0 is
        let mut q: int = 0
        while q < array_len(problems) is
            ui::fail(problems[q])
            q += 1
        end
        ui::blank()
    end
    let on: Resolved = resolve(p, [], false, false)
    ui::heading("Features  " + ui::dim("* = on by default"))
    let mut i: int = 0
    while i < array_len(declared) is
        let n: string = declared[i]
        let mark: string = if util::array_has(on.rs_features, n) then ui::green("*") else " "
        ui::line(mark + " " + ui::cyan(string_pad_right(n, 16)) + ui::dim(util::join(project::feature_requires(p, n), ", ")))
        i += 1
    end
    ui::blank()
    ui::note("select:  bit build --features a,b   (-F a -F b)    --all-features    --no-default-features")
    ui::note("in H# code:  #[cfg(feature = \"a\")]   feature_enabled(\"a\")   enabled_features()")
    ui::blank()
    return 0
end
