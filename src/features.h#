;; ── [features] ───────────────────────────────────────────────────────────────
;;
;;   [features]
;;   -> default => [fast]
;;   -> fast    => [dep:silver, simd]        other features, and `dep:<optional dependency>`
;;   -> simd    => []
;;
;;   [dependencies]
;;   -> silver
;;   --> optional => true                    built only when a feature switches it on
;;
;; Selecting them:   bit build --features fast,simd    --all-features    --no-default-features
;; What the code sees:
;;   * H#:  src/bit_features.h#  is generated  (feature_enabled("fast"), enabled_features())
;;   * every language:  BIT_FEATURES=fast,simd  in the environment of compilers and hooks

;; Adds `name` to `set` unless it is already there.
fn add_unique(set: [string], name: string) -> [string] is
    if util::array_has(set, name) is return set end
    return array_push(set, name)
end

fn is_optional_dep(p: project::Project, name: string) -> bool is
    let all: [project::Dep] = project::deps_in(p, "dependencies")
    let mut i: int = 0
    while i < array_len(all) is
        if project::dep_name(all[i]) == name && project::dep_optional(all[i]) is return true end
        i += 1
    end
    return false
end

;; Result of the resolution.
pub struct Resolved is
    pub rs_features: [string]     ;; enabled features (transitively), in the order they were reached
    pub rs_deps:     [string]     ;; optional dependencies switched on
    pub rs_unknown:  [string]     ;; requested names that are neither a feature nor an optional dependency
end

pub fn resolve(p: project::Project, requested: [string], no_default: bool, all_features: bool) -> Resolved is
    let declared: [string] = project::feature_names(p)
    let mut queue: [string] = []
    let mut features: [string] = []
    let mut depset: [string] = []
    let mut unknown: [string] = []

    if all_features is
        let mut i: int = 0
        while i < array_len(declared) is
            if declared[i] != "default" is queue = array_push(queue, declared[i]) end
            i += 1
        end
        ;; every optional dependency too
        let ds: [project::Dep] = project::deps_in(p, "dependencies")
        let mut k: int = 0
        while k < array_len(ds) is
            if project::dep_optional(ds[k]) is depset = add_unique(depset, project::dep_name(ds[k])) end
            k += 1
        end
    else is
        let mut i: int = 0
        while i < array_len(requested) is
            queue = array_push(queue, requested[i])
            i += 1
        end
        if !no_default && util::array_has(declared, "default") is
            let d: [string] = project::feature_requires(p, "default")
            let mut k: int = 0
            while k < array_len(d) is
                queue = array_push(queue, d[k])
                k += 1
            end
        end
    end

    let mut head: int = 0
    let mut guard: int = 0
    while head < array_len(queue) && guard < 4096 is
        let name: string = queue[head]
        head += 1
        guard += 1
        if string_starts_with(name, "dep:") is
            depset = add_unique(depset, string_slice(name, 4, string_len(name)))
        else if util::array_has(declared, name) is
            if !util::array_has(features, name) is
                features = array_push(features, name)
                let req: [string] = project::feature_requires(p, name)
                let mut k: int = 0
                while k < array_len(req) is
                    queue = array_push(queue, req[k])
                    k += 1
                end
            end
        else if is_optional_dep(p, name) is
            depset = add_unique(depset, name)          ;; an optional dependency is also a feature of the same name
        else is
            unknown = add_unique(unknown, name)
        end
    end
    return Resolved { rs_features: features, rs_deps: depset, rs_unknown: unknown }
end

;; ── The generated module ─────────────────────────────────────────────────────

fn quoted_list(items: [string]) -> string is
    let mut out: string = "["
    let mut i: int = 0
    while i < array_len(items) is
        if i > 0 is out = out + ", " end
        out = out + "\"" + items[i] + "\""
        i += 1
    end
    return out + "]"
end

fn module_text(features: [string]) -> string is
    let mut checks: string = "false"
    let mut i: int = 0
    while i < array_len(features) is
        if i == 0 is checks = "" else is checks = checks + " || " end
        checks = checks + "name == \"" + features[i] + "\""
        i += 1
    end
    return ";; generated by bit from [features] in Bit.hk — do not edit\n" +
           ";; (not committed: add it to .gitignore)\n\n" +
           "pub fn enabled_features() -> [string] is\n    return " + quoted_list(features) + "\nend\n\n" +
           "pub fn feature_enabled(name: string) -> bool is\n    return " + checks + "\nend\n"
end

fn write_module(p: project::Project, features: [string]) is
    let dir: string = project::root_of(p) + "/" + project::src_dir(p)
    if !dir_exists(dir) is return end
    let path: string = dir + "/bit_features.h#"
    let text: string = module_text(features)
    if file_exists(path) && file_read(path) == text is return end
    file_write(path, text)
end

;; ── Entry point ──────────────────────────────────────────────────────────────

;; Resolves the features, exports BIT_FEATURES / BIT_FEATURE_DEPS and writes the H# module.
;; Returns 1 (after printing why) when a requested feature does not exist.
pub fn activate(p: project::Project, requested: [string], no_default: bool, all_features: bool, verbose: bool) -> int is
    if !project::is_loaded(p) is return 0 end
    let declared: [string] = project::feature_names(p)
    if array_len(declared) == 0 && array_len(requested) == 0 && !all_features is
        env_set("BIT_FEATURES", "")
        env_set("BIT_FEATURE_DEPS", "")
        return 0
    end
    let r: Resolved = resolve(p, requested, no_default, all_features)
    if array_len(r.rs_unknown) > 0 is
        let mut i: int = 0
        while i < array_len(r.rs_unknown) is
            ui::fail("unknown feature '" + r.rs_unknown[i] + "'")
            i += 1
        end
        if array_len(declared) > 0 is ui::note("declared: " + util::join(declared, ", ")) else is ui::note("this project has no [features] in Bit.hk") end
        return 1
    end
    env_set("BIT_FEATURES", util::join(r.rs_features, ","))
    env_set("BIT_FEATURE_DEPS", util::join(r.rs_deps, ","))
    if array_len(declared) > 0 is write_module(p, r.rs_features) end
    if verbose && (array_len(r.rs_features) > 0 || array_len(r.rs_deps) > 0) is
        ui::note("features: " + (if array_len(r.rs_features) > 0 then util::join(r.rs_features, ", ") else "-") +
                 (if array_len(r.rs_deps) > 0 then "   optional dependencies: " + util::join(r.rs_deps, ", ") else ""))
    end
    return 0
end

;; `bit features`
pub fn cmd_features(p: project::Project) -> int is
    if !project::is_loaded(p) is
        ui::fail("no Bit.hk here")
        return 1
    end
    let declared: [string] = project::feature_names(p)
    ui::blank()
    if array_len(declared) == 0 is
        ui::note("no [features] in Bit.hk. Example:")
        ui::note("  [features]")
        ui::note("  -> default => [fast]")
        ui::note("  -> fast    => [dep:silver]")
        ui::note("  [dependencies]")
        ui::note("  -> silver")
        ui::note("  --> optional => true")
        ui::blank()
        return 0
    end
    let on: Resolved = resolve(p, [], false, false)
    ui::heading("Features  " + ui::dim("* = on by default"))
    let mut i: int = 0
    while i < array_len(declared) is
        let n: string = declared[i]
        let mark: string = if util::array_has(on.rs_features, n) then ui::green("*") else " "
        ui::line(mark + " " + ui::cyan(string_pad_right(n, 16)) + ui::dim(util::join(project::feature_requires(p, n), ", ")))
        i += 1
    end
    ui::blank()
    return 0
end
