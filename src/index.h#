mod util
mod ui
mod net
;; NOTE: no `use "std -> json"` here. Importing the std wrapper mangles its fns to
;; json_get_str / json_set_str / json_stringify_pretty …, which collide with the LLVM
;; builtins of the same names (self-recursion / wrong arity -> invalid IR). `json::get_str`,
;; `json::set_str` and `json::empty_object` resolve straight to those builtins instead.

pub struct LibEntry is
    pub ie_name:     string
    pub ie_target:   string
    pub ie_desc:     string
    pub ie_tags:     [string]
    pub ie_author:   string
    pub ie_lang:     string
    pub ie_rev:      string
    pub ie_checksum: string
    pub ie_dir:      string     ;; directory inside the repository ("" = the root)
end

pub fn e_name(e: LibEntry)     -> string   is return e.ie_name end
pub fn e_target(e: LibEntry)   -> string   is return e.ie_target end
pub fn e_desc(e: LibEntry)     -> string   is return e.ie_desc end
pub fn e_tags(e: LibEntry)     -> [string] is return e.ie_tags end
pub fn e_author(e: LibEntry)   -> string   is return e.ie_author end
pub fn e_lang(e: LibEntry)     -> string   is return e.ie_lang end
pub fn e_rev(e: LibEntry)      -> string   is return e.ie_rev end
pub fn e_checksum(e: LibEntry) -> string   is return e.ie_checksum end
pub fn e_dir(e: LibEntry)      -> string   is return e.ie_dir end

pub struct Index is
    pub ix_items: [LibEntry]
    pub ix_count: int
end

pub fn ix_len(ix: Index)          -> int      is return ix.ix_count end
pub fn ix_at(ix: Index, i: int)   -> LibEntry is return ix.ix_items[i] end

pub fn default_index_url() -> string is
    return "https://raw.githubusercontent.com/HackerOS-Linux-System/bit/main/index/repository.json"
end

pub fn index_url() -> string is
    let o: string = env_get("BIT_INDEX_URL")
    if o != "" is return o end
    return default_index_url()
end

fn cache_file() -> string is return util::cache_dir() + "/repository.json" end
fn extra_cache_file(n: int) -> string is
    return util::cache_dir() + "/repository-extra-" + to_string(n) + ".json"
end

;; Downloads `url` into `dest` (retrying). Returns true on success.
fn download(url: string, dest: string) -> bool is
    util::mkdir_p(util::dirname(dest))
    let tmp: string = dest + ".part"
    let limit: int = if net::timeout_s() > 0 then net::timeout_s() else 0
    let cmd: string = "curl -fsSL --connect-timeout 15" + (if limit > 0 then " --max-time " + to_string(limit) else "") +
                      " " + util::sq(url) + " -o " + util::sq(tmp)
    if net::run_retry(cmd) != 0 is
        util::run("rm -f " + util::sq(tmp))
        return false
    end
    ;; refuse an empty / HTML error page masquerading as an index
    let body: string = file_read(tmp)
    if string_len(body) < 2 || !string_contains(body, "libraries") is
        util::run("rm -f " + util::sq(tmp))
        return false
    end
    util::run("mv -f " + util::sq(tmp) + " " + util::sq(dest))
    return true
end

;; Fetches the main index (and extra ones). Returns 0 on success.
pub fn index_fetch() -> int is
    if net::offline() && env_get("BIT_INDEX_FILE") == "" is
        if file_exists(cache_file()) is
            ui::note("offline: using the cached library index")
            return 0
        end
        ui::fail("offline and no cached library index — run `bit update` once while online")
        return 1
    end
    let local: string = env_get("BIT_INDEX_FILE")
    if local != "" is
        if !file_exists(local) is
            ui::fail("BIT_INDEX_FILE does not exist: " + local)
            return 1
        end
        util::mkdir_p(util::cache_dir())
        util::run("cp -f " + util::sq(local) + " " + util::sq(cache_file()))
        return 0
    end

    if !download(index_url(), cache_file()) is
        ui::fail("could not download the library index from " + index_url())
        if file_exists(cache_file()) is ui::note("using the previously cached index") end
        return 1
    end

    let extras: [string] = util::csv_split(env_get("BIT_EXTRA_INDEXES"))
    let mut i: int = 0
    while i < array_len(extras) is
        if !download(extras[i], extra_cache_file(i)) is
            ui::warn("extra index unreachable: " + extras[i])
        end
        i += 1
    end
    return 0
end

;; Fetch when missing or older than 6 hours.
pub fn index_ensure() -> int is
    if env_get("BIT_INDEX_FILE") != "" is return index_fetch() end
    if net::offline() is return index_fetch() end
    if !file_exists(cache_file()) is return index_fetch() end
    let stale: string = util::capture("find " + util::sq(cache_file()) + " -mmin +360 2>/dev/null")
    if stale != "" is
        let rc: int = index_fetch()
        if rc != 0 && file_exists(cache_file()) is return 0 end
        return rc
    end
    return 0
end

fn guess_lang(tags: [string], explicit: string) -> string is
    if explicit != "" is return normalize_lang(explicit) end
    let mut i: int = 0
    while i < array_len(tags) is
        let t: string = string_lower(tags[i])
        if t == "h#" || t == "hsharp" || t == "h-sharp" is return "hsharp" end
        if t == "hacker-lang" || t == "hackerlang" || t == "hl" is return "hackerlang" end
        if t == "hackerscript" || t == "hcs" is return "hackerscript" end
        i += 1
    end
    return ""
end

;; Accepts every spelling users type: "h#", "H#", "hsharp", "H-Sharp", "hl", "hacker lang", "hs",
;; "HackerScript", "hacker-script", "Hacker Script", "hcs"… (case, spaces, dashes, quotes and brackets are ignored).
pub fn normalize_lang(raw: string) -> string is
    let mut t: string = string_lower(string_trim(raw))
    t = string_replace(string_replace(string_replace(t, " ", ""), "-", ""), "_", "")
    t = string_replace(string_replace(string_replace(t, "\"", ""), "[", ""), "]", "")
    if t == "h#" || t == "hsharp" || t == "hsh" || t == "hs#" is return "hsharp" end
    if t == "hl" || t == "hackerlang" || t == "hacklang" is return "hackerlang" end
    if t == "hs" || t == "hcs" || t == "hackerscript" || t == "hackerc" || t == "virus" is return "hackerscript" end
    return ""
end

;; The languages named by a `lang` value: one ("HackerScript"), a csv ("h#, HackerScript") or an
;; array (["h#", "HackerScript"]). Unknown words are skipped; the result has no duplicates.
pub fn parse_langs(raw: string) -> [string] is
    let mut out: [string] = []
    let mut t: string = string_trim(raw)
    if string_starts_with(t, "[") && string_ends_with(t, "]") is
        t = string_slice(t, 1, string_len(t) - 1)
    end
    let parts: [string] = string_split(t, ",")
    let mut i: int = 0
    while i < array_len(parts) is
        let l: string = normalize_lang(parts[i])
        if l != "" is
            let mut seen: bool = false
            let mut j: int = 0
            while j < array_len(out) is
                if out[j] == l is seen = true end
                j += 1
            end
            if !seen is out = array_push(out, l) end
        end
        i += 1
    end
    return out
end

;; std `json` on the compiled (AOT) backend reads *flat* objects only (no nested
;; values, no arrays). repository.json is `{ "libraries": [ {flat}, {flat}, … ] }`,
;; so all that is done by hand is cutting the text into one chunk per library
;; object; every field is then read with std `json::get_str`.
pub fn chop_objects(text: string) -> [string] is
    let n: int = string_len(text)
    let mut start: int = string_find(text, "\"libraries\"")
    if start < 0 is start = 0 end
    let mut out: [string] = []
    let mut depth: int = 0
    let mut in_str: bool = false
    let mut from: int = -1
    let mut seen_array: bool = false
    let mut i: int = start
    while i < n is
        let c: string = string_at(text, i)
        if in_str is
            if c == "\\" is
                i += 1
            else if c == "\"" is
                in_str = false
            end
        else if c == "\"" is
            in_str = true
        else if c == "[" is
            if !seen_array is seen_array = true end
        else if c == "{" is
            if depth == 0 is from = i end
            depth += 1
        else if c == "}" is
            depth -= 1
            if depth == 0 && from >= 0 is
                out = array_push(out, string_slice(text, from, i + 1))
                from = -1
            end
        end
        i += 1
    end
    return out
end

;; `"tags": ["a", "b"]` — arrays are outside what std json can read, so the
;; bracket contents are cut out and split on commas.
fn tags_of(obj: string) -> [string] is
    let k: int = string_find(obj, "\"tags\"")
    if k < 0 is return [] end
    let rest: string = string_slice(obj, k, string_len(obj))
    let open: int = string_find(rest, "[")
    let close: int = string_find(rest, "]")
    if open < 0 || close < open is return [] end
    let parts: [string] = util::csv_split(string_slice(rest, open + 1, close))
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(parts) is
        let mut t: string = string_trim(parts[i])
        if string_len(t) >= 2 && string_starts_with(t, "\"") && string_ends_with(t, "\"") is
            t = string_slice(t, 1, string_len(t) - 1)
        end
        if t != "" is out = array_push(out, t) end
        i += 1
    end
    return out
end

fn first_of(obj: string, k1: string, k2: string, k3: string) -> string is
    let a: string = json::get_str(obj, k1)
    if a != "" is return a end
    let b: string = json::get_str(obj, k2)
    if b != "" is return b end
    return json::get_str(obj, k3)
end

;; Where the library's repository is. An entry may say it as a url (`target` / `url` / `git`), as
;; `"github": "org/repo"` (also gitlab / codeberg / bitbucket), or as `"org"` + `"repo"` (+ `"host"`).
fn entry_target(o: string) -> string is
    let t: string = first_of(o, "target", "url", "git")
    if t != "" is return t end
    let forges: [string] = ["github", "gitlab", "codeberg", "bitbucket", "sourcehut"]
    let mut i: int = 0
    while i < array_len(forges) is
        let v: string = json::get_str(o, forges[i])
        if v != "" is return util::forge_url(forges[i], v) end
        i += 1
    end
    let org: string = first_of(o, "org", "organization", "owner")
    let repo: string = json::get_str(o, "repo")
    if org != "" && repo != "" is return util::forge_url(json::get_str(o, "host"), org + "/" + repo) end
    return ""
end

;; The library's directory inside the repository: `"dir"` / `"subdir"` / `"path"`, or `url#dir`.
fn entry_dir(o: string, target: string) -> string is
    let d: string = first_of(o, "dir", "subdir", "directory")
    if d != "" is return d end
    let hash: int = string_find(target, "#")
    if hash >= 0 is return string_slice(target, hash + 1, string_len(target)) end
    return ""
end

fn strip_fragment(target: string) -> string is
    let hash: int = string_find(target, "#")
    if hash < 0 is return target end
    return string_slice(target, 0, hash)
end

fn parse_entries(text: string) -> [LibEntry] is
    let items: [string] = chop_objects(text)
    let mut out: [LibEntry] = []
    let mut i: int = 0
    while i < array_len(items) is
        let o: string = items[i]
        let name: string = json::get_str(o, "name")
        let tags: [string] = tags_of(o)
        if name != "" is
            let target: string = entry_target(o)
            out = array_push(out, LibEntry {
                ie_name:     name,
                ie_target:   strip_fragment(target),
                ie_dir:      entry_dir(o, target),
                ie_desc:     json::get_str(o, "description"),
                ie_tags:     tags,
                ie_author:   json::get_str(o, "author"),
                ie_lang:     guess_lang(tags, json::get_str(o, "lang")),
                ie_rev:      json::get_str(o, "rev"),
                ie_checksum: json::get_str(o, "checksum")
            })
        end
        i += 1
    end
    return out
end

pub fn index_load() -> Index is
    index_ensure()
    let mut all: [LibEntry] = []
    if file_exists(cache_file()) is
        all = parse_entries(file_read(cache_file()))
    end
    ;; extra indexes: first hit of a name wins, so the main index always has priority
    let extras: [string] = util::csv_split(env_get("BIT_EXTRA_INDEXES"))
    let mut x: int = 0
    while x < array_len(extras) is
        if file_exists(extra_cache_file(x)) is
            let more: [LibEntry] = parse_entries(file_read(extra_cache_file(x)))
            let mut m: int = 0
            while m < array_len(more) is
                let mut dup: bool = false
                let mut k: int = 0
                while k < array_len(all) is
                    if all[k].ie_name == more[m].ie_name is dup = true end
                    k += 1
                end
                if !dup is all = array_push(all, more[m]) end
                m += 1
            end
        end
        x += 1
    end
    return Index { ix_items: all, ix_count: array_len(all) }
end

pub fn index_find(ix: Index, name: string) -> LibEntry is
    let want: string = string_lower(name)
    let mut i: int = 0
    while i < ix.ix_count is
        if string_lower(ix.ix_items[i].ie_name) == want is return ix.ix_items[i] end
        i += 1
    end
    return LibEntry { ie_name: "", ie_target: "", ie_desc: "", ie_tags: [], ie_author: "",
                      ie_lang: "", ie_rev: "", ie_checksum: "", ie_dir: "" }
end

fn entry_matches(e: LibEntry, q: string) -> bool is
    if q == "" || q == "all" is return true end
    let needle: string = string_lower(q)
    if string_contains(string_lower(e.ie_name), needle) is return true end
    if string_contains(string_lower(e.ie_desc), needle) is return true end
    if string_contains(string_lower(e.ie_author), needle) is return true end
    let mut i: int = 0
    while i < array_len(e.ie_tags) is
        if string_contains(string_lower(e.ie_tags[i]), needle) is return true end
        i += 1
    end
    return false
end

;; Matching entries; `lang` ("" = any) narrows to one language.
pub fn index_search(ix: Index, q: string, lang: string) -> [LibEntry] is
    let mut out: [LibEntry] = []
    let mut i: int = 0
    while i < ix.ix_count is
        let e: LibEntry = ix.ix_items[i]
        let lang_ok: bool = lang == "" || e.ie_lang == lang || e.ie_lang == ""
        if lang_ok && entry_matches(e, q) is out = array_push(out, e) end
        i += 1
    end
    return out
end
