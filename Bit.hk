[package]
-> name        => bit
-> version     => 0.0.1
-> description => Package manager for H#, Hacker Lang and HackerScript
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => Apache-2.0
-> lang        => h#

[layout]
-> src => src

[build]
-> link => static

[default-build]
-> profile => release

[dependencies]
-> progress-bar => newest
-> hk-parser => newest

[commands]
-> check
--> run => bit check
--> description => Type-check every module
-> site
--> run => cd website && npm ci && npm run build
--> description => Build the bit.io website (TypeScript) into website/dist
-> install-local
--> run => install -Dm755 cache/build/release/bit /usr/bin/bit
--> description => Install the release binary to /usr/bin

[hooks]
-> pre-build => echo "building bit (static)"
