;; The value after ";key:" in a table, "" when absent.
fn lookup(table: string, key: string) -> string is
    let needle: string = ";" + key + ":"
    let at: int = string_find(table, needle)
    if at < 0 is return "" end
    let from: int = at + string_len(needle)
    let rest: string = string_slice(table, from, string_len(table))
    let end_at: int = string_find(rest, ";")
    if end_at < 0 is return rest end
    return string_slice(rest, 0, end_at)
end

pub fn language_of(path: string) -> string is
    let ext: string = util::ext_of(path)
    if ext == "" is return "" end
    return lookup(ext_table(), ext)
end

fn hex_value(h: string) -> int is
    let digits: string = "0123456789ABCDEF"
    let mut v: int = 0
    let mut i: int = 0
    while i < string_len(h) is
        let d: int = string_find(digits, string_upper(util::ch(h, i)))
        if d < 0 is return 0 end
        v = v * 16 + d
        i += 1
    end
    return v
end

;; 0xRRGGBBAA for a language name; grey when unknown.
pub fn color_of(name: string) -> int is
    let hex: string = lookup(color_table(), name)
    if hex == "" is return util::rgb(143, 143, 163) end
    return hex_value(hex) * 256 + 255
end

;; GitHub's own swatches are white (hk) or dark grey (HackerScript): they get an outline in the bar.
pub fn needs_outline(name: string) -> bool is
    return name == "hk" || name == "HackerScript"
end

pub struct Share is
    pub name: string
    pub tenths: int       ;; share in tenths of a percent (532 = 53.2 %)
    pub weight: int
end

;; Languages by share of bytes, biggest first.
pub fn breakdown(t: model::Tree) -> [Share] is
    let mut names: [string] = []
    let mut sums: [int] = []
    let mut total: int = 0
    let mut i: int = 0
    while i < array_len(t.items) is
        let it: model::Item = t.items[i]
        i += 1
        if it.is_dir is continue end
        let lang: string = language_of(it.path)
        if lang == "" is continue end
        let mut at: int = -1
        let mut k: int = 0
        while k < array_len(names) is
            if names[k] == lang is at = k end
            k += 1
        end
        if at < 0 is
            names = array_push(names, util::own(lang))
            sums = array_push(sums, it.size)
        else is
            sums[at] = sums[at] + it.size
        end
        total += it.size
    end
    if total <= 0 is return [] end
    let mut a: [Share] = []
    let mut n: int = 0
    while n < array_len(names) is
        a = array_push(a, Share { name: names[n], tenths: (sums[n] * 1000) / total, weight: sums[n] })
        n += 1
    end
    ;; insertion sort, biggest first
    let mut x: int = 1
    while x < array_len(a) is
        let cur: Share = a[x]
        let mut j: int = x - 1
        while j >= 0 && a[j].weight < cur.weight is
            a[j + 1] = a[j]
            j -= 1
        end
        a[j + 1] = cur
        x += 1
    end
    return a
end

;; "53.2"
pub fn pct_str(tenths: int) -> string is
    return to_string(tenths / 10) + "." + to_string(tenths % 10)
end
