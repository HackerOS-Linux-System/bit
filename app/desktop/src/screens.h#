fn has_examples(s: state::St) -> bool is
    let mut i: int = 0
    while i < array_len(s.tree.items) is
        let it: model::Item = s.tree.items[i]
        if !it.is_dir && string_starts_with(it.path, "examples/") && it.size <= EXAMPLE_MAX is return true end
        i += 1
    end
    return false
end

;; Name for the shields.io badge: - and _ are doubled.
fn badge_name(name: string) -> string is
    return util::url_enc(string_replace(string_replace(name, "-", "--"), "_", "__"))
end

fn badge_panel(l: model::Lib) -> Element is
    let img: string = "https://img.shields.io/badge/bit-" + badge_name(l.name) + "-ec4899"
    let page: string = repo_url(l)
    let md: string = "[![bit](" + img + ")](" + page + ")"
    let html: string = "<a href=\"" + page + "\"><img src=\"" + img + "\" alt=\"bit\"></a>"
    let k: List_Element = List_Element_new()
    ui::add(k, ui::caption_el("A \"bit\" badge for the README of " + l.name + " (rendered by shields.io)."))
    ui::add(k, copy_row("Markdown", md, md))
    ui::add(k, copy_row("HTML", html, html))
    return ui::panel("Badge", ui::v_col(k, 8.0))
end

fn pin_panel(s: state::St, l: model::Lib) -> Element is
    let k: List_Element = List_Element_new()
    if l.rev == "" is
        ui::add(k, ui::pill("Not pinned", ui::c_warn()))
        ui::add(k, ui::caption_el("The index does not pin a tag or commit, so bit install takes the newest head of the default branch."))
    else is
        ui::add(k, ui::kv("Pinned rev", l.rev))
        if s.pin_res.state == state::ready() is
            let when: string = if s.pin_date != "" then "  ·  " + util::date_of(s.pin_date) else ""
            ui::add(k, ui::kv("Resolves to", util::cut_plain(s.pin_sha, 10) + when))
            if s.pin_moved is ui::add(k, ui::note("Moved: this tag/branch pointed somewhere else the last time bit.io looked.", ui::c_warn())) end
        else if s.pin_res.state == state::failed() is
            ui::add(k, ui::note(s.pin_res.err, ui::c_bad()))
        else is
            ui::add(k, ui::muted("Resolving the revision…"))
        end
    end
    if l.checksum != "" is
        ui::add(k, ui::caption_el("sha256 in the index (checked by bit verify)"))
        let c: Element = text(util::cut(l.checksum, 72))
        ui::set_size(c, 11.0)
        ui::set_w_fill(c)
        ui::add(k, c)
        if l.rev != "" is
            let label: string = if s.ver_state == 1 then "Verifying…" else "Verify checksum"
            ui::add(k, ui::btn(label, "verify", "", "shield"))
        end
        if s.ver_state == 1 is ui::add(k, ui::muted(s.ver_msg)) end
        if s.ver_state == 2 is ui::add(k, ui::note(s.ver_msg, ui::c_ok())) end
        if s.ver_state == 3 is ui::add(k, ui::note(s.ver_msg, ui::c_bad())) end
        if s.ver_state == 4 is ui::add(k, ui::note(s.ver_msg, ui::c_warn())) end
    end
    ui::add(k, ui::kv("Source", util::cut(l.target, 60)))
    return ui::panel("Pinned revision", ui::v_col(k, 6.0))
end

;; ── Overview ─────────────────────────────────────────────────────────────────
;; ONE scrolling page (README on the left, cards on the right): the wheel works anywhere below the tabs.

fn readme_column(s: state::St, l: model::Lib) -> Element is
    ensure_readme(s)
    let left: List_Element = List_Element_new()
    let head: List_Element = List_Element_new()
    let file: string = if s.rd_file != "" then "  ·  " + s.rd_file else ""
    let ht: Element = ui::lbl_size("README" + file, "", 15.0, true)
    ui::set_w_fill(ht)
    ui::add(head, ht)
    if s.rd_res.state == state::ready() && s.rd_text != "" && s.rd_md is
        let tl: string = if s.rd_raw then "Rendered" else "Raw"
        ui::add(head, ui::btn(tl, "rdraw", "ghost", ""))
    end
    let url: string = repo_url(l)
    if url != "" is ui::add(head, ui::icon_btn("external-link", "open:" + url)) end
    let hr: Element = ui::v_row(head, 8.0)
    ui::set_align(hr, 0, 1)
    ui::set_w_fill(hr)
    ui::add(left, hr)
    if s.rd_res.state == state::ready() is
        if s.rd_res.stale is ui::add(left, stale_note(s.rd_res)) end
        if s.rd_el != 0 is
            List_Element_push(left, s.rd_el)
            if s.rd_blocks > s.rd_limit && !s.rd_raw is
                ui::add(left, ui::btn("Show more", "rdmore", "primary", "chevron-down"))
            end
            if array_len(s.rd_links) > 0 is
                ui::add(left, rule())
                ui::add(left, ui::lbl_size("Links", "", 15.0, true))
                ui::add(left, ui::links_view(s.rd_links))
            end
        else is
            ui::add(left, ui::muted("This repository has no README."))
        end
    else is
        ui::add(left, res_note(s.rd_res, "README"))
    end
    let lcol: Element = ui::v_col(left, 12.0)
    ui::set_w_fill(lcol)
    return lcol
end

fn side_column(s: state::St, l: model::Lib) -> Element is
    let right: List_Element = List_Element_new()
    ui::add(right, install_panel(l))
    ui::add(right, repo_panel(s, l))
    ui::add(right, langs_panel(s))
    ui::add(right, manifest_panel(s, l))
    ui::add(right, pin_panel(s, l))
    if array_len(model::deps_of(s.mf, s.idx)) > 0 is ui::add(right, deps_panel(s)) end
    ui::add(right, used_panel(s))
    if array_len(hk::keys_of(s.mf, "commands")) > 0 is ui::add(right, commands_panel(s)) end
    if has_examples(s) is ui::add(right, examples_panel(s)) end
    ui::add(right, badge_panel(l))
    let rcol: Element = ui::v_col(right, 12.0)
    ui::set_w_px(rcol, SIDE_COL_W)
    return rcol
end

fn overview(s: state::St, l: model::Lib) -> Element is
    let both: List_Element = List_Element_new()
    ui::add(both, readme_column(s, l))
    ui::add(both, side_column(s, l))
    let r: Element = ui::v_row(both, 18.0)
    Style_set_ay(Element_get_st(r), 0)
    ui::set_w_fill(r)
    ui::set_pad(r, 4.0)
    let sc: Element = scrollable(r)
    Element_free(r)
    Element_set_id(sc, "ov")
    ui::set_w_fill(sc)
    ui::set_h_fill(sc)
    return sc
end

;; ── API tab ──────────────────────────────────────────────────────────────────

fn kind_color(kind: string) -> int is
    if kind == "fn" is return util::rgb(59, 130, 246) end
    if kind == "struct" is return util::rgb(168, 85, 247) end
    if kind == "enum" is return util::rgb(236, 72, 153) end
    return util::rgb(245, 158, 11)
end

fn api_match(it: apidoc::Item, q: string, kind: string) -> bool is
    if kind != "" && it.kind != kind is return false end
    if q == "" is return true end
    return util::contains_ci(it.name + " " + it.sig + " " + it.doc + " " + it.owner, q)
end

fn api_card(it: apidoc::Item) -> Element is
    let k: List_Element = List_Element_new()
    let head: List_Element = List_Element_new()
    ui::add(head, ui::pill(it.kind, kind_color(it.kind)))
    let nm: Element = ui::lbl_size(it.name, "", 15.0, true)
    ui::set_w_fill(nm)
    ui::set_no_wrap(nm)
    ui::add(head, nm)
    let at: string = it.file + ":" + to_string(it.line)
    ui::add(head, ui::btn("Source", "goto:" + at, "ghost", "file"))
    let hr: Element = ui::v_row(head, 8.0)
    ui::set_align(hr, 0, 1)
    ui::set_w_fill(hr)
    ui::add(k, hr)
    let sg: Element = text(util::cut(it.sig, 200))
    ui::set_size(sg, 12.0)
    ui::set_w_fill(sg)
    let sc: Element = container(sg)
    Element_free(sg)
    Element_set_class(sc, "code")
    ui::set_w_fill(sc)
    ui::add(k, sc)
    if it.doc != "" is
        let d: Element = ui::para(util::cut(it.doc, API_NOTE_DOC), 13.0)
        Element_set_class(d, "muted")
        ui::add(k, d)
    end
    if array_len(it.members) > 0 is
        let mut shown: string = ""
        let mut i: int = 0
        while i < array_len(it.members) && i < 14 is
            if i > 0 is shown = shown + "\n" end
            shown = shown + util::cut(it.members[i], 80)
            i += 1
        end
        if array_len(it.members) > 14 is shown = shown + "\n… " + to_string(array_len(it.members) - 14) + " more" end
        let mt: Element = text(shown)
        ui::set_size(mt, 12.0)
        Element_set_class(mt, "muted")
        ui::set_w_fill(mt)
        ui::add(k, mt)
    end
    let col: Element = ui::v_col(k, 6.0)
    ui::set_w_fill(col)
    let c: Element = container(col)
    Element_free(col)
    Element_set_class(c, "card")
    ui::set_pad(c, 12.0)
    ui::set_w_fill(c)
    return c
end

fn api_tab(s: state::St) -> Element is
    let k: List_Element = List_Element_new()
    let q: string = string_trim(s.api_q)
    let top: List_Element = List_Element_new()
    let inp: Element = text_input("Filter the API…", s.api_q)
    Element_set_id(inp, "apiq")
    Element_set_msg(inp, "apiq")
    ui::set_w_fill(inp)
    ui::add(top, inp)
    ui::add(k, ui::v_row(top, 8.0))
    let chips: List_Element = List_Element_new()
    ui::add(chips, chip("All", "apik:", s.api_kind == ""))
    ui::add(chips, chip("Functions", "apik:fn", s.api_kind == "fn"))
    ui::add(chips, chip("Structs", "apik:struct", s.api_kind == "struct"))
    ui::add(chips, chip("Enums", "apik:enum", s.api_kind == "enum"))
    ui::add(chips, chip("Constants", "apik:const", s.api_kind == "const"))
    ui::add(k, ui::v_row(chips, 8.0))

    if s.api_state == 1 is
        let total: int = array_len(s.api_files)
        let msg: string = if s.snap_res.state == state::loading() then "Downloading the sources…" else "Reading sources… " + to_string(s.api_pos) + " of " + to_string(total)
        ui::add(k, ui::muted(msg))
    end
    if s.api_state == 3 is
        let why: string = if s.snap_res.err != "" then ": " + s.snap_res.err else "."
        ui::add(k, ui::note("The API view reads the downloaded sources, and they are not available" + why, ui::c_warn()))
    end
    if s.api_state == 2 || s.api_state == 1 is
        let mut shown: int = 0
        let mut matched: int = 0
        let mut last_file: string = ""
        let body: List_Element = List_Element_new()
        let mut i: int = 0
        while i < array_len(s.api_items) is
            let it: apidoc::Item = s.api_items[i]
            i += 1
            if !api_match(it, q, s.api_kind) is continue end
            matched += 1
            if shown >= s.api_shown is continue end
            if it.file != last_file is
                last_file = util::own(it.file)
                let mh: Element = ui::lbl_size(apidoc::mod_name(it.file) + "  ·  " + it.file, "", 13.0, true)
                Element_set_class(mh, "muted")
                ui::add(body, mh)
            end
            ui::add(body, api_card(it))
            shown += 1
        end
        if s.api_state == 2 && matched == 0 is
            if array_len(s.api_items) == 0 is
                ui::add(k, ui::muted("No public functions, types or constants were found in this library's .h#, .hcs or .hl files."))
            else is
                ui::add(k, ui::muted("Nothing matches the filter."))
            end
        else if matched > 0 is
            ui::add(k, ui::caption_el(to_string(matched) + " " + plural(matched, "item", "items") + " from " + to_string(array_len(s.api_files)) + " source files"))
        end
        ui::add(k, ui::v_col(body, 10.0))
        if matched > shown is ui::add(k, ui::btn("Show more (" + to_string(matched - shown) + " left)", "apimore", "primary", "chevron-down")) end
    end
    let col: Element = ui::v_col(k, 12.0)
    ui::set_w_fill(col)
    ui::set_max_w(col, 980.0)
    ui::set_pad(col, 4.0)
    let sc: Element = scrollable(col)
    Element_free(col)
    Element_set_id(sc, "api")
    ui::set_w_fill(sc)
    ui::set_h_fill(sc)
    return sc
end

