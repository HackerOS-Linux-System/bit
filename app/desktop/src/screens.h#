fn res_note(r: state::Res, what: string) -> Element is
    if r.state == state::failed() is return ui::note(r.err, ui::c_bad()) end
    return ui::muted("Loading " + what + "…")
end

fn stale_note(r: state::Res) -> Element is
    let age: string = if r.age > 0 then ", " + util::age_str(r.age) else ""
    return ui::note("Saved copy (offline" + age + ").", ui::c_warn())
end

;; "label  snippet  [copy]" - the copy button puts the whole `payload` on the clipboard.
fn copy_row(label: string, shown: string, payload: string) -> Element is
    let r: List_Element = List_Element_new()
    if label != "" is
        let lb: Element = ui::muted(label)
        ui::set_w_px(lb, 66.0)
        ui::add(r, lb)
    end
    let t: Element = text(util::cut(shown, 70))
    ui::set_size(t, 13.0)
    ui::set_w_fill(t)
    ui::add(r, t)
    ui::add(r, ui::icon_btn("copy", "cp:" + payload))
    let row_el: Element = ui::v_row(r, 6.0)
    ui::set_align(row_el, 0, 1)
    let c: Element = container(row_el)
    Element_free(row_el)
    Element_set_class(c, "code")
    ui::set_pad_xy(c, 12.0, 6.0)
    ui::set_w_fill(c)
    return c
end

fn repo_url(l: model::Lib) -> string is
    let g: model::Gh = model::parse_github(l.target)
    if !g.ok is return model::safe_url(l.target) end
    return "https://github.com/" + g.owner + "/" + g.repo
end

