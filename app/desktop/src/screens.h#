fn settings(s: state::St) -> Element is
    let k: List_Element = List_Element_new()
    ui::add(k, ui::title("Settings"))
    ui::add(k, ui::muted("Everything here is stored only on this computer (" + store::config_dir() + ")."))

    let a: List_Element = List_Element_new()
    let themes: List_Str = List_Str_new()
    List_Str_push(themes, "system")
    List_Str_push(themes, "dark")
    List_Str_push(themes, "light")
    List_Str_push(themes, "nord")
    List_Str_push(themes, "dracula")
    List_Str_push(themes, "tokyo")
    List_Str_push(themes, "glass")
    let pick: Element = pick_list(themes, s.settings.theme)
    List_Str_free(themes)
    Element_set_msg(pick, "theme")
    Element_set_id(pick, "theme")
    ui::set_w_px(pick, 220.0)
    ui::add(a, pick)
    ui::add(a, ui::caption_el("\"system\" follows the desktop's light/dark setting (GNOME / KDE)."))
    ui::add(k, ui::panel("Appearance", ui::v_col(a, 8.0)))

    let g: List_Element = List_Element_new()
    ui::add(g, ui::muted("Without a token GitHub allows 60 requests per hour; with one, 5000. The token is only ever sent to api.github.com (README, Bit.hk and files come from raw.githubusercontent.com)."))
    let tok: Element = text_input("ghp_… or github_pat_…", s.token_draft)
    Element_set_id(tok, "token")
    Element_set_msg(tok, "token_input")
    if !s.token_shown is Element_set_secret(tok, true) end
    ui::set_w_fill(tok)
    ui::add(g, tok)
    ui::add(g, toggler("Show token", s.token_shown))
    let br: List_Element = List_Element_new()
    ui::add(br, ui::btn("Save", "token_save", "primary", "check"))
    ui::add(br, ui::btn("Test", "token_test", "", "wifi"))
    ui::add(br, ui::btn("Remove", "token_remove", "ghost", "trash"))
    ui::add(g, ui::v_row(br, 8.0))
    if s.settings.token != "" is ui::add(g, ui::note("A token is saved.", ui::c_ok())) end
    if s.rate_text != "" is ui::add(g, ui::kv("GitHub limit", s.rate_text)) end
    ui::add(k, ui::panel("GitHub access", ui::v_col(g, 8.0)))

    let d: List_Element = List_Element_new()
    ui::add(d, ui::kv("Index", to_string(array_len(s.idx.libs)) + " libraries" + (if s.idx.updated != "" then ", updated " + util::date_of(s.idx.updated) else "")))
    ui::add(d, ui::kv("Source", if s.idx_res.stale then (if s.idx_res.age >= 0 then "saved copy" else "shipped with the app") else "network, just now"))
    ui::add(d, ui::kv("Saved data", s.cache_text))
    ui::add(d, ui::btn("Clear saved data", "cache_clear", "", "trash"))
    ui::add(k, ui::panel("Data", ui::v_col(d, 8.0)))

    let ab: List_Element = List_Element_new()
    ui::add(ab, ui::kv("Version", "bit.io Desktop " + s.version))
    ui::add(ab, ui::caption_el("The desktop edition of bit.io: written in H#, the interface comes from the gui library (HackerScript) through hlib."))
    ui::add(ab, ui::btn("bit on GitHub", "open:https://github.com/HackerOS-Linux-System/bit", "", "external-link"))
    ui::add(k, ui::panel("About", ui::v_col(ab, 8.0)))

    let col: Element = ui::v_col(k, 16.0)
    ui::set_w_fill(col)
    ui::set_max_w(col, 760.0)
    ui::set_pad(col, PAGE_PAD)
    let sc: Element = scrollable(col)
    Element_free(col)
    Element_set_id(sc, "settings")
    ui::set_w_fill(sc)
    ui::set_h_fill(sc)
    return sc
end

;; ── Root ─────────────────────────────────────────────────────────────────────

pub fn build(s: state::St) -> Element is
    let body: Element = if s.screen == "docs" then docs(s) else if s.screen == "settings" then settings(s) else if s.screen == "lib" then library(s) else libraries(s)
    ui::set_w_fill(body)
    ui::set_h_fill(body)
    let main_col: List_Element = List_Element_new()
    ui::add(main_col, body)
    ui::add(main_col, status_bar(s))
    let mc: Element = ui::v_col(main_col, 0.0)
    ui::set_w_fill(mc)
    ui::set_h_fill(mc)
    let all: List_Element = List_Element_new()
    ui::add(all, sidebar(s))
    ui::add(all, mc)
    let root: Element = ui::v_row(all, 0.0)
    ui::set_w_fill(root)
    ui::set_h_fill(root)
    return root
end
