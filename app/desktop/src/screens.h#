fn lib_card(l: model::Lib) -> Element is
    let k: List_Element = List_Element_new()
    let head: List_Element = List_Element_new()
    let name: Element = ui::lbl_size(l.name, "", 17.0, true)
    ui::set_w_fill(name)
    ui::set_no_wrap(name)
    ui::add(head, name)
    ui::add(head, ui::lang_pill(l.lang, model::lang_label(l.lang)))
    let hr: Element = ui::v_row(head, 8.0)
    ui::set_align(hr, 0, 1)
    ui::set_w_fill(hr)
    ui::add(k, hr)
    let desc: string = if l.description == "" then "No description." else l.description
    let d: Element = ui::para(desc, 13.0)
    Element_set_class(d, "muted")
    ui::add(k, d)
    let grow: Element = space()
    ui::set_h_fill(grow)
    ui::add(k, grow)
    let foot: List_Element = List_Element_new()
    let mut t: int = 0
    while t < array_len(l.tags) && t < 3 is
        ui::add(foot, ui::pill(util::cut(l.tags[t], 18), util::rgb(130, 130, 150)))
        t += 1
    end
    let fs: Element = space()
    ui::set_w_fill(fs)
    ui::add(foot, fs)
    if l.author != "" is ui::add(foot, ui::caption_el(util::cut(l.author, 22))) end
    ui::add(k, ui::v_row(foot, 6.0))
    let col: Element = ui::v_col(k, 8.0)
    ui::set_pad(col, 14.0)
    ui::set_w_fill(col)
    ui::set_h_fill(col)
    let b: Element = button_with(col)
    Element_free(col)
    Element_set_msg(b, "lib:" + l.name)
    Element_set_class(b, "libcard")
    ui::set_w_fill(b)
    ui::set_h_px(b, CARD_H)
    ui::set_clip(b)
    return b
end

fn tag_picker(s: state::St) -> Element is
    let tags: [string] = model::all_tags(s.idx)
    let opts: List_Str = List_Str_new()
    List_Str_push(opts, "All tags")
    let mut i: int = 0
    while i < array_len(tags) && i < 60 is
        List_Str_push(opts, tags[i])
        i += 1
    end
    let sel: string = if s.tag == "" then "All tags" else s.tag
    let p: Element = pick_list(opts, sel)
    List_Str_free(opts)
    Element_set_msg(p, "tagpick")
    Element_set_id(p, "tagpick")
    ui::set_w_px(p, 180.0)
    return p
end

fn libraries(app: App, s: state::St) -> Element is
    let k: List_Element = List_Element_new()
    let found: [model::Lib] = model::filter(s.idx, s.query, s.lang, s.tag)
    let total: int = array_len(s.idx.libs)

    let head: List_Element = List_Element_new()
    ui::add(head, ui::title("Libraries"))
    let sub: string = if array_len(found) == total then to_string(total) + " in the index" else to_string(array_len(found)) + " of " + to_string(total)
    ui::add(head, ui::muted(sub))
    let grow: Element = space()
    ui::set_w_fill(grow)
    ui::add(head, grow)
    if s.idx_res.state == state::loading() is ui::add(head, ui::muted("updating…")) end
    ui::add(head, ui::icon_btn("refresh-cw", "refresh"))
    let hr: Element = ui::v_row(head, 12.0)
    ui::set_align(hr, 0, 1)
    ui::set_w_fill(hr)
    ui::add(k, hr)

    let search: Element = text_input("Search libraries, tags, authors…", s.query)
    Element_set_id(search, "search")
    Element_set_msg(search, "search")
    ui::set_w_fill(search)
    ui::add(k, search)

    let chips: List_Element = List_Element_new()
    ui::add(chips, chip("All languages", "lang:", s.lang == ""))
    let ids: [string] = model::lang_ids()
    let mut i: int = 0
    while i < array_len(ids) is
        ui::add(chips, chip(model::lang_label(ids[i]), "lang:" + ids[i], s.lang == ids[i]))
        i += 1
    end
    let chs: Element = ui::v_row(chips, 8.0)
    let fsp: Element = space()
    ui::set_w_fill(fsp)
    let both: List_Element = List_Element_new()
    ui::add(both, chs)
    ui::add(both, fsp)
    ui::add(both, tag_picker(s))
    let filt: Element = ui::v_row(both, 8.0)
    ui::set_align(filt, 0, 1)
    ui::set_w_fill(filt)
    ui::add(k, filt)

    if s.idx_res.state == state::failed() is
        ui::add(k, ui::note(s.idx_res.err, ui::c_bad()))
    end

    if array_len(found) == 0 is
        let e: List_Element = List_Element_new()
        let ic: Element = icon("search")
        ui::set_size(ic, 40.0)
        Element_set_class(ic, "muted")
        ui::add(e, ic)
        let h1: string = if total == 0 then "The index is empty" else "No library matches"
        let h2: string = if total == 0 then "Try refreshing once you are online." else "Try another search, language or tag."
        ui::add(e, ui::lbl_size(h1, "", 18.0, true))
        ui::add(e, ui::muted(h2))
        if s.query != "" || s.lang != "" || s.tag != "" is ui::add(e, ui::btn("Clear filters", "clear", "primary", "x")) end
        let ec: Element = ui::v_col(e, 8.0)
        ui::set_align(ec, 1, 1)
        ui::set_w_fill(ec)
        ui::set_h_fill(ec)
        ui::add(k, ec)
    else is
        let n: int = array_len(found)
        let v: [int] = vis(app, "libs_grid", n, CARD_W, CARD_H, GRID_GAP, 0)
        let cols: int = if v[2] > 0 then v[2] else 1
        let mut w0: int = v[0] - BUF_ROWS * cols
        if w0 < 0 is w0 = 0 end
        let mut w1: int = v[1] + BUF_ROWS * cols
        if w1 > n is w1 = n end
        s.gv_first = w0
        s.gv_last = w1
        let items: List_Element = List_Element_new()
        let mut c: int = w0
        while c < w1 is
            ui::add(items, lib_card(found[c]))
            c += 1
        end
        let grid: Element = virtual_grid(n, CARD_W, CARD_H, items)
        List_Element_free(items)
        Element_set_first(grid, w0)
        Element_set_id(grid, "libs_grid")
        Style_set_gap(Element_get_st(grid), GRID_GAP)
        ui::set_w_fill(grid)
        ui::set_h_fill(grid)
        ui::add(k, grid)
    end
    let col: Element = ui::v_col(k, 14.0)
    ui::set_pad(col, PAGE_PAD)
    ui::set_w_fill(col)
    ui::set_h_fill(col)
    return col
end

