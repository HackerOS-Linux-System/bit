fn repo_panel(s: state::St) -> Element is
    let k: List_Element = List_Element_new()
    if s.meta_res.state == state::ready() is
        let m: model::Meta = s.meta
        let r: List_Element = List_Element_new()
        ui::add(r, stat(util::count_str(m.stars), "stars"))
        ui::add(r, stat(util::count_str(m.forks), "forks"))
        ui::add(r, stat(util::count_str(m.issues), "issues"))
        ui::add(k, ui::v_row(r, 8.0))
        if m.license != "" is ui::add(k, ui::kv("License", m.license)) end
        if m.pushed != "" is ui::add(k, ui::kv("Last push", util::date_of(m.pushed))) end
        if m.archived is ui::add(k, ui::note("This repository is archived.", ui::c_warn())) end
        if s.meta_res.stale is ui::add(k, stale_note(s.meta_res)) end
    else is
        ui::add(k, res_note(s.meta_res, "repository stats"))
    end
    return ui::panel("Repository", ui::v_col(k, 8.0))
end

fn manifest_panel(s: state::St, l: model::Lib) -> Element is
    let k: List_Element = List_Element_new()
    if s.mf_res.state == state::ready() && s.mf_file != "" is
        let h: hk::Hk = s.mf
        let name: string = hk::get(h, "package", "name")
        let ver: string = hk::get(h, "package", "version")
        if name != "" is ui::add(k, ui::kv("Package", name + (if ver != "" then "  " + ver else ""))) end
        let lang: string = hk::get(h, "package", "lang")
        if lang != "" is ui::add(k, ui::kv("Language", lang)) end
        let lic: string = hk::get(h, "package", "license")
        if lic != "" is ui::add(k, ui::kv("License", lic)) end
        let authors: string = hk::get(h, "package", "authors")
        if authors != "" is ui::add(k, ui::kv("Authors", util::join(hk::list(authors), ", "))) end
        let notes: [model::Note] = model::compat_notes(l, h, s.idx)
        let mut i: int = 0
        while i < array_len(notes) is
            ui::add(k, ui::note((if notes[i].ok then "✓  " else "✗  ") + notes[i].text, if notes[i].ok then ui::c_ok() else ui::c_bad()))
            i += 1
        end
        if s.mf_res.stale is ui::add(k, stale_note(s.mf_res)) end
    else if s.mf_res.state == state::ready() is
        ui::add(k, ui::muted("This repository has no Bit.hk."))
    else is
        ui::add(k, res_note(s.mf_res, "Bit.hk"))
    end
    return ui::panel("Manifest" + (if s.mf_file != "" then "  ·  " + s.mf_file else ""), ui::v_col(k, 8.0))
end

fn deps_panel(s: state::St) -> Element is
    let deps: [model::Dep] = model::deps_of(s.mf, s.idx)
    let k: List_Element = List_Element_new()
    let mut i: int = 0
    while i < array_len(deps) is
        let d: model::Dep = deps[i]
        let r: List_Element = List_Element_new()
        let kind: string = if d.kind == "index" then "index" else if d.kind == "git" then "git" else if d.kind == "path" then "path" else "?"
        ui::add(r, ui::lbl_size(d.name, "", 13.0, true))
        let sp: Element = space()
        ui::set_w_fill(sp)
        ui::add(r, sp)
        ui::add(r, ui::caption_el(util::cut(if d.spec == "" then kind else d.spec, 24)))
        let line: Element = ui::v_row(r, 8.0)
        ui::set_w_fill(line)
        if d.kind == "index" is
            let b: Element = button_with(line)
            Element_free(line)
            Element_set_msg(b, "dep:" + d.name)
            Element_set_class(b, "row")
            ui::set_w_fill(b)
            ui::add(k, b)
        else is
            ui::add(k, line)
        end
        i += 1
    end
    return ui::panel("Dependencies  ·  " + to_string(array_len(deps)), ui::v_col(k, 2.0))
end

fn pin_panel(l: model::Lib) -> Element is
    let k: List_Element = List_Element_new()
    if l.rev != "" is ui::add(k, ui::kv("Pinned rev", l.rev)) end
    if l.checksum != "" is
        ui::add(k, ui::caption_el("sha256 (checked by `bit verify`)"))
        let c: Element = text(util::cut(l.checksum, 72))
        ui::set_size(c, 11.0)
        ui::set_w_fill(c)
        ui::add(k, c)
    end
    ui::add(k, ui::kv("Source", util::cut(l.target, 60)))
    return ui::panel("Index entry", ui::v_col(k, 6.0))
end

fn overview(s: state::St, l: model::Lib) -> Element is
    ensure_readme(s)
    let left: List_Element = List_Element_new()
    ui::add(left, ui::lbl_size("README" + (if s.rd_file != "" then "  ·  " + s.rd_file else ""), "", 15.0, true))
    if s.rd_res.state == state::ready() is
        if s.rd_res.stale is ui::add(left, stale_note(s.rd_res)) end
        if s.rd_el != 0 is
            List_Element_push(left, s.rd_el)
            if array_len(s.rd_links) > 0 is
                ui::add(left, rule())
                ui::add(left, ui::lbl_size("Links", "", 15.0, true))
                ui::add(left, ui::links_view(s.rd_links))
            end
        else is
            ui::add(left, ui::muted("This repository has no README."))
            let g: model::Gh = model::parse_github(l.target)
            if g.ok is ui::add(left, ui::btn("Open on GitHub", "open:" + l.target, "", "external-link")) end
        end
    else is
        ui::add(left, res_note(s.rd_res, "README"))
    end
    let lcol: Element = ui::v_col(left, 12.0)
    ui::set_pad(lcol, 4.0)
    ui::set_w_fill(lcol)
    let lsc: Element = scrollable(lcol)
    Element_free(lcol)
    Element_set_id(lsc, "ov_left")
    ui::set_w_fill(lsc)
    ui::set_h_fill(lsc)

    let right: List_Element = List_Element_new()
    ui::add(right, install_panel(l))
    ui::add(right, repo_panel(s))
    ui::add(right, manifest_panel(s, l))
    if array_len(model::deps_of(s.mf, s.idx)) > 0 is ui::add(right, deps_panel(s)) end
    ui::add(right, pin_panel(l))
    let rcol: Element = ui::v_col(right, 12.0)
    ui::set_w_fill(rcol)
    let rsc: Element = scrollable(rcol)
    Element_free(rcol)
    Element_set_id(rsc, "ov_right")
    ui::set_w_px(rsc, SIDE_COL_W)
    ui::set_h_fill(rsc)

    let both: List_Element = List_Element_new()
    ui::add(both, lsc)
    ui::add(both, rsc)
    let r: Element = ui::v_row(both, 18.0)
    ui::set_w_fill(r)
    ui::set_h_fill(r)
    return r
end

fn size_text(n: int) -> string is
    return util::bytes_str(n)
end

fn file_row(it: model::Item, shown: string) -> Element is
    let r: List_Element = List_Element_new()
    let ic: Element = icon(if it.is_dir then "folder" else "file")
    ui::set_size(ic, 16.0)
    ui::add(r, ic)
    let nm: Element = text(util::base(it.path))
    ui::set_size(nm, 13.0)
    ui::set_w_fill(nm)
    ui::set_no_wrap(nm)
    ui::add(r, nm)
    if !it.is_dir is ui::add(r, ui::caption_el(size_text(it.size))) end
    let line: Element = ui::v_row(r, 8.0)
    ui::set_align(line, 0, 1)
    ui::set_w_fill(line)
    let b: Element = button_with(line)
    Element_free(line)
    Element_set_msg(b, (if it.is_dir then "dir:" else "file:") + it.path)
    Element_set_class(b, if it.path == shown then "row_on" else "row")
    ui::set_w_fill(b)
    return b
end

fn source_list(s: state::St) -> Element is
    let k: List_Element = List_Element_new()
    let top: List_Element = List_Element_new()
    if s.dir != "" is ui::add(top, ui::icon_btn("arrow-up", "up")) end
    let path: Element = ui::lbl_size(if s.dir == "" then "/" else "/" + s.dir, "", 13.0, true)
    ui::set_w_fill(path)
    ui::set_no_wrap(path)
    ui::add(top, path)
    let tr: Element = ui::v_row(top, 6.0)
    ui::set_align(tr, 0, 1)
    ui::set_w_fill(tr)
    ui::add(k, tr)
    if s.tree_res.state == state::ready() is
        if s.tree.truncated is ui::add(k, ui::note("The repository is large: GitHub truncated the file list.", ui::c_warn())) end
        if s.tree_res.stale is ui::add(k, stale_note(s.tree_res)) end
        let items: [model::Item] = model::children(s.tree, s.dir)
        if array_len(items) == 0 is ui::add(k, ui::muted("This folder is empty.")) end
        let mut i: int = 0
        while i < array_len(items) is
            ui::add(k, file_row(items[i], s.file_path))
            i += 1
        end
    else is
        ui::add(k, res_note(s.tree_res, "file list"))
    end
    let col: Element = ui::v_col(k, 2.0)
    ui::set_w_fill(col)
    let sc: Element = scrollable(col)
    Element_free(col)
    Element_set_id(sc, "src_list")
    ui::set_w_px(sc, 320.0)
    ui::set_h_fill(sc)
    return sc
end

fn source_viewer(s: state::St, l: model::Lib) -> Element is
    ensure_file(s)
    let k: List_Element = List_Element_new()
    if s.file_path == "" is
        let ic: Element = icon("file")
        ui::set_size(ic, 36.0)
        Element_set_class(ic, "muted")
        ui::add(k, ic)
        ui::add(k, ui::muted("Pick a file to read it here."))
        let c: Element = ui::v_col(k, 8.0)
        ui::set_align(c, 1, 1)
        ui::set_w_fill(c)
        ui::set_h_fill(c)
        return c
    end
    let head: List_Element = List_Element_new()
    let p: Element = ui::lbl_size(s.file_path, "", 13.0, true)
    ui::set_w_fill(p)
    ui::set_no_wrap(p)
    ui::add(head, p)
    if s.file_res.state == state::ready() is
        ui::add(head, ui::caption_el(to_string(s.file_lines) + " lines"))
        ui::add(head, ui::icon_btn("copy", "copy:file"))
    end
    let g: model::Gh = model::parse_github(l.target)
    if g.ok is
        let url: string = "https://github.com/" + g.owner + "/" + g.repo + "/blob/" + state::eff_ref(s) + "/" + model::repo_path(g, s.file_path)
        ui::add(head, ui::icon_btn("external-link", "open:" + url))
    end
    let hr: Element = ui::v_row(head, 8.0)
    ui::set_align(hr, 0, 1)
    ui::set_w_fill(hr)
    ui::add(k, hr)
    if s.file_res.state == state::ready() is
        if s.file_note != "" is ui::add(k, ui::note(s.file_note, ui::c_warn())) end
        if s.file_lines > FILE_LINES is ui::add(k, ui::note("Showing the first " + to_string(FILE_LINES) + " of " + to_string(s.file_lines) + " lines.", ui::c_warn())) end
        if s.file_res.stale is ui::add(k, stale_note(s.file_res)) end
        List_Element_push(k, s.file_el)
    else is
        ui::add(k, res_note(s.file_res, "file"))
    end
    let col: Element = ui::v_col(k, 8.0)
    ui::set_w_fill(col)
    ui::set_h_fill(col)
    return col
end

fn source_tab(s: state::St, l: model::Lib) -> Element is
    let k: List_Element = List_Element_new()
    ui::add(k, source_list(s))
    ui::add(k, source_viewer(s, l))
    let r: Element = ui::v_row(k, 18.0)
    ui::set_w_fill(r)
    ui::set_h_fill(r)
    return r
end

fn release_card(s: state::St, r: model::Release, current: string) -> Element is
    let k: List_Element = List_Element_new()
    let head: List_Element = List_Element_new()
    ui::add(head, ui::lbl_size(r.tag, "", 16.0, true))
    if r.prerelease is ui::add(head, ui::pill("pre-release", ui::c_warn())) end
    if r.tag == current is ui::add(head, ui::pill("viewing", ui::c_ok())) end
    let sp: Element = space()
    ui::set_w_fill(sp)
    ui::add(head, sp)
    if r.date != "" is ui::add(head, ui::caption_el(util::date_of(r.date))) end
    let hr: Element = ui::v_row(head, 8.0)
    ui::set_align(hr, 0, 1)
    ui::set_w_fill(hr)
    ui::add(k, hr)
    if r.name != "" && r.name != r.tag is ui::add(k, ui::muted(r.name)) end
    if r.tag_only is ui::add(k, ui::caption_el("Tag only - no release was published.")) end
    let open: bool = util::has(s.rel_open, r.tag)
    if open && r.body != "" is
        List_Element_push(k, notes_for(s, r))
    end
    let mut a: int = 0
    while a < array_len(r.assets) && a < 8 is
        let asset: model::Asset = r.assets[a]
        let ar: List_Element = List_Element_new()
        let nm: Element = text(asset.name)
        ui::set_size(nm, 12.0)
        ui::set_w_fill(nm)
        ui::add(ar, nm)
        ui::add(ar, ui::caption_el(size_text(asset.size)))
        let line: Element = ui::v_row(ar, 8.0)
        ui::set_align(line, 0, 1)
        ui::set_w_fill(line)
        let b: Element = button_with(line)
        Element_free(line)
        Element_set_msg(b, "open:" + asset.url)
        Element_set_class(b, "row")
        ui::set_w_fill(b)
        ui::add(k, b)
        a += 1
    end
    let acts: List_Element = List_Element_new()
    if r.tag != current is ui::add(acts, ui::btn("View this version", "ver:" + r.tag, "primary", "")) end
    if r.body != "" is ui::add(acts, ui::btn(if open then "Hide notes" else "Release notes", "notes:" + r.tag, "", "")) end
    ui::add(acts, ui::btn("GitHub", "open:" + r.url, "ghost", "external-link"))
    ui::add(k, ui::v_row(acts, 8.0))
    let col: Element = ui::v_col(k, 8.0)
    ui::set_w_fill(col)
    let c: Element = container(col)
    Element_free(col)
    Element_set_class(c, "card")
    ui::set_w_fill(c)
    return c
end

fn versions_tab(s: state::St) -> Element is
    let k: List_Element = List_Element_new()
    if s.ref != "" is
        let r: List_Element = List_Element_new()
        ui::add(r, ui::note("Viewing version " + s.ref + ".", ui::c_warn()))
        ui::add(r, ui::btn("Back to default", "ver:", "", "arrow-left"))
        ui::add(k, ui::v_row(r, 10.0))
    end
    if s.rel_res.state == state::ready() is
        if s.rel_res.stale is ui::add(k, stale_note(s.rel_res)) end
        if array_len(s.rels) == 0 is ui::add(k, ui::muted("No releases or tags yet.")) end
        let cur: string = state::eff_ref(s)
        let mut i: int = 0
        while i < array_len(s.rels) is
            ui::add(k, release_card(s, s.rels[i], cur))
            i += 1
        end
    else is
        ui::add(k, res_note(s.rel_res, "releases"))
    end
    let col: Element = ui::v_col(k, 12.0)
    ui::set_w_fill(col)
    ui::set_max_w(col, 900.0)
    let sc: Element = scrollable(col)
    Element_free(col)
    Element_set_id(sc, "versions")
    ui::set_w_fill(sc)
    ui::set_h_fill(sc)
    return sc
end

fn library(s: state::St) -> Element is
    let l: model::Lib = state::current(s)
    let k: List_Element = List_Element_new()
    if l.name == "" is
        ui::add(k, ui::note("This library is not in the index (any more).", ui::c_bad()))
        ui::add(k, ui::btn("Browse the index", "back", "primary", "arrow-left"))
        let c: Element = ui::v_col(k, 12.0)
        ui::set_pad(c, PAGE_PAD)
        return c
    end
    let head: List_Element = List_Element_new()
    ui::add(head, ui::icon_btn("arrow-left", "back"))
    ui::add(head, ui::title(l.name))
    ui::add(head, ui::lang_pill(l.lang, model::lang_label(l.lang)))
    if s.ref != "" is ui::add(head, ui::pill("version " + s.ref, ui::c_warn())) end
    let sp: Element = space()
    ui::set_w_fill(sp)
    ui::add(head, sp)
    if s.meta_res.state == state::loading() || s.mf_res.state == state::loading() || s.rd_res.state == state::loading() is
        ui::add(head, ui::muted("loading…"))
    end
    ui::add(head, ui::btn("Copy install command", "copy:install", "", "copy"))
    let url: string = model::safe_url(l.target)
    if url != "" is ui::add(head, ui::btn("GitHub", "open:" + url, "primary", "external-link")) end
    ui::add(head, ui::icon_btn("refresh-cw", "refresh"))
    let hr: Element = ui::v_row(head, 10.0)
    ui::set_align(hr, 0, 1)
    ui::set_w_fill(hr)
    ui::add(k, hr)
    if l.description != "" is
        let d: Element = ui::para(l.description, 14.0)
        Element_set_class(d, "muted")
        ui::add(k, d)
    end
    let names: List_Str = List_Str_new()
    List_Str_push(names, "Overview")
    List_Str_push(names, "Source")
    List_Str_push(names, "Versions")
    let tb: Element = tabs(names, s.tab)
    List_Str_free(names)
    Element_set_msg(tb, "tab")
    Element_set_id(tb, "tabs")
    ui::add(k, tb)
    if s.tab == 0 is
        ui::add(k, overview(s, l))
    else if s.tab == 1 is
        ui::add(k, source_tab(s, l))
    else is
        ui::add(k, versions_tab(s))
    end
    let col: Element = ui::v_col(k, 12.0)
    ui::set_pad(col, PAGE_PAD)
    ui::set_w_fill(col)
    ui::set_h_fill(col)
    return col
end

