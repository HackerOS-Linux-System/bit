fn lib_card(l: model::Lib) -> Element is
    let k: List_Element = List_Element_new()
    let head: List_Element = List_Element_new()
    let name: Element = ui::lbl_size(l.name, "", 17.0, true)
    ui::set_w_fill(name)
    ui::set_no_wrap(name)
    ui::add(head, name)
    ui::add(head, ui::lang_pill(l.lang, model::lang_label(l.lang)))
    let hr: Element = ui::v_row(head, 8.0)
    ui::set_align(hr, 0, 1)
    ui::set_w_fill(hr)
    ui::add(k, hr)
    let d: Element = ui::para(if l.description == "" then "No description." else l.description, 13.0)
    Element_set_class(d, "muted")
    ui::add(k, d)
    let grow: Element = space()
    ui::set_h_fill(grow)
    ui::add(k, grow)
    let foot: List_Element = List_Element_new()
    let mut t: int = 0
    while t < array_len(l.tags) && t < 3 is
        ui::add(foot, ui::pill(util::cut(l.tags[t], 18), util::rgb(130, 130, 150)))
        t += 1
    end
    let fs: Element = space()
    ui::set_w_fill(fs)
    ui::add(foot, fs)
    if l.author != "" is ui::add(foot, ui::caption_el(util::cut(l.author, 22))) end
    ui::add(k, ui::v_row(foot, 6.0))
    let col: Element = ui::v_col(k, 8.0)
    ui::set_pad(col, 14.0)
    ui::set_w_fill(col)
    ui::set_h_fill(col)
    let b: Element = button_with(col)
    Element_free(col)
    Element_set_msg(b, "lib:" + l.name)
    Element_set_class(b, "libcard")
    ui::set_w_fill(b)
    ui::set_h_px(b, CARD_H)
    ui::set_clip(b)
    return b
end

fn libraries(s: state::St) -> Element is
    let k: List_Element = List_Element_new()
    let found: [model::Lib] = model::filter(s.idx, s.query, s.lang, s.tag)
    let total: int = array_len(s.idx.libs)

    let head: List_Element = List_Element_new()
    ui::add(head, ui::title("Libraries"))
    let sub: string = if array_len(found) == total then to_string(total) + " in the index" else to_string(array_len(found)) + " of " + to_string(total)
    ui::add(head, ui::muted(sub))
    let grow: Element = space()
    ui::set_w_fill(grow)
    ui::add(head, grow)
    if s.idx_res.state == state::loading() is ui::add(head, ui::muted("updating…")) end
    ui::add(head, ui::icon_btn("refresh-cw", "refresh"))
    let hr: Element = ui::v_row(head, 12.0)
    ui::set_align(hr, 0, 1)
    ui::set_w_fill(hr)
    ui::add(k, hr)

    let search: Element = text_input("Search libraries, tags, authors…", s.query)
    Element_set_id(search, "search")
    Element_set_msg(search, "search")
    ui::set_w_fill(search)
    ui::add(k, search)

    let chips: List_Element = List_Element_new()
    ui::add(chips, chip("All languages", "lang:", s.lang == ""))
    let ids: [string] = model::lang_ids()
    let mut i: int = 0
    while i < array_len(ids) is
        ui::add(chips, chip(model::lang_label(ids[i]), "lang:" + ids[i], s.lang == ids[i]))
        i += 1
    end
    let tags: [string] = model::all_tags(s.idx)
    if s.tag != "" is ui::add(chips, chip("tag: " + s.tag + "  ✕", "tag:", true)) end
    let mut t: int = 0
    while t < array_len(tags) && t < 14 is
        if tags[t] != s.tag is ui::add(chips, chip(tags[t], "tag:" + tags[t], false)) end
        t += 1
    end
    let cr: Element = ui::v_row(chips, 8.0)
    let cs: Element = scrollable_x(cr)
    Element_free(cr)
    Element_set_id(cs, "chips")
    ui::set_w_fill(cs)
    ui::add(k, cs)

    if s.idx_res.state == state::failed() is
        ui::add(k, ui::note(s.idx_res.err, ui::c_bad()))
    end

    if array_len(found) == 0 is
        let e: List_Element = List_Element_new()
        let ic: Element = icon("search")
        ui::set_size(ic, 40.0)
        Element_set_class(ic, "muted")
        ui::add(e, ic)
        ui::add(e, ui::lbl_size(if total == 0 then "The index is empty" else "No library matches", "", 18.0, true))
        ui::add(e, ui::muted(if total == 0 then "Try refreshing once you are online." else "Try another search, language or tag."))
        if s.query != "" || s.lang != "" || s.tag != "" is ui::add(e, ui::btn("Clear filters", "clear", "primary", "x")) end
        let ec: Element = ui::v_col(e, 8.0)
        ui::set_align(ec, 1, 1)
        ui::set_w_fill(ec)
        ui::set_h_fill(ec)
        ui::add(k, ec)
    else is
        let items: List_Element = List_Element_new()
        let mut n: int = 0
        while n < array_len(found) is
            ui::add(items, lib_card(found[n]))
            n += 1
        end
        let grid: Element = virtual_grid(array_len(found), CARD_W, CARD_H, items)
        List_Element_free(items)
        Element_set_id(grid, "libs_grid")
        Style_set_gap(Element_get_st(grid), 14.0)
        ui::set_w_fill(grid)
        ui::set_h_fill(grid)
        ui::add(k, grid)
    end
    let col: Element = ui::v_col(k, 14.0)
    ui::set_pad(col, PAGE_PAD)
    ui::set_w_fill(col)
    ui::set_h_fill(col)
    return col
end

