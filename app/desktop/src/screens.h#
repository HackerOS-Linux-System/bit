fn plural(n: int, one: string, many: string) -> string is
    if n == 1 is return one end
    return many
end

fn status_bar(s: state::St) -> Element is
    let k: List_Element = List_Element_new()
    let mut msg: string = ""
    if time_ms() < s.toast_until && s.toast != "" is
        msg = s.toast
    else if s.busy > 0 is
        msg = "Loading…  (" + to_string(s.busy) + " " + plural(s.busy, "request", "requests") + ")"
    else if s.idx_res.stale && s.idx_res.age >= 0 is
        msg = "Offline copy of the index · saved " + util::age_str(s.idx_res.age)
    else if s.idx_res.stale is
        msg = "Using the library list shipped with the app"
    else is
        msg = "Up to date"
    end
    ui::add(k, ui::caption_el(msg))
    let grow: Element = space()
    ui::set_w_fill(grow)
    ui::add(k, grow)
    ui::add(k, ui::caption_el("/  search     Esc  back     F5  refresh     PgUp PgDn  scroll"))
    let r: Element = ui::v_row(k, 10.0)
    let c: Element = container(r)
    Element_free(r)
    Element_set_class(c, "bar")
    ui::set_pad_xy(c, 16.0, 6.0)
    ui::set_w_fill(c)
    return c
end

