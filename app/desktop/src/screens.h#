const DOCS_MAX_W: f64 = 880.0
const NOTES_BLOCKS: int = 60
const README_BLOCKS: int = 500

;; ── Cached heavy elements ────────────────────────────────────────────────────

fn free_el(h: Element) is
    if h != 0 is Element_free(h) end
end

;; Drops every built README / file / docs / notes element (the theme changed: colours are baked in).
pub fn invalidate(s: state::St) is
    free_el(s.rd_el)
    s.rd_el = 0
    s.rd_has = false
    free_el(s.file_el)
    s.file_el = 0
    s.file_has = false
    free_el(s.docs_el)
    s.docs_el = 0
    s.docs_has = false
    let mut i: int = 0
    while i < array_len(s.rel_els) is
        free_el(s.rel_els[i])
        i += 1
    end
    s.rel_els = []
    s.rel_els_tag = []
end

fn ensure_readme(s: state::St) is
    if s.rd_res.state != state::ready() || s.rd_has is return end
    free_el(s.rd_el)
    s.rd_el = 0
    if s.rd_text == "" is
        s.rd_has = true
        return
    end
    if s.rd_md is
        let blocks: [markdown::Block] = markdown::parse(s.rd_text, README_BLOCKS)
        s.rd_el = ui::md_view(blocks, s.dark)
        s.rd_links = markdown::all_links(blocks)
    else is
        s.rd_el = ui::code_block(s.rd_text, "", s.dark)
        s.rd_links = []
    end
    s.rd_has = true
end

fn ensure_file(s: state::St) is
    if s.file_res.state != state::ready() || s.file_has is return end
    free_el(s.file_el)
    s.file_el = ui::file_view(s.file_text, util::ext_of(s.file_path), s.dark, FILE_LINES)
    s.file_lines = array_len(util::lines_of(s.file_text))
    s.file_has = true
end

fn ensure_docs(s: state::St) is
    if s.docs_has is return end
    let mut src: string = store::read_data("docs.md")
    if src == "" is
        src = "# bit docs\n\nThe docs file was not found next to the app. See https://github.com/HackerOS-Linux-System/bit for the documentation."
    end
    s.docs_el = ui::md_view(markdown::parse(src, README_BLOCKS), s.dark)
    s.docs_has = true
end

;; Release notes of one tag, built on first use.
fn notes_for(s: state::St, r: model::Release) -> Element is
    let mut i: int = 0
    while i < array_len(s.rel_els_tag) is
        if s.rel_els_tag[i] == r.tag is return s.rel_els[i] end
        i += 1
    end
    let el: Element = ui::md_view(markdown::parse(r.body, NOTES_BLOCKS), s.dark)
    s.rel_els = array_push(s.rel_els, el)
    s.rel_els_tag = array_push(s.rel_els_tag, util::own(r.tag))
    return el
end

