    let r: List_Element = List_Element_new()
    let ic_name: string = if it.is_dir then "folder" else "file"
    let ic: Element = icon(ic_name)
    ui::set_size(ic, 16.0)
    ui::add(r, ic)
    let nm: Element = text(label)
    ui::set_size(nm, 13.0)
    ui::set_w_fill(nm)
    ui::set_no_wrap(nm)
    ui::add(r, nm)
    if !it.is_dir is ui::add(r, ui::caption_el(util::bytes_str(it.size))) end
