    ui::add(a, ui::caption_el("\"system\" follows the desktop's light/dark setting (GNOME / KDE)."))
    ui::add(k, ui::panel("Appearance", ui::v_col(a, 8.0)))

    let g: List_Element = List_Element_new()
    ui::add(g, ui::muted("Without a token GitHub allows 60 requests per hour; with one, 5000. The token is only ever sent to api.github.com (README, Bit.hk and sources come from raw.githubusercontent.com and codeload.github.com)."))
