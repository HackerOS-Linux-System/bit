fn source_list(s: state::St) -> Element is
    let k: List_Element = List_Element_new()
    let f: Element = text_input("Filter files…", s.src_filter)
    Element_set_id(f, "srcf")
    Element_set_msg(f, "srcf")
    ui::set_w_fill(f)
    ui::add(k, f)
    let q: Element = text_input("Search in code…  (Enter)", s.src_query)
    Element_set_id(q, "srcq")
    Element_set_msg(q, "srcqin")
    Element_set_msg2(q, "srcsearch")
    ui::set_w_fill(q)
    ui::add(k, q)
    if s.snap_res.state == state::loading() is ui::add(k, ui::caption_el("Downloading the sources…")) end
    if s.snap_res.state == state::failed() && s.src_query != "" is
        ui::add(k, ui::caption_el("Code search needs the downloaded sources (offline?)."))
    end

    if s.src_mode == 1 is
        let r: List_Element = List_Element_new()
        let msg: string = to_string(array_len(s.src_hits)) + (if s.src_cut then "+" else "") + " " + plural(array_len(s.src_hits), "match", "matches")
        let mt: Element = ui::lbl_size(msg, "", 13.0, true)
        ui::set_w_fill(mt)
        ui::add(r, mt)
        ui::add(r, ui::btn("Clear", "srcclear", "ghost", "x"))
        let rr: Element = ui::v_row(r, 6.0)
        ui::set_align(rr, 0, 1)
        ui::set_w_fill(rr)
        ui::add(k, rr)
        let mut i: int = 0
        while i < array_len(s.src_hits) && i < SEARCH_ROWS is
            ui::add(k, hit_row(s.src_hits[i]))
            i += 1
        end
    else if s.tree_res.state == state::ready() is
        if s.tree.truncated is ui::add(k, ui::note("The repository is large: the file list was truncated.", ui::c_warn())) end
        if s.tree_res.stale is ui::add(k, stale_note(s.tree_res)) end
        if string_trim(s.src_filter) != "" is
            let mut shown: int = 0
            let mut i: int = 0
            while i < array_len(s.tree.items) && shown < FILTER_ROWS is
                let it: model::Item = s.tree.items[i]
                i += 1
                if it.is_dir || !util::contains_ci(it.path, s.src_filter) is continue end
                ui::add(k, file_row(it, s.file_path, it.path))
                shown += 1
            end
            if shown == 0 is ui::add(k, ui::muted("No file matches.")) end
        else is
            let top: List_Element = List_Element_new()
            if s.dir != "" is ui::add(top, ui::icon_btn("arrow-up", "up")) end
            let shown_dir: string = if s.dir == "" then "/" else "/" + s.dir
            let path: Element = ui::lbl_size(shown_dir, "", 13.0, true)
            ui::set_w_fill(path)
            ui::set_no_wrap(path)
            ui::add(top, path)
            let tr: Element = ui::v_row(top, 6.0)
            ui::set_align(tr, 0, 1)
            ui::set_w_fill(tr)
            ui::add(k, tr)
            let items: [model::Item] = model::children(s.tree, s.dir)
            if array_len(items) == 0 is ui::add(k, ui::muted("This folder is empty.")) end
            let mut i: int = 0
            while i < array_len(items) is
                ui::add(k, file_row(items[i], s.file_path, util::base(items[i].path)))
                i += 1
            end
        end
    else is
        ui::add(k, res_note(s.tree_res, "file list"))
    end
    let col: Element = ui::v_col(k, 4.0)
    ui::set_w_fill(col)
    let sc: Element = scrollable(col)
    Element_free(col)
    Element_set_id(sc, "src_list")
    ui::set_w_px(sc, 330.0)
    ui::set_h_fill(sc)
    return sc
end

fn source_viewer(app: App, s: state::St, l: model::Lib) -> Element is
    ensure_file(s)
    let k: List_Element = List_Element_new()
    if s.file_path == "" is
        let ic: Element = icon("file")
        ui::set_size(ic, 36.0)
        Element_set_class(ic, "muted")
        ui::add(k, ic)
        ui::add(k, ui::muted("Pick a file to read it here."))
        let c: Element = ui::v_col(k, 8.0)
        ui::set_align(c, 1, 1)
        ui::set_w_fill(c)
        ui::set_h_fill(c)
        return c
    end
    let head: List_Element = List_Element_new()
    let p: Element = ui::lbl_size(s.file_path, "", 13.0, true)
    ui::set_w_fill(p)
    ui::set_no_wrap(p)
    ui::add(head, p)
    if s.file_res.state == state::ready() && s.file_text != "" is
        ui::add(head, ui::caption_el(to_string(s.file_lines) + " lines"))
        let ext: string = util::ext_of(s.file_path)
        if ext == "md" || ext == "markdown" is
            let tl: string = if s.file_md then "Source" else "Preview"
            ui::add(head, ui::btn(tl, "mdtoggle", "ghost", ""))
        end
        ui::add(head, ui::icon_btn("copy", "copy:file"))
    end
    let g: model::Gh = model::parse_github(l.target)
    if g.ok is
        let url: string = "https://github.com/" + g.owner + "/" + g.repo + "/blob/" + state::eff_ref(s) + "/" + model::repo_path(g, s.file_path)
        ui::add(head, ui::icon_btn("external-link", "open:" + url))
    end
    let hr: Element = ui::v_row(head, 8.0)
    ui::set_align(hr, 0, 1)
    ui::set_w_fill(hr)
    ui::add(k, hr)
    if s.file_res.state == state::ready() is
        if s.file_note != "" is ui::add(k, ui::note(s.file_note, ui::c_warn())) end
        if s.file_lines > FILE_LINES && !s.file_md is
            ui::add(k, ui::note("Showing the first " + to_string(FILE_LINES) + " of " + to_string(s.file_lines) + " lines.", ui::c_warn()))
        end
        if s.file_res.stale is ui::add(k, stale_note(s.file_res)) end
        if s.file_has && s.file_md is
            List_Element_push(k, s.file_el)
        else if s.file_has is
            let n: int = array_len(s.fv_tokens)
            let v: [int] = vis(app, "file_view", n, 0.0, LINE_H, 0.0, 1)
            let mut w0: int = v[0] - BUF_LINES
            if w0 < 0 is w0 = 0 end
            let mut w1: int = v[1] + BUF_LINES
            if w1 > n is w1 = n end
            s.fv_first = w0
            s.fv_last = w1
            ui::add(k, ui::file_rows(s.fv_tokens, w0, w1, s.dark))
        end
    else is
        ui::add(k, res_note(s.file_res, "file"))
    end
    let col: Element = ui::v_col(k, 8.0)
    ui::set_w_fill(col)
    ui::set_h_fill(col)
    return col
end

