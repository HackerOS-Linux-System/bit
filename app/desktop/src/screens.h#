pub fn build(app: App, s: state::St) -> Element is
    let body: Element = if s.screen == "docs" then docs(s) else if s.screen == "settings" then settings(s) else if s.screen == "lib" then library(app, s) else libraries(app, s)
    ui::set_w_fill(body)
    ui::set_h_fill(body)
    let main_col: List_Element = List_Element_new()
    ui::add(main_col, body)
    ui::add(main_col, status_bar(s))
    let mc: Element = ui::v_col(main_col, 0.0)
    ui::set_w_fill(mc)
    ui::set_h_fill(mc)
    let all: List_Element = List_Element_new()
    ui::add(all, sidebar(s))
    ui::add(all, mc)
    let root: Element = ui::v_row(all, 0.0)
    ui::set_w_fill(root)
    ui::set_h_fill(root)
    return root
end
