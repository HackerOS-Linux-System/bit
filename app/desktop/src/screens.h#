;; ── Versions ─────────────────────────────────────────────────────────────────

fn diff_block(d: diff::Diff) -> Element is
    let k: List_Element = List_Element_new()
    let mut i: int = 0
    while i < array_len(d.summary) is
        ui::add(k, ui::note(d.summary[i], ui::c_warn()))
        i += 1
    end
    if d.too_big is
        ui::add(k, ui::muted("The manifests are too large to compare here."))
    else if d.same is
        ui::add(k, ui::muted("Bit.hk is identical in both versions."))
    else is
        let lines: List_Element = List_Element_new()
        let mut n: int = 0
        while n < array_len(d.texts) && n < 80 is
            let kind: string = d.kinds[n]
            let t: Element = text(kind + " " + util::cut(d.texts[n], 100))
            ui::set_size(t, 12.0)
            if kind == "+" is ui::set_fg(t, ui::c_ok()) end
            if kind == "-" is ui::set_fg(t, ui::c_bad()) end
            if kind == "…" is Element_set_class(t, "muted") end
            ui::add(lines, t)
            n += 1
        end
        let lc: Element = ui::v_col(lines, 1.0)
        let box: Element = container(lc)
        Element_free(lc)
        Element_set_class(box, "code")
        ui::set_w_fill(box)
        ui::add(k, box)
    end
    return ui::v_col(k, 6.0)
end

fn release_card(s: state::St, r: model::Release, current: string, l: model::Lib, latest: string) -> Element is
    let k: List_Element = List_Element_new()
    let head: List_Element = List_Element_new()
    ui::add(head, ui::lbl_size(r.tag, "", 16.0, true))
    if r.tag == latest is ui::add(head, ui::pill("Latest", ui::c_ok())) end
    if l.rev != "" && r.tag == l.rev is ui::add(head, ui::pill("Pinned in the index", util::rgb(139, 92, 246))) end
    if r.prerelease is ui::add(head, ui::pill("pre-release", ui::c_warn())) end
    if r.tag == current is ui::add(head, ui::pill("viewing", ui::c_ok())) end
    let sp: Element = space()
    ui::set_w_fill(sp)
    ui::add(head, sp)
    if r.date != "" is ui::add(head, ui::caption_el(util::date_of(r.date))) end
    let hr: Element = ui::v_row(head, 8.0)
    ui::set_align(hr, 0, 1)
    ui::set_w_fill(hr)
    ui::add(k, hr)
    if r.name != "" && r.name != r.tag is ui::add(k, ui::muted(r.name)) end
    if r.tag_only is ui::add(k, ui::caption_el("Tag only - no release was published.")) end
    let open: bool = util::has(s.rel_open, r.tag)
    if open && r.body != "" is
        List_Element_push(k, notes_for(s, r))
    end
    let mut a: int = 0
    while a < array_len(r.assets) && a < 8 is
        let asset: model::Asset = r.assets[a]
        let ar: List_Element = List_Element_new()
        let nm: Element = text(asset.name)
        ui::set_size(nm, 12.0)
        ui::set_w_fill(nm)
        ui::add(ar, nm)
        ui::add(ar, ui::caption_el(util::bytes_str(asset.size)))
        let line: Element = ui::v_row(ar, 8.0)
        ui::set_align(line, 0, 1)
        ui::set_w_fill(line)
        let b: Element = button_with(line)
        Element_free(line)
        Element_set_msg(b, "open:" + asset.url)
        Element_set_class(b, "row")
        ui::set_w_fill(b)
        ui::add(k, b)
        a += 1
    end
    let prev: string = state::prev_tag(s, r.tag)
    let diff_on: bool = util::has(s.diff_open, r.tag)
    if diff_on && prev != "" is
        if load::has_mf(s, r.tag) && load::has_mf(s, prev) is
            ui::add(k, diff_block(load::diff_for(s, r.tag, prev)))
        else is
            ui::add(k, ui::muted("Reading Bit.hk of both versions…"))
        end
    end
    let acts: List_Element = List_Element_new()
    if r.tag != current is ui::add(acts, ui::btn("View this version", "ver:" + r.tag, "primary", "")) end
    if r.body != "" is
        let nl: string = if open then "Hide notes" else "Release notes"
        ui::add(acts, ui::btn(nl, "notes:" + r.tag, "", ""))
    end
    if prev != "" is
        let dl: string = if diff_on then "Hide Bit.hk changes" else "Bit.hk changes"
        ui::add(acts, ui::btn(dl, "diff:" + r.tag, "", "git-compare"))
    end
    ui::add(k, ui::v_row(acts, 8.0))
    let acts2: List_Element = List_Element_new()
    ui::add(acts2, ui::btn("Copy Bit.hk line", "cp:-> " + l.name + " => rev " + r.tag, "ghost", "copy"))
    let g: model::Gh = model::parse_github(l.target)
    if g.ok && prev != "" is
        ui::add(acts2, ui::btn("Compare", "open:https://github.com/" + g.owner + "/" + g.repo + "/compare/" + prev + "..." + r.tag, "ghost", "external-link"))
    end
    ui::add(acts2, ui::btn("GitHub", "open:" + r.url, "ghost", "external-link"))
    ui::add(k, ui::v_row(acts2, 8.0))
    let col: Element = ui::v_col(k, 8.0)
    ui::set_w_fill(col)
    let c: Element = container(col)
    Element_free(col)
    Element_set_class(c, "card")
    ui::set_pad(c, 14.0)
    ui::set_w_fill(c)
    return c
end

fn version_picker(s: state::St) -> Element is
    let opts: List_Str = List_Str_new()
    List_Str_push(opts, "(default)")
    let mut i: int = 0
    while i < array_len(s.rels) && i < 60 is
        List_Str_push(opts, s.rels[i].tag)
        i += 1
    end
    let sel: string = if s.ref == "" then "(default)" else s.ref
    let p: Element = pick_list(opts, sel)
    List_Str_free(opts)
    Element_set_msg(p, "pickver")
    Element_set_id(p, "pickver")
    ui::set_w_px(p, 220.0)
    return p
end

fn versions_tab(s: state::St, l: model::Lib) -> Element is
    let k: List_Element = List_Element_new()
    if s.rel_res.state == state::ready() && array_len(s.rels) > 0 is
        let top: List_Element = List_Element_new()
        ui::add(top, ui::muted("Viewing"))
        ui::add(top, version_picker(s))
        if s.ref != "" is ui::add(top, ui::btn("Back to default", "ver:", "ghost", "arrow-left")) end
        let tr: Element = ui::v_row(top, 10.0)
        ui::set_align(tr, 0, 1)
        ui::add(k, tr)
    else if s.ref != "" is
        let r: List_Element = List_Element_new()
        ui::add(r, ui::note("Viewing version " + s.ref + ".", ui::c_warn()))
        ui::add(r, ui::btn("Back to default", "ver:", "ghost", "arrow-left"))
        ui::add(k, ui::v_row(r, 10.0))
    end
    if s.rel_res.state == state::ready() is
        if s.rel_res.stale is ui::add(k, stale_note(s.rel_res)) end
        if array_len(s.rels) == 0 is ui::add(k, ui::muted("No releases or tags yet.")) end
        let cur: string = state::eff_ref(s)
        let latest: string = state::latest_tag(s)
        let mut i: int = 0
        while i < array_len(s.rels) is
            ui::add(k, release_card(s, s.rels[i], cur, l, latest))
            i += 1
        end
    else is
        ui::add(k, res_note(s.rel_res, "releases"))
    end
    let col: Element = ui::v_col(k, 12.0)
    ui::set_w_fill(col)
    ui::set_max_w(col, 900.0)
    ui::set_pad(col, 4.0)
    let sc: Element = scrollable(col)
    Element_free(col)
    Element_set_id(sc, "versions")
    ui::set_w_fill(sc)
    ui::set_h_fill(sc)
    return sc
end

