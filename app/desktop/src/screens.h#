;; ── Screens ──────────────────────────────────────────────────────────────────
;; `build` turns the state into one Element tree; main.h# calls it again after every state change.
;;
;; What keeps it fast: long lists (the library grid, a source file) are virtual lists and only the visible
;; window of rows is built (`needs_rebuild` tells main.h# when scrolling left that window); a README shows
;; its first blocks and a "Show more" button; heavy elements are built once and cloned into the tree.

const SIDEBAR_W: f64 = 232.0
const CARD_W: f64 = 380.0
const CARD_H: f64 = 128.0
const GRID_GAP: f64 = 14.0
const PAGE_PAD: f64 = 24.0
const SIDE_COL_W: f64 = 340.0
const LINE_H: f64 = 18.0
const FILE_LINES: int = 3000
const FILE_WIDTH: int = 220
const DOCS_MAX_W: f64 = 880.0
const NOTES_BLOCKS: int = 60
const README_MAX: int = 2000
const MORE_STEP: int = 60
const BUF_LINES: int = 30
const BUF_ROWS: int = 2
const SEARCH_ROWS: int = 120
const FILTER_ROWS: int = 80
const API_NOTE_DOC: int = 360
const EXAMPLE_MAX: int = 60000

;; ── Cached heavy elements ────────────────────────────────────────────────────

fn free_el(h: Element) is
    if h != 0 is Element_free(h) end
end

;; Drops every built README / file / docs / notes element (theme or mode changed).
pub fn reset_readme(s: state::St) is
    free_el(s.rd_el)
    s.rd_el = 0
    s.rd_has = false
end

pub fn reset_file(s: state::St) is
    free_el(s.file_el)
    s.file_el = 0
    s.file_has = false
end

pub fn invalidate(s: state::St) is
    free_el(s.rd_el)
    s.rd_el = 0
    s.rd_has = false
    free_el(s.file_el)
    s.file_el = 0
    s.file_has = false
    free_el(s.docs_el)
    s.docs_el = 0
    s.docs_has = false
    let mut i: int = 0
    while i < array_len(s.rel_els) is
        free_el(s.rel_els[i])
        i += 1
    end
    s.rel_els = []
    s.rel_els_tag = []
end

fn ensure_readme(s: state::St) is
    if s.rd_res.state != state::ready() || s.rd_has is return end
    free_el(s.rd_el)
    s.rd_el = 0
    s.rd_links = []
    if s.rd_text == "" is
        s.rd_has = true
        return
    end
    if s.rd_raw || !s.rd_md is
        s.rd_el = ui::raw_text(s.rd_text, 600)
        s.rd_blocks = 0
    else is
        let blocks: [markdown::Block] = markdown::parse(s.rd_text, s.rd_limit + 1)
        s.rd_blocks = array_len(blocks)
        let mut shown: [markdown::Block] = []
        let mut i: int = 0
        while i < array_len(blocks) && i < s.rd_limit is
            shown = array_push(shown, blocks[i])
            i += 1
        end
        s.rd_el = ui::md_view(shown, s.dark, README_MAX)
        s.rd_links = markdown::all_links(shown)
    end
    s.rd_has = true
end

;; A file: tokenized once (source view) or rendered (Markdown preview).
fn ensure_file(s: state::St) is
    if s.file_res.state != state::ready() || s.file_has || s.file_text == "" is return end
    free_el(s.file_el)
    s.file_el = 0
    s.file_lines = array_len(util::lines_of(s.file_text))
    if s.file_md is
        let col: Element = ui::md_view(markdown::parse(s.file_text, README_MAX), s.dark, README_MAX)
        ui::set_w_fill(col)
        ui::set_pad(col, 6.0)
        let sc: Element = scrollable(col)
        Element_free(col)
        Element_set_id(sc, "file_md")
        ui::set_w_fill(sc)
        ui::set_h_fill(sc)
        s.file_el = sc
        s.fv_tokens = []
    else is
        s.fv_tokens = highlight::highlight(s.file_text, util::ext_of(s.file_path), FILE_LINES, FILE_WIDTH)
        s.fv_first = 0
        s.fv_last = 0
    end
    s.file_has = true
end

fn ensure_docs(s: state::St) is
    if s.docs_has is return end
    let mut src: string = store::read_data("docs.md")
    if src == "" is
        src = "# bit docs\n\nThe docs file was not found next to the app. See https://github.com/HackerOS-Linux-System/bit for the documentation."
    end
    s.docs_el = ui::md_view(markdown::parse(src, README_MAX), s.dark, README_MAX)
    s.docs_has = true
end

;; Release notes of one tag, built on first use.
fn notes_for(s: state::St, r: model::Release) -> Element is
    let mut i: int = 0
    while i < array_len(s.rel_els_tag) is
        if s.rel_els_tag[i] == r.tag is return s.rel_els[i] end
        i += 1
    end
    let el: Element = ui::md_view(markdown::parse(r.body, NOTES_BLOCKS), s.dark, NOTES_BLOCKS)
    s.rel_els = array_push(s.rel_els, el)
    s.rel_els_tag = array_push(s.rel_els_tag, util::own(r.tag))
    return el
end

;; ── Virtual windows ──────────────────────────────────────────────────────────

;; [first, last (exclusive), columns] of what is visible in a virtual list / grid (App_vrange).
fn vis(app: App, id: string, n: int, item_w: f64, item_h: f64, gap: f64, cols: int) -> [int] is
    let vr: List_Int = App_vrange(app, App_get_main(app), id, n, item_w, item_h, gap, cols)
    let a: int = List_Int_get(vr, 0)
    let b: int = List_Int_get(vr, 1)
    let c: int = List_Int_get(vr, 2)
    List_Int_free(vr)
    return [a, b, c]
end

fn lib_count(s: state::St) -> int is
    return array_len(model::filter(s.idx, s.query, s.lang, s.tag))
end

;; True when scrolling has moved the visible rows out of the window that was built - main.h# then rebuilds.
pub fn needs_rebuild(app: App, s: state::St) -> bool is
    if s.screen == "libs" is
        let n: int = lib_count(s)
        if n == 0 is return false end
        let v: [int] = vis(app, "libs_grid", n, CARD_W, CARD_H, GRID_GAP, 0)
        return v[0] < s.gv_first || v[1] > s.gv_last
    end
    if s.screen == "lib" && s.tab == 2 && s.file_has && !s.file_md && s.file_res.state == state::ready() is
        let n: int = array_len(s.fv_tokens)
        if n == 0 is return false end
        let v: [int] = vis(app, "file_view", n, 0.0, LINE_H, 0.0, 1)
        return v[0] < s.fv_first || v[1] > s.fv_last
    end
    return false
end

;; True while the main loop should wake up often (virtual lists being scrolled, the API being read).
pub fn wants_fast_tick(s: state::St) -> bool is
    if s.screen == "libs" is return true end
    if s.screen == "lib" is
        if s.tab == 2 && s.file_has is return true end
        if s.api_state == 1 is return true end
    end
    return false
end

;; The scroll id the keyboard should move on the current screen.
pub fn scroll_target(s: state::St) -> string is
    if s.screen == "libs" is return "libs_grid" end
    if s.screen == "docs" is return "docs" end
    if s.screen == "settings" is return "settings" end
    if s.screen == "lib" is
        if s.tab == 0 is return "ov" end
        if s.tab == 1 is return "api" end
        if s.tab == 2 is
            if s.file_path != "" && s.file_res.state == state::ready() is
                if s.file_md is return "file_md" end
                return "file_view"
            end
            return "src_list"
        end
        return "versions"
    end
    return ""
end

