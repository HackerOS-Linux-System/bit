fn examples_panel(s: state::St) -> Element is
    let k: List_Element = List_Element_new()
    let mut shown: int = 0
    let mut i: int = 0
    while i < array_len(s.tree.items) && shown < 8 is
        let it: model::Item = s.tree.items[i]
        i += 1
        if it.is_dir || !string_starts_with(it.path, "examples/") || it.size > EXAMPLE_MAX is continue end
        let b: Element = ui::btn(it.path, "ex:" + it.path, "row", "file")
        Style_set_ax(Element_get_st(b), 0)
        ui::set_w_fill(b)
        ui::add(k, b)
        shown += 1
