;; ── bit.io Desktop ───────────────────────────────────────────────────────────
;; The desktop edition of the bit.io app (the phone editions live in app/phones). Written in H#; the
;; interface is the `gui` library (HackerScript) used through hlib: `use "hlib -> gui"` brings its API in
;; as plain functions (`app_new`, `App_frame1`, `Element_...`), with no module prefix.
;;
;; The loop is the one the hlib API describes: build the tree, hand it to App_frame1 (which draws when
;; needed, waits for events and returns the messages), react to the messages, and build a new tree only
;; when something changed.

const VERSION: string = "0.1.0"
const WIN_W: int = 1180
const WIN_H: int = 780
const TICK_SLOW: int = 500
const TICK_FAST: int = 80
const API_BATCH: int = 6
const PAGE_STEP: f64 = 520.0
const LINE_STEP: f64 = 60.0
const FAR: f64 = 1000000.0
const ROW_PX: f64 = 18.0
const GOTO_CONTEXT: int = 3

;; ── Theme ────────────────────────────────────────────────────────────────────

;; Light or dark desktop? GNOME/GTK first, then KDE; dark when nothing says otherwise.
fn system_dark() -> bool is
    let g: string = util::capture("gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null")
    if g != "" is return string_contains(g, "dark") end
    let gtk: string = string_lower(env_get("GTK_THEME"))
    if gtk != "" is return string_contains(gtk, "dark") end
    let kde: string = util::capture("kreadconfig6 --group General --key ColorScheme 2>/dev/null || kreadconfig5 --group General --key ColorScheme 2>/dev/null")
    if kde != "" is return string_contains(string_lower(kde), "dark") end
    return true
end

fn apply_theme(app: App, s: state::St) is
    let name: string = s.settings.theme
    let mut dark: bool = true
    let mut t: Theme = theme_dark()
    if name == "system" is
        dark = system_dark()
        if !dark is
            Theme_free(t)
            t = theme_light()
        end
    else if name == "light" is
        dark = false
        Theme_free(t)
        t = theme_light()
    else if name != "dark" is
        Theme_free(t)
        t = theme_by_name(name)
    end
    App_set_theme(app, t)
    Theme_free(t)
    s.dark = dark
    screens::invalidate(s)
end

;; ── Desktop helpers ──────────────────────────────────────────────────────────

fn open_url(s: state::St, url: string) is
    let u: string = model::safe_url(url)
    if u == "" is
        state::say(s, "Only http(s) links are opened.")
        return
    end
    util::run("xdg-open " + util::sq(u) + " &")
    state::say(s, "Opened " + util::cut(u, 70))
end

;; Copies through whichever clipboard tool the session has (Wayland, then X11).
fn copy_text(s: state::St, value: string, what: string) is
    let q: string = util::sq(value)
    let cmd: string = "(command -v wl-copy >/dev/null 2>&1 && printf '%s' " + q + " | wl-copy) || (command -v xclip >/dev/null 2>&1 && printf '%s' " + q + " | xclip -selection clipboard) || (command -v xsel >/dev/null 2>&1 && printf '%s' " + q + " | xsel -b)"
    if util::run(cmd) == 0 is
        state::say(s, "Copied " + what + ".")
    else is
        state::say(s, "No clipboard tool found - install wl-clipboard (Wayland) or xclip (X11).")
    end
end

fn reset_scroll(app: App) is
    let win: int = App_get_main(app)
    App_scroll_set(app, win, "ov", 0.0)
    App_scroll_set(app, win, "api", 0.0)
    App_scroll_set(app, win, "src_list", 0.0)
    App_scroll_set(app, win, "versions", 0.0)
    App_scroll_set(app, win, "file_view", 0.0)
    App_scroll_set(app, win, "file_md", 0.0)
end

;; PageUp / PageDown / arrows / Home / End move the scroll area of the current screen.
fn scroll_key(app: App, s: state::St, name: string) -> bool is
    let id: string = screens::scroll_target(s)
    if id == "" is return false end
    let win: int = App_get_main(app)
    let cur: f64 = App_scroll_offset(app, win, id)
    let mut next: f64 = cur
    if name == "PageDown" is
        next = cur + PAGE_STEP
    else if name == "PageUp" is
        next = cur - PAGE_STEP
    else if name == "ArrowDown" is
        next = cur + LINE_STEP
    else if name == "ArrowUp" is
        next = cur - LINE_STEP
    else if name == "Home" is
        next = 0.0
    else if name == "End" is
        next = cur + FAR
    else is
        return false
    end
    if next < 0.0 is next = 0.0 end
    App_scroll_set(app, win, id, next)
    return true
end

fn go_back(s: state::St) is
    if s.screen == "lib" is
        s.screen = "libs"
    else if s.screen != "libs" is
        s.screen = "libs"
    end
end

fn focus_search(app: App, s: state::St) is
    s.screen = "libs"
    App_focus_id(app, App_get_main(app), "search")
end

fn open_lib(app: App, s: state::St, name: string) is
    load::open_library(app, s, name)
    reset_scroll(app)
end

;; ── Messages ─────────────────────────────────────────────────────────────────

;; Window-level keys. `name` is the key, `typed` the text it produced, `mods` a bit set (1 shift, 2 ctrl).
fn on_key(app: App, s: state::St, name: string, typed: string, mods: int) -> bool is
    let ctrl: bool = (mods / 2) % 2 == 1
    if name == "Escape" is
        go_back(s)
        return true
    end
    if name == "F5" || (ctrl && string_lower(name) == "r") is
        if s.screen == "lib" is load::refresh_library(app, s) else is load::load_index(app, s) end
        state::say(s, "Refreshing…")
        return true
    end
    if typed == "/" || name == "Slash" || (ctrl && string_lower(name) == "k") || (ctrl && string_lower(name) == "f") is
        focus_search(app, s)
        return true
    end
    if ctrl && string_lower(name) == "q" is
        App_quit(app)
        return false
    end
    return scroll_key(app, s, name)
end

fn toggle_in(items: [string], tag: string) -> [string] is
    if util::has(items, tag) is
        let mut keep: [string] = []
        let mut i: int = 0
        while i < array_len(items) is
            if items[i] != tag is keep = array_push(keep, items[i]) end
            i += 1
        end
        return keep
    end
    return array_push(items, util::own(tag))
end

;; Shows a file of the library in the Source tab (from a search hit, the API tab or the examples).
fn show_file(app: App, s: state::St, path: string, line: int, as_source: bool) is
    s.tab = 2
    s.src_filter = ""
    s.dir = util::parent(path)
    load::load_file(app, s, path)
    if as_source is s.file_md = false end
    s.goto_line = line
    load::ensure_tab(app, s)
end

;; "path:123" -> (path, 123)
fn split_at_line(spec: string) -> state::Hit is
    let mut at: int = -1
    let mut i: int = 0
    while i < string_len(spec) is
        if string_at(spec, i) == ":" is at = i end
        i += 1
    end
    if at < 0 is return state::Hit { path: spec, line: 0, text: "" } end
    return state::Hit { path: string_slice(spec, 0, at), line: str_to_int(string_slice(spec, at + 1, string_len(spec))), text: "" }
end

fn toggle_notes(s: state::St, tag: string) is
    if util::has(s.rel_open, tag) is
        let mut keep: [string] = []
        let mut i: int = 0
        while i < array_len(s.rel_open) is
            if s.rel_open[i] != tag is keep = array_push(keep, s.rel_open[i]) end
            i += 1
        end
        s.rel_open = keep
    else is
        s.rel_open = array_push(s.rel_open, util::own(tag))
    end
end

fn save_token(s: state::St, value: string) is
    s.settings.token = string_trim(value)
    store::save_settings(s.settings)
end

;; Reacts to one message; true when the tree has to be rebuilt.
fn update(app: App, s: state::St, id: string, text: string, text2: string, idx: int, flag: bool) -> bool is
    if string_starts_with(id, "net|") is
        load::on_net(app, s, id, text, text2, idx)
        return true
    end
    if id == "key" is return on_key(app, s, text, text2, idx) end
    if id == "focus" is return false end

    if id == "nav:libs" is
        s.screen = "libs"
    else if id == "nav:docs" is
        s.screen = "docs"
    else if id == "nav:settings" is
        s.screen = "settings"
        s.cache_text = store::usage()
    else if id == "back" is
        s.screen = "libs"
    else if id == "refresh" is
        if s.screen == "lib" is load::refresh_library(app, s) else is load::load_index(app, s) end
        state::say(s, "Refreshing…")
    else if id == "search" is
        s.query = text
    else if id == "clear" is
        s.query = ""
        s.lang = ""
        s.tag = ""
    else if string_starts_with(id, "lang:") is
        s.lang = string_slice(id, 5, string_len(id))
    else if string_starts_with(id, "tag:") is
        s.tag = string_slice(id, 4, string_len(id))
    else if string_starts_with(id, "lib:") is
        open_lib(app, s, string_slice(id, 4, string_len(id)))
    else if string_starts_with(id, "dep:") is
        open_lib(app, s, string_slice(id, 4, string_len(id)))
    else if id == "tab" is
        s.tab = idx
        load::ensure_tab(app, s)
    else if id == "rdraw" is
        s.rd_raw = !s.rd_raw
        screens::reset_readme(s)
    else if id == "rdmore" is
        s.rd_limit += 60
        screens::reset_readme(s)
    else if id == "apiq" is
        s.api_q = text
        s.api_shown = state::api_step()
    else if string_starts_with(id, "apik:") is
        s.api_kind = string_slice(id, 5, string_len(id))
        s.api_shown = state::api_step()
    else if id == "apimore" is
        s.api_shown += state::api_step()
    else if id == "srcf" is
        s.src_filter = text
        s.src_mode = 0
    else if id == "srcqin" is
        s.src_query = text
    else if id == "srcsearch" is
        load::code_search(s, s.src_query)
        if s.snap_dir == "" is state::say(s, "Code search needs the downloaded sources - still loading, or offline.") end
    else if id == "srcclear" is
        s.src_mode = 0
        s.src_hits = []
        s.src_query = ""
    else if string_starts_with(id, "hit:") is
        let h: state::Hit = split_at_line(string_slice(id, 4, string_len(id)))
        show_file(app, s, h.path, h.line, true)
    else if string_starts_with(id, "goto:") is
        let h: state::Hit = split_at_line(string_slice(id, 5, string_len(id)))
        show_file(app, s, h.path, h.line, true)
    else if string_starts_with(id, "ex:") is
        show_file(app, s, string_slice(id, 3, string_len(id)), 0, false)
    else if id == "mdtoggle" is
        s.file_md = !s.file_md
        screens::reset_file(s)
    else if id == "verify" is
        load::start_verify(app, s)
    else if id == "tagpick" is
        s.tag = if text == "All tags" then "" else text
    else if string_starts_with(id, "tagto:") is
        s.tag = string_slice(id, 6, string_len(id))
        s.query = ""
        s.lang = ""
        s.screen = "libs"
    else if id == "pickver" is
        let target: string = if text == "(default)" then state::default_ref(s) else text
        load::set_ref(app, s, target)
        reset_scroll(app)
    else if string_starts_with(id, "diff:") is
        let tag: string = string_slice(id, 5, string_len(id))
        s.diff_open = toggle_in(s.diff_open, tag)
        if util::has(s.diff_open, tag) is
            load::request_mf(app, s, tag)
            let prev: string = state::prev_tag(s, tag)
            if prev != "" is load::request_mf(app, s, prev) end
        end
    else if string_starts_with(id, "cp:") is
        copy_text(s, string_slice(id, 3, string_len(id)), "to the clipboard")
    else if id == "copy:install" is
        copy_text(s, "bit install " + s.sel, "the install command")
    else if id == "copy:add" is
        copy_text(s, "bit add " + s.sel, "the add command")
    else if id == "copy:file" is
        copy_text(s, s.file_text, s.file_path)
    else if string_starts_with(id, "open:") is
        open_url(s, string_slice(id, 5, string_len(id)))
    else if string_starts_with(id, "dir:") is
        s.dir = string_slice(id, 4, string_len(id))
        s.src_filter = ""
        s.src_mode = 0
        App_scroll_set(app, App_get_main(app), "src_list", 0.0)
    else if id == "up" is
        s.dir = util::parent(s.dir)
    else if string_starts_with(id, "file:") is
        let fpath: string = string_slice(id, 5, string_len(id))
        s.goto_line = 0
        load::load_file(app, s, fpath)
    else if string_starts_with(id, "ver:") is
        load::set_ref(app, s, string_slice(id, 4, string_len(id)))
        reset_scroll(app)
        state::say(s, if s.ref == "" then "Showing the default version." else "Showing version " + s.ref + ".")
    else if string_starts_with(id, "notes:") is
        toggle_notes(s, string_slice(id, 6, string_len(id)))
    else if id == "theme" is
        s.settings.theme = text
        store::save_settings(s.settings)
        apply_theme(app, s)
    else if id == "token_input" is
        s.token_draft = text
    else if id == "token_show" is
        s.token_shown = flag
    else if id == "token_save" is
        save_token(s, s.token_draft)
        state::say(s, if s.settings.token == "" then "Token removed." else "Token saved.")
    else if id == "token_remove" is
        s.token_draft = ""
        save_token(s, "")
        s.rate_text = ""
        state::say(s, "Token removed.")
    else if id == "token_test" is
        s.settings.token = string_trim(s.token_draft)
        load::check_rate(app, s)
    else if id == "cache_clear" is
        store::clear()
        s.cache_text = store::usage()
        state::say(s, "Saved data cleared.")
    else is
        return false
    end
    return true
end

;; ── Main ─────────────────────────────────────────────────────────────────────

fn main() is
    let s: state::St = state::st_new(VERSION)
    s.settings = store::load_settings()
    s.token_draft = s.settings.token

    let app: App = app_new("bit.io", WIN_W, WIN_H)
    App_set_css(app, ui::css())
    let mut tick: int = TICK_SLOW
    App_set_tick(app, tick)
    apply_theme(app, s)

    load::peek_index(s)
    load::load_index(app, s)
    ;; downloaded sources not touched for three weeks are removed (in the background)
    util::run("find " + util::sq(store::cache_dir() + "/snap") + " -mindepth 1 -maxdepth 1 -mtime +21 -exec rm -rf {} + &")

    let mut root: Element = screens::build(app, s)
    while App_running(app) is
        let ms: List_Message = App_frame1(app, root)
        let n: int = List_Message_len(ms)
        let mut changed: bool = false
        let mut i: int = 0
        while i < n is
            ;; List_Message_get hands out a BORROWED pointer into the list (the facade's `get_mut`), so
            ;; `m` is never freed on its own - List_Message_free(ms) below releases all of them.
            let m: Message = List_Message_get(ms, i)
            let id: string = string_slice(Message_get_id(m), 0, string_len(Message_get_id(m)))
            let text: string = string_slice(Message_get_text(m), 0, string_len(Message_get_text(m)))
            let text2: string = string_slice(Message_get_text2(m), 0, string_len(Message_get_text2(m)))
            let idx: int = Message_get_idx(m)
            let flag: bool = Message_get_flag(m)
            if update(app, s, id, text, text2, idx, flag) is changed = true end
            i += 1
        end
        List_Message_free(ms)
        if s.toast != "" && time_ms() >= s.toast_until is
            s.toast = ""
            changed = true
        end
        ;; the API tab is read a few files at a time so the window stays responsive
        if load::api_step(s, API_BATCH) is changed = true end
        ;; scrolled a virtual list out of the window that was built?
        if screens::needs_rebuild(app, s) is changed = true end
        ;; jump to a line (search hit, API "Source" button) once its file is on screen
        if s.goto_line > 0 && s.file_has && !s.file_md && s.screen == "lib" && s.tab == 2 is
            let rows: f64 = (s.goto_line - GOTO_CONTEXT) + 0.0
            let mut off: f64 = rows * ROW_PX
            if off < 0.0 is off = 0.0 end
            App_scroll_set(app, App_get_main(app), "file_view", off)
            s.goto_line = 0
            changed = true
        end
        let want: int = if screens::wants_fast_tick(s) then TICK_FAST else TICK_SLOW
        if want != tick is
            tick = want
            App_set_tick(app, tick)
        end
        if changed is
            let fresh: Element = screens::build(app, s)
            Element_free(root)
            root = fresh
        end
    end
    Element_free(root)
end
