pub fn st_new(version: string) -> St is
    return St {
        screen: "libs", dark: true, version: version, busy: 0, toast: "", toast_until: 0,
        idx: model::empty_index(), idx_res: res_new(), query: "", lang: "", tag: "",
        sel: "", gen: 0, ref: "", tab: 0,
        mf: hk::empty(), mf_file: "", mf_res: res_new(),
        rd_file: "", rd_res: res_new(), rd_text: "", rd_md: true, rd_limit: README_STEP, rd_blocks: 0, rd_raw: false, rd_el: 0, rd_has: false, rd_links: [],
        meta: model::parse_meta(""), meta_res: res_new(),
        rels: [], rel_res: res_new(), rel_open: [], rel_els: [], rel_els_tag: [],
        tree: model::empty_tree(), tree_res: res_new(), dir: "",
        file_path: "", file_res: res_new(), file_text: "", file_el: 0, file_has: false, file_lines: 0, file_note: "", file_md: false, fv_tokens: [], fv_first: 0, fv_last: 0,
        goto_line: 0, gv_first: 0, gv_last: 0,
        snap_res: res_new(), snap_dir: "", langs: [], langs_done: false,
        api_state: 0, api_items: [], api_files: [], api_pos: 0, api_q: "", api_kind: "", api_shown: API_STEP,
        src_filter: "", src_query: "", src_hits: [], src_mode: 0, src_cut: false,
        pin_res: res_new(), pin_sha: "", pin_date: "", pin_moved: false, ver_state: 0, ver_msg: "",
        used_res: res_new(), used: [],
        mfs_refs: [], mfs_text: [], diff_open: [], diff_tags: [], diff_data: [],
        docs_el: 0, docs_has: false,
        settings: store::default_settings(), token_draft: "", token_shown: false, rate_text: "", cache_text: ""
    }
end

;; Shows a message in the status bar for a few seconds.
pub fn say(s: St, text: string) is
    s.toast = text
    s.toast_until = time_ms() + TOAST_MS
end

const TOAST_MS: int = 4000

;; The library on screen, or an empty one when none is selected / the index changed under us.
pub fn current(s: St) -> model::Lib is
    let i: int = model::find_lib(s.idx, s.sel)
    if i < 0 is
        return model::Lib { name: "", target: "", description: "", tags: [], author: "", lang: "any", rev: "", checksum: "" }
    end
    return s.idx.libs[i]
end

;; Version being viewed: the chosen one, else the library's pinned rev, else the branch of its URL, else HEAD.
pub fn eff_ref(s: St) -> string is
    if s.ref != "" is return s.ref end
    let l: model::Lib = current(s)
    if l.rev != "" is return l.rev end
    let g: model::Gh = model::parse_github(l.target)
    if g.ref != "" is return g.ref end
    return "HEAD"
end

pub fn default_ref(s: St) -> string is
    let l: model::Lib = current(s)
    if l.rev != "" is return l.rev end
    let g: model::Gh = model::parse_github(l.target)
    if g.ref != "" is return g.ref end
    return "HEAD"
end

;; The release before `tag` in the list (older), or "".
pub fn prev_tag(s: St, tag: string) -> string is
    let mut i: int = 0
    while i < array_len(s.rels) is
        if s.rels[i].tag == tag && i + 1 < array_len(s.rels) is return s.rels[i + 1].tag end
        i += 1
    end
    return ""
end

;; The newest release that is not a pre-release (the "Latest" badge).
pub fn latest_tag(s: St) -> string is
    let mut i: int = 0
    while i < array_len(s.rels) is
        if !s.rels[i].prerelease && !s.rels[i].tag_only is return s.rels[i].tag end
        i += 1
    end
    if array_len(s.rels) > 0 is return s.rels[0].tag end
    return ""
end
