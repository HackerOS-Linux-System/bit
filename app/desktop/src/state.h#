;; ── Application state ────────────────────────────────────────────────────────
;; One mutable struct (H# structs are references). main.h# changes it in `update`, view.h# only reads it.
;; Elements that are expensive to build (a README, a source file, release notes) are built once per load
;; and kept here as gui handles; view.h# clones them into the tree, load.h# frees them when replaced.

pub fn idle() -> int is return 0 end
pub fn loading() -> int is return 1 end
pub fn ready() -> int is return 2 end
pub fn failed() -> int is return 3 end

;; Progress of one remote resource.
pub struct Res is
    pub state: int
    pub stale: bool       ;; answered from the saved copy because the network failed
    pub err: string
    pub age: int          ;; seconds since the copy was saved (0 = fresh)
end

const README_STEP: int = 40
const API_STEP: int = 60

pub fn readme_step() -> int is
    return README_STEP
end

pub fn api_step() -> int is
    return API_STEP
end

pub fn res_new() -> Res is
    return Res { state: idle(), stale: false, err: "", age: 0 }
end

;; One line found by the code search.
pub struct Hit is
    pub path: string
    pub line: int
    pub text: string
end

pub struct St is
    pub screen: string            ;; libs | docs | settings | lib
    pub dark: bool
    pub version: string
    pub busy: int                 ;; requests in flight
    pub toast: string
    pub toast_until: int          ;; ms (time_ms) until the toast is shown
    ;; library index
    pub idx: model::Index
    pub idx_res: Res
    pub query: string
    pub lang: string              ;; "" = all
    pub tag: string
    ;; the library on screen
    pub sel: string
    pub gen: int                  ;; bumped when the selection or version changes: answers of older requests are dropped
    pub ref: string               ;; version being viewed, "" = the default
    pub tab: int                  ;; 0 overview, 1 API, 2 source, 3 versions
    pub mf: hk::Hk
    pub mf_file: string
    pub mf_res: Res
    pub rd_file: string
    pub rd_res: Res
    pub rd_text: string
    pub rd_md: bool
    pub rd_limit: int             ;; README blocks shown (the rest: "Show more")
    pub rd_blocks: int
    pub rd_raw: bool              ;; README as plain text
    pub rd_el: Element
    pub rd_has: bool
    pub rd_links: [markdown::Block]
    pub meta: model::Meta
    pub meta_res: Res
    pub rels: [model::Release]
    pub rel_res: Res
    pub rel_open: [string]        ;; tags whose notes are expanded
    pub rel_els: [Element]        ;; built notes, parallel to rel_notes_tag
    pub rel_els_tag: [string]
    pub tree: model::Tree
    pub tree_res: Res
    pub dir: string
    pub file_path: string
    pub file_res: Res
    pub file_text: string
    pub file_el: Element
    pub file_has: bool
    pub file_lines: int
    pub file_note: string
    pub file_md: bool             ;; a Markdown file shown rendered
    pub fv_tokens: [highlight::Line]   ;; the file, tokenized once
    pub fv_first: int             ;; window of rows built into the file view
    pub fv_last: int
    pub goto_line: int            ;; scroll to this line once the file is shown (0 = none)
    pub gv_first: int             ;; window of cards built into the library grid
    pub gv_last: int
    ;; sources downloaded as one archive (API tab, code search, checksum, offline browsing)
    pub snap_res: Res
    pub snap_dir: string          ;; the library's root inside the snapshot, "" = none
    pub langs: [langs::Share]
    pub langs_done: bool
    ;; API tab
    pub api_state: int
    pub api_items: [apidoc::Item]
    pub api_files: [string]
    pub api_pos: int
    pub api_q: string
    pub api_kind: string          ;; "" | fn | struct | enum | const
    pub api_shown: int
    ;; Source tab: file filter and code search
    pub src_filter: string
    pub src_query: string
    pub src_hits: [Hit]
    pub src_mode: int             ;; 0 files, 1 search results
    pub src_cut: bool
    ;; pinned revision and checksum
