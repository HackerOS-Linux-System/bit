;; First paint: the saved copy, else the snapshot shipped with the app.
pub fn peek_index(s: state::St) is
    let c: store::Cached = store::get("index")
    if c.found is
        let idx: model::Index = model::parse_index(c.body)
        if array_len(idx.libs) > 0 is
            s.idx = idx
            s.idx_res.stale = true
            s.idx_res.age = c.age
            return
        end
    end
    let seed: string = store::read_data("repository.json")
    if seed != "" is
        let idx: model::Index = model::parse_index(seed)
        s.idx = idx
        s.idx_res.stale = true
        s.idx_res.age = -1
    end
end

pub fn load_index(app: App, s: state::St) is
    s.idx_res.state = state::loading()
    s.idx_res.err = ""
    spawn(app, s, make_id("index", 0, 0, "index"), INDEX_URL, false, true)
end

