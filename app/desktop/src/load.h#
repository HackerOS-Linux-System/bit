;; ── Loading: index, manifest, README, stats, releases, tree, files ───────────
;; Everything goes through `curl` run by the GUI library's background tasks (App_task_run), so the window
;; never blocks. Answers come back as messages with an id of the form
;;     net|<purpose>|<generation>|<attempt>|<cache key>
;; and are dropped when the generation is no longer current (the user moved on). Every answer that is
;; usable is saved in the disk cache; when the network fails the saved copy is used ("stale").

const HTTP_OK: int = 200
const HTTP_UNAUTHORIZED: int = 401
const HTTP_FORBIDDEN: int = 403
const HTTP_NOT_FOUND: int = 404
const HTTP_TOO_MANY: int = 429
;; (literals of 128 and more in an `if` condition are mis-compiled by some H# 0.9 builds: every threshold
;; and status code in this program is a named constant)
const TTL_MANIFEST: int = 21600
const TTL_README: int = 21600
const TTL_META: int = 3600
const TTL_RELEASES: int = 3600
const TTL_TREE: int = 21600
const TTL_FILE: int = 86400
const TIMEOUT: string = "25"
const MAX_README: int = 200000
const MAX_MANIFEST: int = 100000
const MAX_FILE: int = 300000
const MAX_VIEW_BYTES: int = 2000000
const MAX_API_FILE: int = 300000
const MAX_API_FILES: int = 150
const MAX_HITS: int = 200
const INDEX_URL: string = "https://raw.githubusercontent.com/HackerOS-Linux-System/bit/main/index/repository.json"

fn manifest_names() -> [string] is
    return ["Bit.hk", "bit.hk"]
end

fn readme_names() -> [string] is
    return ["README.md", "Readme.md", "readme.md", "README.markdown", "README.MD", "README", "README.txt", "README.rst"]
end

fn free_el(h: Element) is
    if h != 0 is Element_free(h) end
end

;; ── Requests ─────────────────────────────────────────────────────────────────

fn api_headers(a: List_Str, token: string) is
    List_Str_push(a, "-H")
    List_Str_push(a, "Accept: application/vnd.github+json")
    List_Str_push(a, "-H")
    List_Str_push(a, "X-GitHub-Api-Version: 2022-11-28")
    if token != "" is
        List_Str_push(a, "-H")
        List_Str_push(a, "Authorization: Bearer " + token)
    end
end

;; Starts `curl url` as a background task. The HTTP status is appended to the output after a newline.
fn spawn(app: App, s: state::St, id: string, url: string, api: bool, fresh: bool) is
    let a: List_Str = List_Str_new()
    List_Str_push(a, "-sS")
    List_Str_push(a, "-L")
    List_Str_push(a, "--max-time")
    List_Str_push(a, TIMEOUT)
    List_Str_push(a, "-A")
    List_Str_push(a, "bit-io-desktop/" + s.version)
    List_Str_push(a, "-w")
    List_Str_push(a, "\n%" + "\{" + "http_code" + "}")
    if fresh is
        List_Str_push(a, "-H")
        List_Str_push(a, "Cache-Control: no-cache")
    end
    if api is api_headers(a, s.settings.token) end
    List_Str_push(a, url)
    App_task_run(app, id, "curl", a)
    List_Str_free(a)
    s.busy += 1
end

fn make_id(purpose: string, gen: int, n: int, key: string) -> string is
    return "net|" + purpose + "|" + to_string(gen) + "|" + to_string(n) + "|" + string_replace(key, "|", "_")
end

;; Cache first (while fresh), otherwise the network. `fresh_ok` = ttl > 0 means a young saved copy is used.
;; Returns the saved body when it was used directly (the caller then handles it as a 200), or "" + false.
pub struct Hit is
    pub used: bool
    pub body: string
    pub age: int
end

fn lookup(key: string, ttl: int) -> Hit is
    if ttl <= 0 is return Hit { used: false, body: "", age: 0 } end
    let c: store::Cached = store::get(key)
    if c.found && c.age < ttl is return Hit { used: true, body: c.body, age: c.age } end
    return Hit { used: false, body: "", age: 0 }
end

fn raw_url(g: model::Gh, ref: string, path: string) -> string is
    return "https://raw.githubusercontent.com/" + g.owner + "/" + g.repo + "/" + util::url_enc_path(ref) + "/" + util::url_enc_path(model::repo_path(g, path))
end

fn api_url(g: model::Gh, rest: string) -> string is
    return "https://api.github.com/repos/" + util::url_enc(g.owner) + "/" + util::url_enc(g.repo) + rest
end

