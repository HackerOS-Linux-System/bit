;; ── Answers ──────────────────────────────────────────────────────────────────

fn github_error(s: state::St, code: int, body: string) -> string is
    if code == HTTP_UNAUTHORIZED is return "GitHub rejected the saved token (401). Check it in Settings." end
    if (code == HTTP_FORBIDDEN || code == HTTP_TOO_MANY) && (string_contains(string_lower(body), "rate limit")) is
        if s.settings.token == "" is return "GitHub's anonymous limit (60 requests/hour) is used up. Add a token in Settings." end
        return "GitHub's hourly limit is used up. Try again later."
    end
    if code == HTTP_NOT_FOUND is return "Not found on GitHub." end
    if code == 0 is return "No network connection." end
    return "GitHub: HTTP " + to_string(code)
end

;; Completes a resource: 200 -> `body`; anything else -> the saved copy if there is one, else an error.
;; Returns "" and sets `err` when there is nothing to show.
struct Outcome is
    ok: bool
    body: string
    stale: bool
    age: int
    err: string
    code: int
end

fn settle(s: state::St, key: string, code: int, body: string, net_err: string) -> Outcome is
    if code == HTTP_OK is
        store::put(key, body)
        return Outcome { ok: true, body: body, stale: false, age: 0, err: "", code: code }
    end
    if code == HTTP_NOT_FOUND is
        return Outcome { ok: false, body: "", stale: false, age: 0, err: github_error(s, code, body), code: code }
    end
    let c: store::Cached = store::get(key)
    if c.found is
        return Outcome { ok: true, body: c.body, stale: true, age: c.age, err: "", code: code }
    end
    let why: string = if net_err != "" && code == 0 then "No network connection." else github_error(s, code, body)
    return Outcome { ok: false, body: "", stale: false, age: 0, err: why, code: code }
end

fn got_manifest(app: App, s: state::St, n: int, code: int, body: string, stale: bool, age: int) is
    if code == HTTP_OK is
        s.mf = hk::parse(util::cut_plain(body, MAX_MANIFEST))
        s.mf_file = manifest_names()[n]
        s.mf_res.state = state::ready()
        s.mf_res.stale = stale
        s.mf_res.age = age
        return
    end
    if code == HTTP_NOT_FOUND && n + 1 < array_len(manifest_names()) is
        load_manifest(app, s, n + 1)
        return
    end
    if code == HTTP_NOT_FOUND is
        s.mf = hk::empty()
        s.mf_file = ""
        s.mf_res.state = state::ready()
        s.mf_res.err = "This repository has no Bit.hk."
        return
    end
end

fn got_readme(app: App, s: state::St, n: int, code: int, body: string, stale: bool, age: int) is
    if code == HTTP_OK is
        let file: string = readme_names()[n]
        s.rd_file = file
        s.rd_text = util::cut_plain(body, MAX_README)
        let low: string = string_lower(file)
        s.rd_md = string_ends_with(low, ".md") || string_ends_with(low, ".markdown")
        s.rd_res.state = state::ready()
        s.rd_res.stale = stale
        s.rd_res.age = age
        s.rd_has = false
        return
    end
    if code == HTTP_NOT_FOUND && n + 1 < array_len(readme_names()) is
        load_readme(app, s, n + 1)
        return
    end
    if code == HTTP_NOT_FOUND is
        s.rd_text = ""
        s.rd_res.state = state::ready()
        s.rd_res.err = "This repository has no README."
    end
end

fn got_meta(s: state::St, code: int, body: string, stale: bool, age: int) is
    s.meta = model::parse_meta(body)
    s.meta_res.state = state::ready()
    s.meta_res.stale = stale
    s.meta_res.age = age
end

fn got_releases(app: App, s: state::St, code: int, body: string, stale: bool, age: int) is
    let g: model::Gh = model::parse_github(state::current(s).target)
    let rels: [model::Release] = model::parse_releases(body, g)
    s.rel_res.stale = stale
    s.rel_res.age = age
    if array_len(rels) == 0 && !stale is
        load_tags(app, s)
        return
    end
    s.rels = rels
    s.rel_res.state = state::ready()
end

