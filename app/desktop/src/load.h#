fn got_file(s: state::St, path: string, code: int, body: string, stale: bool, age: int) is
    if path != s.file_path is return end
    s.file_text = util::cut_plain(body, MAX_FILE)
    s.file_note = if string_len(body) > MAX_FILE then "Large file: only the first 300 KB are shown." else ""
    s.file_res.state = state::ready()
    s.file_res.stale = stale
    s.file_res.age = age
    s.file_has = false
end

fn rate_from(body: string) -> string is
    let at: int = string_find(body, "\"core\"")
    if at < 0 is return "unknown" end
    let part: string = string_slice(body, at, string_len(body))
    let l: int = string_find(part, "\"limit\":")
    let r: int = string_find(part, "\"remaining\":")
    if l < 0 || r < 0 is return "unknown" end
    let lim: int = str_to_int(string_trim(num_after(part, l + 8)))
    let rem: int = str_to_int(string_trim(num_after(part, r + 12)))
    return to_string(rem) + " of " + to_string(lim) + " requests left this hour"
end

fn num_after(s: string, from: int) -> string is
    let mut e: int = from
    while e < string_len(s) && (util::is_digit(string_at(s, e)) || string_at(s, e) == " ") is e += 1 end
    return string_slice(s, from, e)
end

;; Handles the answer of a "net|..." task. `out` = curl's stdout (body + "\n" + status), `net_err` = its stderr,
;; `exit_code` = curl's exit code.
pub fn on_net(app: App, s: state::St, id: string, out: string, net_err: string, exit_code: int) is
    if s.busy > 0 is s.busy -= 1 end
    let parts: [string] = string_split(id, "|")
    if array_len(parts) < 5 is return end
    let purpose: string = parts[1]
    let gen: int = str_to_int(parts[2])
    let n: int = str_to_int(parts[3])
    let mut key: string = parts[4]
    let mut k: int = 5
    while k < array_len(parts) is
        key = key + "|" + parts[k]
        k += 1
    end

    ;; split the status off the body
    let len: int = string_len(out)
    let mut code: int = 0
    let mut body: string = ""
    if exit_code == 0 && len >= 4 && string_at(out, len - 4) == "\n" is
        code = str_to_int(string_slice(out, len - 3, len))
        body = string_slice(out, 0, len - 4)
    else is
        body = string_slice(out, 0, len)
    end

    if purpose == "index" is
        if code == HTTP_OK is
            let idx: model::Index = model::parse_index(body)
            if array_len(idx.libs) > 0 is
                store::put("index", body)
                s.idx = idx
                s.idx_res.state = state::ready()
                s.idx_res.stale = false
                s.idx_res.age = 0
                s.idx_res.err = ""
                return
            end
        end
        s.idx_res.state = state::ready()
        s.idx_res.stale = true
        if array_len(s.idx.libs) == 0 is
            s.idx_res.state = state::failed()
            s.idx_res.err = if exit_code != 0 then "No network connection - and no saved copy of the index." else "Could not read the library index (HTTP " + to_string(code) + ")."
        end
        return
    end
    if purpose == "rate" is
        s.rate_text = if code == HTTP_OK then rate_from(body) else github_error(s, code, body)
        return
    end

    if gen != s.gen is return end
    let o: Outcome = settle(s, key, code, body, net_err)
    if purpose == "manifest" is
        if o.ok is
            got_manifest(app, s, n, 200, o.body, o.stale, o.age)
        else if o.code == HTTP_NOT_FOUND is
            got_manifest(app, s, n, 404, "", false, 0)
        else is
            s.mf_res.state = state::failed()
            s.mf_res.err = o.err
        end
    else if purpose == "readme" is
        if o.ok is
            got_readme(app, s, n, 200, o.body, o.stale, o.age)
        else if o.code == HTTP_NOT_FOUND is
            got_readme(app, s, n, 404, "", false, 0)
        else is
            s.rd_res.state = state::failed()
            s.rd_res.err = o.err
        end
    else if purpose == "meta" is
        if o.ok is
            got_meta(s, 200, o.body, o.stale, o.age)
        else is
            s.meta_res.state = state::failed()
            s.meta_res.err = o.err
        end
    else if purpose == "rels" is
        if o.ok is
            got_releases(app, s, 200, o.body, o.stale, o.age)
        else is
            s.rel_res.state = state::failed()
            s.rel_res.err = o.err
        end
    else if purpose == "tags" is
        if o.ok is
            got_tags(s, 200, o.body, o.stale, o.age)
        else is
            s.rel_res.state = state::ready()
            s.rels = []
        end
    else if purpose == "tree" is
        if o.ok is
            got_tree(s, 200, o.body, o.stale, o.age)
        else is
            s.tree_res.state = state::failed()
            s.tree_res.err = o.err
        end
    else if purpose == "file" is
        if key != file_key(s, s.file_path) is return end
        if o.ok is
            got_file(s, s.file_path, 200, o.body, o.stale, o.age)
        else is
            s.file_res.state = state::failed()
            s.file_res.err = o.err
        end
    end
end
