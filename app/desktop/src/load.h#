fn drop_notes(s: state::St) is
    let mut i: int = 0
    while i < array_len(s.rel_els) is
        free_el(s.rel_els[i])
        i += 1
    end
    s.rel_els = []
    s.rel_els_tag = []
end

fn reset_resources(s: state::St, keep_rels: bool) is
    s.mf = hk::empty()
    s.mf_file = ""
    s.mf_res = state::res_new()
    s.rd_text = ""
    s.rd_file = ""
    s.rd_res = state::res_new()
    free_el(s.rd_el)
    s.rd_el = 0
    s.rd_has = false
    s.rd_links = []
    s.meta_res = state::res_new()
    if !keep_rels is
        s.rels = []
        s.rel_res = state::res_new()
    end
    s.rel_open = []
    drop_notes(s)
    s.tree = model::empty_tree()
    s.tree_res = state::res_new()
    s.dir = ""
    s.file_path = ""
    s.file_res = state::res_new()
    s.file_text = ""
    free_el(s.file_el)
    s.file_el = 0
    s.file_has = false
    s.file_lines = 0
    s.file_note = ""
end

fn fail_all(s: state::St, why: string) is
    s.mf_res.state = state::failed()
    s.mf_res.err = why
    s.rd_res.state = state::failed()
    s.rd_res.err = why
    s.meta_res.state = state::failed()
    s.meta_res.err = why
end

pub fn load_manifest(app: App, s: state::St, n: int) is
    let g: model::Gh = model::parse_github(state::current(s).target)
    if !g.ok is
        s.mf_res.state = state::failed()
        s.mf_res.err = "This library's source is not on GitHub."
        return
    end
    let names: [string] = manifest_names()
    let ref: string = state::eff_ref(s)
    let key: string = "manifest:" + model::slug(g) + "@" + ref + ":" + names[n]
    s.mf_res.state = state::loading()
    let hit: Hit = lookup(key, TTL_MANIFEST)
    if hit.used is
        got_manifest(app, s, n, 200, hit.body, false, hit.age)
        return
    end
    spawn(app, s, make_id("manifest", s.gen, n, key), raw_url(g, ref, names[n]), false, false)
end

