;; Opens a library: new generation, everything cleared, the three things the overview needs are requested.
pub fn open_library(app: App, s: state::St, name: string) is
    s.sel = name
    s.gen += 1
    s.ref = ""
    s.tab = 0
    s.screen = "lib"
    reset_resources(s, false)
    load_manifest(app, s, 0)
    load_readme(app, s, 0)
    load_meta(app, s)
end

;; Switches to another version (tag/branch) of the same library.
pub fn set_ref(app: App, s: state::St, ref: string) is
    s.ref = if ref == state::default_ref(s) then "" else ref
    s.gen += 1
    reset_resources(s, true)
    load_manifest(app, s, 0)
    load_readme(app, s, 0)
    load_meta(app, s)
    s.tab = 0
end

;; Loads what a tab needs the first time it is shown.
pub fn ensure_tab(app: App, s: state::St) is
    if s.tab == 1 && s.tree_res.state == state::idle() is load_tree(app, s) end
    if s.tab == 2 && s.rel_res.state == state::idle() is load_releases(app, s) end
end

pub fn refresh_library(app: App, s: state::St) is
    let name: string = s.sel
    let ref: string = util::own(s.ref)
    let tab: int = s.tab
    let g: model::Gh = model::parse_github(state::current(s).target)
    if g.ok is
        let slug: string = model::slug(g)
        let r: string = state::eff_ref(s)
        store::forget("manifest:" + slug + "@" + r + ":Bit.hk")
        store::forget("manifest:" + slug + "@" + r + ":bit.hk")
        let names: [string] = readme_names()
        let mut i: int = 0
        while i < array_len(names) is
            store::forget("readme:" + slug + "@" + r + ":" + names[i])
            i += 1
        end
        store::forget("meta:" + g.owner + "/" + g.repo)
        store::forget("rels:" + g.owner + "/" + g.repo)
        store::forget("tags:" + g.owner + "/" + g.repo)
        store::forget("tree:" + slug + "@" + r)
    end
    open_library(app, s, name)
    s.ref = ref
    s.tab = tab
    ensure_tab(app, s)
end

