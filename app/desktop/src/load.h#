pub fn load_file(app: App, s: state::St, path: string) is
    let g: model::Gh = model::parse_github(state::current(s).target)
    free_el(s.file_el)
    s.file_el = 0
    s.file_has = false
    s.file_path = path
    s.file_text = ""
    s.file_note = ""
    let fext: string = util::ext_of(path)
    s.file_md = fext == "md" || fext == "markdown"
    s.fv_tokens = []
    s.file_res = state::res_new()
    if !g.ok is
        s.file_res.state = state::failed()
        s.file_res.err = "This library's source is not on GitHub."
        return
    end
    if s.snap_dir != "" is
        let p: string = s.snap_dir + "/" + path
        let size: int = item_size(s, path)
        if is_binary(path) is
            s.file_text = ""
            s.file_note = "Binary file (" + util::bytes_str(size) + ") - open it on GitHub."
            s.file_res.state = state::ready()
            s.file_has = false
            return
        end
        if size > MAX_VIEW_BYTES is
            s.file_text = ""
            s.file_note = "File too large to show (" + util::bytes_str(size) + ") - open it on GitHub."
            s.file_res.state = state::ready()
            s.file_has = false
            return
        end
        if file_exists(p) is
            got_file(s, path, HTTP_OK, file_read(p), false, 0)
            return
        end
    end
    let key: string = file_key(s, path)
    s.file_res.state = state::loading()
    let hit: Hit = lookup(key, TTL_FILE)
    if hit.used is
        got_file(s, path, 200, hit.body, false, hit.age)
        return
    end
    spawn(app, s, make_id("file", s.gen, 0, key), raw_url(g, state::eff_ref(s), path), false, false)
end

;; Opens a library: new generation, everything cleared, the three things the overview needs are requested.
pub fn open_library(app: App, s: state::St, name: string) is
    s.sel = name
    s.gen += 1
    s.ref = ""
    s.tab = 0
    s.screen = "lib"
    reset_resources(s, false)
    load_manifest(app, s, 0)
    load_readme(app, s, 0)
    load_meta(app, s)
    ensure_snapshot(app, s)
    load_pin(app, s)
    load_used(app, s)
end

;; Switches to another version (tag/branch) of the same library.
pub fn set_ref(app: App, s: state::St, ref: string) is
    s.ref = if ref == state::default_ref(s) then "" else ref
    s.gen += 1
    reset_resources(s, true)
    load_manifest(app, s, 0)
    load_readme(app, s, 0)
    load_meta(app, s)
    ensure_snapshot(app, s)
    s.tab = 0
end

;; Loads what a tab needs the first time it is shown.
pub fn ensure_tab(app: App, s: state::St) is
    if s.tab == 1 && s.api_state == 0 is api_start(s) end
    if s.tab == 2 && s.snap_res.state == state::failed() && s.tree_res.state == state::idle() is load_tree(app, s) end
    if s.tab == 3 && s.rel_res.state == state::idle() is load_releases(app, s) end
end

pub fn refresh_library(app: App, s: state::St) is
    let name: string = s.sel
    let ref: string = util::own(s.ref)
    let tab: int = s.tab
    let g: model::Gh = model::parse_github(state::current(s).target)
    if g.ok is
        let slug: string = model::slug(g)
        let r: string = state::eff_ref(s)
        store::forget("manifest:" + slug + "@" + r + ":Bit.hk")
        store::forget("manifest:" + slug + "@" + r + ":bit.hk")
        let names: [string] = readme_names()
        let mut i: int = 0
        while i < array_len(names) is
            store::forget("readme:" + slug + "@" + r + ":" + names[i])
            i += 1
        end
        store::forget("meta:" + g.owner + "/" + g.repo)
        store::forget("rels:" + g.owner + "/" + g.repo)
        store::forget("tags:" + g.owner + "/" + g.repo)
        store::forget("tree:" + slug + "@" + r)
        util::run("rm -rf " + util::sq(store::snap_dir(snap_key(g, r))))
    end
    open_library(app, s, name)
    s.ref = ref
    s.tab = tab
    ensure_tab(app, s)
end

