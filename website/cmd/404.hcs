use <mode:website>
!! Strona 404 (GitHub Pages serwuje ja pod dowolnym adresem, wiec build.sh wkleja jej JS inline).
!! Bez wlasnego bloku `style { }`: kompilator zbiera bloki style ze WSZYSTKICH plikow .hcs w katalogu,
!! wiec styl tej strony przeciekalby do pozostalych. Uzywamy klas ze styles.hcs.
include <jsutil>
include <platform>
include <dom>
include <theme>
include <styles>

fun main() [
    document.documentElement.setAttribute("lang", "en")
    document.title = "Not found — bit.io"
    dom_add(app_root(), ha("main", ["class", "wrap page", "style", "text-align:center;padding-top:14vh"], [
        h("h1", "", [h("span", "grad", ["404"])]),
        h("p", "lead", ["This page is not in the index."]),
        link("./", "btn primary", ["Back to bit.io"])
    ]))
    init_theme()
]
